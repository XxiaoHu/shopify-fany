{% doc %}
  @prompt
    Build this section for FANY.us based on the reference image.
    
    Create a premium FANY-style editorial carousel:
    - Left: heading + description + CTA.
    - Right: horizontal cards with image, category, title and description.
    - Desktop: 2 full cards + part of the 3rd card and 4th card visible.
    - Mobile: text on top + horizontally swipeable cards, showing about 1.1 cards.
    - Tablet: 1.5–2 cards visible.
    - Never turn the cards into a vertical list on mobile.
    - Fully responsive at 1440px, 1024px, 768px and 390px.
    - No horizontal page overflow.
    
    Style: feminine, elegant, premium, modern, wellness + fashion technology.
    Use FANY’s existing fonts, colors, spacing and design system.
    Do not copy Withings branding, text or images., 图片需要固定高度和宽度
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}
{% style %}.ai-fixed-carousel-{{ ai_gen_id }}{display:block;width:100%;overflow:hidden;background:{{ block.settings.background_color }};color:{{ block.settings.text_color }};}.ai-fixed-carousel-{{ ai_gen_id }}__inner{width:{{ block.settings.desktop_width_percent }}%;max-width:1440px;margin:auto;padding:{{ block.settings.section_padding }}px 0;display:grid;grid-template-columns:minmax(220px,.72fr) minmax(0,1.8fr);gap:clamp(32px,6vw,96px);align-items:center}.ai-fixed-carousel-{{ ai_gen_id }}__heading{margin:0 0 18px;font-family:{{ block.settings.heading_font.family }},sans-serif;font-size:clamp(32px,4vw,58px);line-height:1.04}.ai-fixed-carousel-{{ ai_gen_id }}__eyebrow{color:{{ block.settings.accent_color }};font-size:11px;letter-spacing:.16em;text-transform:uppercase}.ai-fixed-carousel-{{ ai_gen_id }}__description{max-width:390px;margin:0 0 28px;font-size:16px;line-height:1.65}.ai-fixed-carousel-{{ ai_gen_id }}__cta{display:inline-flex;padding:14px 20px;background:{{ block.settings.button_color }};color:{{ block.settings.button_text_color }};text-decoration:none;border-radius:{{ block.settings.button_radius }}px}.ai-fixed-carousel-{{ ai_gen_id }}__track{display:flex;gap:18px;overflow-x:auto;scroll-snap-type:x mandatory;scrollbar-width:none}.ai-fixed-carousel-{{ ai_gen_id }}__track::-webkit-scrollbar{display:none}.ai-fixed-carousel-{{ ai_gen_id }}__card{flex:0 0 calc((100% - 18px)/2.15);scroll-snap-align:start}.ai-fixed-carousel-{{ ai_gen_id }}__image,.ai-fixed-carousel-{{ ai_gen_id }}__placeholder{display:block;width:{{ block.settings.image_width }}px;height:{{ block.settings.image_height }}px;max-width:100%;object-fit:cover;background:#f0eae8;border-radius:{{ block.settings.card_radius }}px}.ai-fixed-carousel-{{ ai_gen_id }}__placeholder svg{width:100%;height:100%}.ai-fixed-carousel-{{ ai_gen_id }}__copy{padding-top:14px}.ai-fixed-carousel-{{ ai_gen_id }}__category{color:{{ block.settings.accent_color }};font-size:10px;letter-spacing:.14em;text-transform:uppercase}.ai-fixed-carousel-{{ ai_gen_id }}__title{font-size:20px;margin:8px 0}.ai-fixed-carousel-{{ ai_gen_id }}__text{font-size:14px;line-height:1.5;opacity:.78}.ai-fixed-carousel-{{ ai_gen_id }}__controls{text-align:right;margin-top:14px}.ai-fixed-carousel-{{ ai_gen_id }}__arrow{width:38px;height:38px;border:1px solid currentColor;background:none;border-radius:50%;cursor:pointer}@media(max-width:749px){.ai-fixed-carousel-{{ ai_gen_id }}__inner{width:100%;display:block;padding:48px 0}.ai-fixed-carousel-{{ ai_gen_id }}__intro{padding:0 20px 28px}.ai-fixed-carousel-{{ ai_gen_id }}__track{padding-left:20px}.ai-fixed-carousel-{{ ai_gen_id }}__card{flex-basis:78%}.ai-fixed-carousel-{{ ai_gen_id }}__controls{padding:0 20px}}{% endstyle %}
<editorial-fixed-carousel-{{ ai_gen_id }} class="ai-fixed-carousel-{{ ai_gen_id }}" {{ block.shopify_attributes }}><div class="ai-fixed-carousel-{{ ai_gen_id }}__inner"><div class="ai-fixed-carousel-{{ ai_gen_id }}__intro">{% if block.settings.eyebrow != blank %}<p class="ai-fixed-carousel-{{ ai_gen_id }}__eyebrow">{{ block.settings.eyebrow }}</p>{% endif %}<h2 class="ai-fixed-carousel-{{ ai_gen_id }}__heading">{{ block.settings.heading }}</h2><div class="ai-fixed-carousel-{{ ai_gen_id }}__description">{{ block.settings.description }}</div>{% if block.settings.cta_link != blank %}<a class="ai-fixed-carousel-{{ ai_gen_id }}__cta" href="{{ block.settings.cta_link }}">{{ block.settings.cta_label }} →</a>{% endif %}</div><div><div class="ai-fixed-carousel-{{ ai_gen_id }}__track" data-track>{% for i in (1..4) %}{% liquid
assign image_key = 'card_' | append: i | append: '_image'
assign category_key = 'card_' | append: i | append: '_category'
assign title_key = 'card_' | append: i | append: '_title'
assign text_key = 'card_' | append: i | append: '_text'
%}<article class="ai-fixed-carousel-{{ ai_gen_id }}__card">{% if block.settings[image_key] %}<img class="ai-fixed-carousel-{{ ai_gen_id }}__image" src="{{ block.settings[image_key] | image_url: width: 1200 }}" alt="{{ block.settings[title_key] | escape }}" width="{{ block.settings.image_width }}" height="{{ block.settings.image_height }}" loading="lazy">{% else %}<div class="ai-fixed-carousel-{{ ai_gen_id }}__placeholder">{{ 'image' | placeholder_svg_tag }}</div>{% endif %}<div class="ai-fixed-carousel-{{ ai_gen_id }}__copy"><p class="ai-fixed-carousel-{{ ai_gen_id }}__category">{{ block.settings[category_key] }}</p><h3 class="ai-fixed-carousel-{{ ai_gen_id }}__title">{{ block.settings[title_key] }}</h3><p class="ai-fixed-carousel-{{ ai_gen_id }}__text">{{ block.settings[text_key] }}</p></div></article>{% endfor %}</div><div class="ai-fixed-carousel-{{ ai_gen_id }}__controls"><button class="ai-fixed-carousel-{{ ai_gen_id }}__arrow" data-dir="prev" type="button" aria-label="Previous">←</button><button class="ai-fixed-carousel-{{ ai_gen_id }}__arrow" data-dir="next" type="button" aria-label="Next">→</button></div></div></div></editorial-fixed-carousel-{{ ai_gen_id }}>
<script>(()=>{class FixedCarousel{{ ai_gen_id }} extends HTMLElement{connectedCallback(){this.t=this.querySelector('[data-track]');this.querySelectorAll('[data-dir]').forEach(b=>b.onclick=()=>this.t.scrollBy({left:(b.dataset.dir==='next'?1:-1)*this.t.clientWidth*.72,behavior:'smooth'}))}}customElements.define('editorial-fixed-carousel-{{ ai_gen_id }}',FixedCarousel{{ ai_gen_id }})})();</script>
{% schema %}{"name":"Fixed image carousel","tag":null,"class":"fixed-image-carousel","settings":[{"type":"text","id":"eyebrow","label":"Eyebrow","default":"The FANY edit"},{"type":"text","id":"heading","label":"Heading","default":"Designed for your every day"},{"type":"textarea","id":"description","label":"Description","default":"Discover thoughtful stories where wellness, beauty and intelligent technology meet."},{"type":"text","id":"cta_label","label":"Button label","default":"Explore the edit"},{"type":"url","id":"cta_link","label":"Button link"},{"type":"header","content":"Cards"},{"type":"image_picker","id":"card_1_image","label":"Card 1 image"},{"type":"text","id":"card_1_category","label":"Card 1 category","default":"Wellness"},{"type":"text","id":"card_1_title","label":"Card 1 title","default":"A softer way to move"},{"type":"textarea","id":"card_1_text","label":"Card 1 description","default":"Small rituals that help you feel beautifully in tune."},{"type":"image_picker","id":"card_2_image","label":"Card 2 image"},{"type":"text","id":"card_2_category","label":"Card 2 category","default":"Style"},{"type":"text","id":"card_2_title","label":"Card 2 title","default":"Technology, refined"},{"type":"textarea","id":"card_2_text","label":"Card 2 description","default":"Smart details made to complement your personal style."},{"type":"image_picker","id":"card_3_image","label":"Card 3 image"},{"type":"text","id":"card_3_category","label":"Card 3 category","default":"Mindful living"},{"type":"text","id":"card_3_title","label":"Card 3 title","default":"Make space for you"},{"type":"textarea","id":"card_3_text","label":"Card 3 description","default":"Create a little more calm in the moments that matter."},{"type":"image_picker","id":"card_4_image","label":"Card 4 image"},{"type":"text","id":"card_4_category","label":"Card 4 category","default":"FANY journal"},{"type":"text","id":"card_4_title","label":"Card 4 title","default":"Your rhythm, your way"},{"type":"textarea","id":"card_4_text","label":"Card 4 description","default":"A modern perspective on feeling good and looking great."},{"type":"header","content":"Image size"},{"type":"range","id":"image_width","label":"Image width","min":180,"max":600,"step":10,"unit":"px","default":360},{"type":"range","id":"image_height","label":"Image height","min":220,"max":800,"step":10,"unit":"px","default":480},{"type":"header","content":"Style"},{"type":"range","id":"desktop_width_percent","label":"Desktop width","min":50,"max":100,"step":5,"unit":"%","default":100},{"type":"range","id":"section_padding","label":"Vertical spacing","min":20,"max":120,"step":10,"unit":"px","default":70},{"type":"range","id":"card_radius","label":"Card radius","min":0,"max":40,"step":2,"unit":"px","default":0},{"type":"range","id":"button_radius","label":"Button radius","min":0,"max":40,"step":2,"unit":"px","default":0},{"type":"color","id":"background_color","label":"Background","default":"#faf4f4"},{"type":"color","id":"text_color","label":"Text","default":"#1e0e06"},{"type":"color","id":"accent_color","label":"Accent","default":"#9e7163"},{"type":"color","id":"button_color","label":"Button","default":"#58443c"},{"type":"color","id":"button_text_color","label":"Button text","default":"#ffffff"},{"type":"font_picker","id":"heading_font","label":"Heading font","default":"lato_n4"},{"type":"font_picker","id":"body_font","label":"Body font","default":"lato_n4"}],"presets":[{"name":"Fixed image carousel"}]}{% endschema %}