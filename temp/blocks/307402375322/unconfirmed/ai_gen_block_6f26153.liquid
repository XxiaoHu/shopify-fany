{% doc %}
  @prompt
    上面h2标题，下面居中的文字段落
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-heading-paragraph-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    margin: 0 auto;
    padding: {{ block.settings.vertical_padding }}px 20px;
    text-align: center;
    color: {{ block.settings.text_color }};
  }

  .ai-heading-paragraph-{{ ai_gen_id }}__heading {
    margin: 0 0 {{ block.settings.heading_spacing }}px;
    font-size: {{ block.settings.heading_size }}px;
    line-height: 1.2;
    font-weight: 700;
    color: {{ block.settings.heading_color }};
  }

  .ai-heading-paragraph-{{ ai_gen_id }}__text {
    max-width: {{ block.settings.text_max_width }}px;
    margin: 0 auto;
    font-size: {{ block.settings.text_size }}px;
    line-height: 1.6;
  }

  .ai-heading-paragraph-{{ ai_gen_id }}__text p {
    margin: 0;
  }

  @media screen and (max-width: 749px) {
    .ai-heading-paragraph-{{ ai_gen_id }} {
      width: 100%;
      padding-right: 16px;
      padding-left: 16px;
    }

    .ai-heading-paragraph-{{ ai_gen_id }}__heading {
      font-size: {{ block.settings.heading_size | times: 0.85 }}px;
    }

    .ai-heading-paragraph-{{ ai_gen_id }}__text {
      font-size: {{ block.settings.text_size | times: 0.9 }}px;
    }
  }
{% endstyle %}

<heading-paragraph-{{ ai_gen_id }}
  class="ai-heading-paragraph-{{ ai_gen_id }}"
  {{ block.shopify_attributes }}
>
  {% if block.settings.heading != blank %}
    <h2 class="ai-heading-paragraph-{{ ai_gen_id }}__heading">
      {{ block.settings.heading | escape }}
    </h2>
  {% endif %}

  {% if block.settings.paragraph != blank %}
    <div class="ai-heading-paragraph-{{ ai_gen_id }}__text">
      {{ block.settings.paragraph }}
    </div>
  {% endif %}
</heading-paragraph-{{ ai_gen_id }}>

{% schema %}
{
  "name": "Heading and paragraph",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Discover your style"
    },
    {
      "type": "richtext",
      "id": "paragraph",
      "label": "Paragraph",
      "default": "<p>Express yourself with thoughtfully designed pieces made for every moment.</p>"
    },
    {
      "type": "range",
      "id": "desktop_width_percent",
      "label": "Desktop width",
      "min": 50,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 100
    },
    {
      "type": "range",
      "id": "heading_size",
      "label": "Heading size",
      "min": 18,
      "max": 56,
      "step": 2,
      "unit": "px",
      "default": 32
    },
    {
      "type": "range",
      "id": "text_size",
      "label": "Text size",
      "min": 12,
      "max": 24,
      "step": 1,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "text_max_width",
      "label": "Text max width",
      "min": 240,
      "max": 900,
      "step": 20,
      "unit": "px",
      "default": 640
    },
    {
      "type": "range",
      "id": "heading_spacing",
      "label": "Heading spacing",
      "min": 4,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 12
    },
    {
      "type": "range",
      "id": "vertical_padding",
      "label": "Vertical padding",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 20
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading color",
      "default": "#1e0e06"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#1e0e06"
    }
  ],
  "presets": [
    {
      "name": "Heading and paragraph"
    }
  ],
  "tag": null,
  "class": "heading-paragraph-block"
}
{% endschema %}