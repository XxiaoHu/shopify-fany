{% doc %}
  @prompt
    并排居中的四个文字块，每一块都包含：上面h3小标题，下面文字段落，每个文字块显示浅粉色。
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-four-text-blocks-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    margin: 0 auto;
    color: {{ block.settings.text_color }};
  }

  .ai-four-text-blocks__grid-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: {{ block.settings.gap }}px;
    align-items: stretch;
  }

  .ai-four-text-blocks__item-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    justify-content: center;
    min-height: {{ block.settings.min_height }}px;
    padding: {{ block.settings.padding }}px;
    text-align: center;
    background-color: {{ block.settings.background_color }};
    border-radius: {{ block.settings.corner_radius }}px;
    box-sizing: border-box;
  }

  .ai-four-text-blocks__title-{{ ai_gen_id }} {
    margin: 0 0 10px;
    color: {{ block.settings.text_color }};
    font-family: {{ block.settings.heading_font.family }};
    font-size: {{ block.settings.heading_size }}px;
    font-weight: 700;
    line-height: 1.25;
  }

  .ai-four-text-blocks__text-{{ ai_gen_id }} {
    margin: 0;
    color: {{ block.settings.text_color }};
    font-family: {{ block.settings.body_font.family }};
    font-size: {{ block.settings.body_size }}px;
    line-height: 1.6;
  }

  @media screen and (max-width: 749px) {
    .ai-four-text-blocks__grid-{{ ai_gen_id }} {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media screen and (max-width: 480px) {
    .ai-four-text-blocks__grid-{{ ai_gen_id }} {
      grid-template-columns: 1fr;
    }
  }
{% endstyle %}

<div class="ai-four-text-blocks-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-four-text-blocks__grid-{{ ai_gen_id }}">
    <div class="ai-four-text-blocks__item-{{ ai_gen_id }}">
      <h3 class="ai-four-text-blocks__title-{{ ai_gen_id }}">{{ block.settings.title_1 | escape }}</h3>
      <p class="ai-four-text-blocks__text-{{ ai_gen_id }}">{{ block.settings.text_1 | escape | newline_to_br }}</p>
    </div>
    <div class="ai-four-text-blocks__item-{{ ai_gen_id }}">
      <h3 class="ai-four-text-blocks__title-{{ ai_gen_id }}">{{ block.settings.title_2 | escape }}</h3>
      <p class="ai-four-text-blocks__text-{{ ai_gen_id }}">{{ block.settings.text_2 | escape | newline_to_br }}</p>
    </div>
    <div class="ai-four-text-blocks__item-{{ ai_gen_id }}">
      <h3 class="ai-four-text-blocks__title-{{ ai_gen_id }}">{{ block.settings.title_3 | escape }}</h3>
      <p class="ai-four-text-blocks__text-{{ ai_gen_id }}">{{ block.settings.text_3 | escape | newline_to_br }}</p>
    </div>
    <div class="ai-four-text-blocks__item-{{ ai_gen_id }}">
      <h3 class="ai-four-text-blocks__title-{{ ai_gen_id }}">{{ block.settings.title_4 | escape }}</h3>
      <p class="ai-four-text-blocks__text-{{ ai_gen_id }}">{{ block.settings.text_4 | escape | newline_to_br }}</p>
    </div>
  </div>
</div>

