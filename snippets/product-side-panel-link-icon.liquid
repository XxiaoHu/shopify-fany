{%- liquid
  assign icon_name = icon | default: 'shipping'
-%}

{%- case icon_name -%}
  {%- when 'delivery' -%}
    <svg viewBox="0 0 28 28" aria-hidden="true" focusable="false">
      <path d="M20.5838 19.1381V21.8308H3.73242V6.53345H20.5838V11.3074" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"/>
      <path d="M3.73242 10.2437H20.5838" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"/>
      <path d="M13.0195 15.2229H23.9162" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"/>
      <path d="M21.6562 12.9595L23.9149 15.2228L21.6562 17.4861" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"/>
    </svg>
  {%- when 'warranty' -%}
    <svg viewBox="0 0 28 28" aria-hidden="true" focusable="false">
      <path d="M18.8 5.2a6 6 0 0 0-7.7 7.7l-6.8 6.8a2 2 0 0 0 2.8 2.8l6.8-6.8a6 6 0 0 0 7.7-7.7l-3.7 3.7-2.8-2.8z" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
    </svg>
  {%- when 'return' -%}
    <svg viewBox="0 0 28 28" aria-hidden="true" focusable="false">
      <path d="M7.5 9.2a8 8 0 1 1-.8 8.1" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
      <path d="M7.5 5.6v3.8H3.7" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
      <path d="M14 7.4v13.2M17.2 10.6c-.7-.8-1.6-1.2-2.8-1.2-1.7 0-3 .9-3 2.3 0 1.6 1.5 2 3 2.4 1.6.4 3.1.9 3.1 2.6 0 1.4-1.3 2.4-3.1 2.4-1.3 0-2.5-.5-3.2-1.5" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round"/>
    </svg>
  {%- else -%}
    <svg viewBox="0 0 28 28" aria-hidden="true" focusable="false">
      <path d="M3.5 9.5h12v9h-12z" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/>
      <path d="M15.5 12h4.3l3.2 3.4v3.1h-7.5z" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/>
      <path d="M5.5 12.3h5.8M2.8 15.1h8.5" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
      <circle cx="8.1" cy="20" r="1.7" fill="none" stroke="currentColor" stroke-width="1.5"/>
      <circle cx="19.7" cy="20" r="1.7" fill="none" stroke="currentColor" stroke-width="1.5"/>
    </svg>
{%- endcase -%}
