    "creators_reviews_YR3Dek": {
      "type": "creators-reviews",
      "blocks": {
        "column_AbyrhT": {
          "type": "column",
          "name": "pinark_usa",
          "settings": {
            "cover_image": "shopify://shop_images/pinark_usa.webp",
            "color_scheme": "scheme-1",
            "auth": "@pinark_usa",
            "url": "https://www.instagram.com/p/DP3l1XFkbGa/",
            "summary": "<strong>A Chic & Life-Loving Mom</strong>",
            "description": "Elegance meets technology ✨The FANY Luna Classic Smartwatch combines smart features with timeless style — track your health, stay connected, and look effortlessly chic every day 💕 🩷 Plus, it comes with a 60-day money-back guarantee and a 2-year warranty, so you can shop with confidence!"
          }
        },
        "column_6Bd6cP": {
          "type": "column",
          "name": "ginnypaxkrosel",
          "settings": {
            "cover_image": "shopify://shop_images/ginnypaxkrosel.webp",
            "color_scheme": "scheme-1",
            "auth": "@ginnypaxkrosel",
            "url": "https://www.instagram.com/p/DPkxVaQjB0k/?img_index=1",
            "summary": "<strong>A Fashion & lifestyle content creator and mom</strong>",
            "description": "💖 I finally found a watch that does its smartwatch thing and is fashionable. My new FANY Luna tracks my steps, monitors my sleep, keeps me connected to my phone and even checks my stress levels. The watch has an HD touch display that I just changed to be the cutest picture of my daughter. ✨"
          }
        },
        "column_gRejTe": {
          "type": "column",
          "name": "Jennyg2bfit",
          "settings": {
            "cover_image": "shopify://shop_images/TS-HR-jennyg2bfit-002.webp",
            "color_scheme": "scheme-1",
            "auth": "@Jennyg2bfit",
            "url": "https://www.instagram.com/reel/DOgrkkGETJ2/",
            "summary": "<strong>Yoga instructor, wife, mom, cat mom</strong>",
            "description": "\"This watch has so many wonderful features and options to track your health, fitness and wellness journey. Not only does it have 110 workout modes and heart rate monitoring, it can also track sleep, your moods and stress and syncs up to your playlist too.\""
          }
        },
        "column_hje6gR": {
          "type": "column",
          "name": "fashionmeetsritu",
          "settings": {
            "cover_image": "shopify://shop_images/fashionmeetsritu.webp",
            "color_scheme": "scheme-1",
            "auth": "@fashionmeetsritu",
            "url": "https://www.instagram.com/p/DPkVEcxkpNE/?img_index=1",
            "summary": "<strong>A Fashion & Travel Creator</strong>",
            "description": "Ready to shine with style and smarts? ✨ The FANY Luna Smartwatch is my new go-to for daily life, workouts, and everything in between! 🐾💻 From tracking my steps and heartrate to mood tracking and guiding me through calming breaths, this sleek watch keeps me balanced and looking chic."
          }
        },
        "column_9bGgaL": {
          "type": "column",
          "name": "Fitandfashion with krista",
          "settings": {
            "cover_image": "shopify://shop_images/TS-HR-fitandfashionwithkrista-002.webp",
            "color_scheme": "scheme-1",
            "auth": "@Fitandfashion with krista",
            "url": "https://www.instagram.com/p/DPEMUfAjjuF/",
            "summary": "<strong>A fashional mom offers style inspiration for women 30+</strong>",
            "description": "\"When fashion meets function. 🤎 I have been blown away by this smartwatch…and it’s so pretty! Wearing it every single day! \""
          }
        },
        "column_TEekKJ": {
          "type": "column",
          "name": "Anlena_ea",
          "settings": {
            "cover_image": "shopify://shop_images/TS-HR-anlena_ea-002.webp",
            "color_scheme": "scheme-1",
            "auth": "@Anlena_ea",
            "url": "https://www.instagram.com/p/DPDGGRHDcdx/",
            "summary": "<strong>She loves fashion and travel</strong>",
            "description": "“My little wrist buddy.The FANY Luna Classic Smartwatch keeps me feeling balanced and looking cute all day. From tracking workouts and sleep to moods and heart rate—it’s got me covered. Honestly, every time I check it, I just smile.\""
          }
        },
        "column_tj9fxM": {
          "type": "column",
          "name": "Niece_shauniece",
          "disabled": true,
          "settings": {
            "cover_image": "shopify://shop_images/TS-HR-niece_shauniece-002.webp",
            "color_scheme": "scheme-1",
            "auth": "Niece_shauniece",
            "url": "",
            "summary": "<strong>A busy and fashionable mom</strong>",
            "description": "\"I’m very pleased with the FANY watch overall. The design is lightweight, comfortable to wear for long periods, and fashionable enough to pair with both casual and professional outfits. Shipping was impressively fast, which made the experience even better.\""
          }
        }
      },
