            "card_1_title": "Lightweight Design",
            "card_1_text": "A lightweight smartwatch can be more comfortable for all-day wear, especially during work, exercise, and sleep.",
            "card_2_image": "shopify://shop_images/FANY_Luna_Leather_-_-M_2e828c45-d0b9-44c1-be35-f76627052969.webp",
