    "gift_feature_wQV474": {
      "type": "gift-feature",
      "name": "礼物图文",
      "settings": {
        "eyebrow": "New Beginnings:",
        "title": "May She Spread Her Wings Freely",
        "text": "<p>Whether she's saying goodbye to campus, stepping into her first career, or chasing dreams beyond the horizon, the FANY Luna stylish smartwatch paired with the 14K gold butterfly bracelet celebrates a beautiful new beginning—and wishes her confidence, brilliance, and endless possibilities with every step ahead.</p>",
        "image": "shopify://shop_images/FANY-Luna-Moonlight_Gray-Gift_Set_3b20319a-4019-46ae-8d07-8911f3e9231c.webp",
