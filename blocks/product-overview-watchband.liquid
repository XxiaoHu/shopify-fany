{{ 'product-overview-watchband.css' | asset_url | stylesheet_tag }}
{%- style -%}
  .block-{{ block.id }}-padding {
    margin-top: 0px;
    margin-bottom: 50px;
    padding: 8rem 0;
  }


  @media screen and (min-width: 769px) {
    .block-{{ block.id }}-padding {
      margin-top: {{ block.settings.padding_top }}px;
      margin-bottom: {{ block.settings.padding_bottom }}px;
      padding: {{ block.settings.padding_bottom }}px 0;
    }
  }
  
  .watchBandContainer .swiper-slide {
    width: 140px;
    margin-right: 100px;
  }

  .watchBandContainer .watchImg {
    width: 224px;
  }
{%- endstyle -%}
<div class="product-overview-watchband block-{{ block.id }}-padding{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}">
  <div class="header-item">
    <h2
      {% if block.settings.header_width != blank and block.settings.header_width > 0 %}
        style="max-width: {{ block.settings.header_width }}px;"
      {% endif %}
    >
      {{ block.settings.header }}
    </h2>
  </div>
  <div class="watchBandContainer">
    <div class="swiper-container watchband">
      <div class="swiper-wrapper">
        {% if block.settings.watchbanks != blank %}
          {% assign watchband_imgs = metaobjects.image_group[block.settings.watchbanks].img.value %}
          {% for img_url in watchband_imgs %}
            <div class="swiper-slide">
              <img src="https://{{ shop.domain }}/cdn/shop/{{ img_url }}" alt="" loading="lazy">
            </div>
          {% endfor %}
        {% endif %}
      </div>
      <div class="swiper-button-next"></div>
      <div class="swiper-button-prev"></div>
      <div class="watchImg">
        {% if block.settings.dial_img != blank %}
          <img
            src="{{ block.settings.dial_img | image_url: width: block.settings.dial_img.width }}"
            loading="lazy"
            width="{{ block.settings.dial_img.width }}"
            height="{{ block.settings.dial_img.height }}"
          >
        {% endif %}
      </div>
    </div>
  </div>
</div>
{% schema %}
{
  "name": "表带演示-10",
  "settings": [
    {
      "type": "header",
      "content": "图片"
    },
    {
      "type": "metaobject",
      "id": "watchbanks",
      "label": "表带图片组",
      "metaobject_type": "image_group"
    },
    {
      "type": "image_picker",
      "id": "dial_img",
      "label": "表盘图片"
    },
    {
      "type": "number",
      "id": "header_width",
      "label": "标题宽度",
      "info": "默认为设置宽度"
    },
    {
      "type": "richtext",
      "id": "header",
      "label": "标题"
    },
    {
      "type": "header",
      "content": "布局"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 150,
      "step": 2,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 150,
      "step": 2,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 36
    },
  ],
  "presets": [{
    "name": "表带演示-10"
  }]
}
{% endschema %}
