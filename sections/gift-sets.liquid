{{ 'gift-sets.css' | asset_url | stylesheet_tag }}

{% style %}
  .section-{{ section.id }}-padding {
    --gs-padding-top: {{ section.settings.padding_top }}px;
    --gs-padding-bottom: {{ section.settings.padding_bottom }}px;
    --gs-safe-margin: {{ section.settings.text_safe_margin }}px;
    --gs-safe-margin-mobile: {{ section.settings.mobile_text_safe_margin }}px;
    --gs-mobile-padding-y: {{ section.settings.mobile_padding_y }}px;
    --gs-image-gap: {{ section.settings.image_gap }}px;
    --gs-image-gap-mobile: {{ section.settings.mobile_image_gap }}px;
    --gs-card-radius: {{ section.settings.card_border_radius }}px;
    --gs-view-more-color: {{ section.settings.view_more_color }};
    --gs-view-more-hover-color: {{ section.settings.view_more_hover_color }};
    --gs-view-more-size: {{ section.settings.view_more_font_size }}px;
    --gs-header-gap: {{ section.settings.header_gap }}px;
  }

  /* ---- Title ---- */
  .section-{{ section.id }}-padding .gift-sets__title {
    font-weight: {{ section.settings.title_font_weight }};
    line-height: {{ section.settings.title_line_height }};
    letter-spacing: {{ section.settings.title_letter_spacing }}px;
    text-align: {{ section.settings.title_alignment }};
    color: {{ section.settings.title_color }};
    {% if section.settings.title_width != blank and section.settings.title_width > 0 %}
    max-width: {{ section.settings.title_width }}px;
    {% endif %}
  }

  /* ---- Subtitle ---- */
  .section-{{ section.id }}-padding .gift-sets__subtitle {
    font-weight: {{ section.settings.subtitle_font_weight }};
    line-height: {{ section.settings.subtitle_line_height }};
    letter-spacing: {{ section.settings.subtitle_letter_spacing }}px;
    text-align: {{ section.settings.subtitle_alignment }};
    color: {{ section.settings.subtitle_color }};
    {% if section.settings.subtitle_width != blank and section.settings.subtitle_width > 0 %}
    max-width: {{ section.settings.subtitle_width }}px;
    {% endif %}
  }

  /* ---- Description ---- */
  .section-{{ section.id }}-padding .gift-sets__description {
    font-weight: {{ section.settings.desc_font_weight }};
    line-height: {{ section.settings.desc_line_height }};
    letter-spacing: {{ section.settings.desc_letter_spacing }}px;
    text-align: {{ section.settings.desc_alignment }};
    color: {{ section.settings.desc_color }};
    {% if section.settings.desc_width != blank and section.settings.desc_width > 0 %}
    max-width: {{ section.settings.desc_width }}px;
    {% endif %}
  }

  @media screen and (min-width: 769px) {
    .section-{{ section.id }}-padding .gift-sets__title {
      font-size: {{ section.settings.title_font_size }}px;
    }
    .section-{{ section.id }}-padding .gift-sets__subtitle {
      font-size: {{ section.settings.subtitle_font_size }}px;
    }
    .section-{{ section.id }}-padding .gift-sets__description {
      font-size: {{ section.settings.desc_font_size }}px;
    }
  }

  @media screen and (max-width: 768px) {
    .section-{{ section.id }}-padding .gift-sets__title {
      max-width: 267px;
      font-family: Lato, sans-serif;
      font-size: 24px;
      font-weight: 700;
      line-height: 1.2;
      letter-spacing: 0;
      text-align: center;
      color: #1e0e06;
    }
    .section-{{ section.id }}-padding .gift-sets__subtitle {
      font-size: 16px;
      font-weight: 500;
      line-height: 1.4;
      letter-spacing: 0;
      text-align: center;
      color: #3d3d3d;
    }
    .section-{{ section.id }}-padding .gift-sets__description {
      width: 100%;
      font-family: Lato, sans-serif;
      font-size: 16px;
      font-weight: 400;
      line-height: 1.5;
      letter-spacing: 0;
      text-align: center;
      color: #686766;
    }
    .section-{{ section.id }}-padding .gift-sets__header {
      --gs-header-gap: 20px;
    }
  }
{% endstyle %}

<div class="gift-sets section-{{ section.id }}-padding">
  {%- if section.settings.title != blank or section.settings.subtitle != blank or section.settings.description != blank -%}
    <div class="gift-sets__header">
      {%- if section.settings.title != blank -%}
        <h2 class="gift-sets__title">{{ section.settings.title | escape | newline_to_br }}</h2>
      {%- endif -%}
      {%- if section.settings.subtitle != blank -%}
        <p class="gift-sets__subtitle">{{ section.settings.subtitle | escape | newline_to_br }}</p>
      {%- endif -%}
      {%- if section.settings.description != blank -%}
        <p class="gift-sets__description">{{ section.settings.description | escape | newline_to_br }}</p>
      {%- endif -%}
    </div>
  {%- endif -%}

  <div class="gift-sets__slider">
    <div class="gift-sets__grid" id="GiftSetsSlider-{{ section.id }}">
      {%- for block in section.blocks -%}
        <div class="gift-sets__card" {{ block.shopify_attributes }}>
          {%- if block.settings.link != blank -%}
            <a href="{{ block.settings.link }}" class="gift-sets__card-link">
              <span class="visually-hidden">{{ block.settings.image.alt | escape }}</span>
            </a>
          {%- endif -%}
          {%- if block.settings.image != blank -%}
            {{
              block.settings.image
              | image_url: width: 1000
              | image_tag:
                class: 'gift-sets__card-image',
                loading: 'lazy',
                sizes: '(max-width: 768px) 300px, 33vw',
                widths: '300, 375, 496, 750, 1000'
            }}
          {%- else -%}
            <div class="gift-sets__card-image" style="background: #f6f6f6;">
              {{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}
            </div>
          {%- endif -%}
        </div>
      {%- else -%}
        {%- for i in (1..3) -%}
          <div class="gift-sets__card">
            <div class="gift-sets__card-image" style="background: #f6f6f6;">
              {{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}
            </div>
          </div>
        {%- endfor -%}
      {%- endfor -%}
    </div>

    <button
      type="button"
      class="gift-sets__nav gift-sets__nav--prev"
      aria-label="Previous"
      aria-controls="GiftSetsSlider-{{ section.id }}"
    >
      <span aria-hidden="true"></span>
    </button>
    <button
      type="button"
      class="gift-sets__nav gift-sets__nav--next"
      aria-label="Next"
      aria-controls="GiftSetsSlider-{{ section.id }}"
    >
      <span aria-hidden="true"></span>
    </button>
  </div>

  {%- if section.settings.view_more_text != blank and section.settings.view_more_link != blank -%}
    <div class="gift-sets__view-more">
      <a href="{{ section.settings.view_more_link }}">{{ section.settings.view_more_text }}</a>
    </div>
  {%- endif -%}
</div>

<script>
  (() => {
    const initGiftSets = () => {
      const section = document.querySelector('.section-{{ section.id }}-padding');
      if (!section) return;

      const slider = section.querySelector('#GiftSetsSlider-{{ section.id }}');
      const prevButton = section.querySelector('.gift-sets__nav--prev');
      const nextButton = section.querySelector('.gift-sets__nav--next');
      if (!slider || !prevButton || !nextButton) return;

      const scrollByCard = (direction) => {
        const firstCard = slider.querySelector('.gift-sets__card');
        const gap = parseFloat(getComputedStyle(slider).columnGap || getComputedStyle(slider).gap) || 10;
        const distance = firstCard ? firstCard.getBoundingClientRect().width + gap : 310;
        slider.scrollBy({ left: direction * distance, behavior: 'smooth' });
      };

      prevButton.addEventListener('click', () => scrollByCard(-1));
      nextButton.addEventListener('click', () => scrollByCard(1));
    };

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initGiftSets);
    } else {
      initGiftSets();
    }

    document.addEventListener('shopify:section:load', (event) => {
      if (event.detail.sectionId === '{{ section.id }}') initGiftSets();
    });
  })();
</script>

{%- if request.design_mode -%}
  <script src="{{ 'theme-editor.js' | asset_url }}" defer="defer"></script>
{%- endif -%}

