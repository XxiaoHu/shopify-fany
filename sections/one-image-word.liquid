{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (max-width: 749px) {
    .desktop-image { display: none; }
    .mobile-image { display: flex; }
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
    .desktop-image { display: flex; }
    .mobile-image { display: none; }
  }

  .img-wrapper-title {
    margin-top: 0;
    margin-bottom: 3rem;
  }

  .img__item__buttons {
    margin: 0 auto;
    margin-bottom: 30px;
  }

  @media screen and (min-width: 769px) {
    .img__item__buttons {
      position: absolute;
      bottom: 40px;
      left: 50%;
      transform: translate(-50%, 0);
      z-index: 1;
      margin-bottom: 0px;
    }
  }

  @media screen and (max-width: 768px) {
    .img__item__buttons .f-18 {
      font-size: calc(var(--font-heading-scale) * 1.6rem) !important;
    }
  }
{%- endstyle -%}

<div class="color-{{ section.settings.color_scheme }} gradient isolate">
  <div class="page-width section-{{ section.id }}-padding {{ section.settings.alignment}}">
    {%- if section.settings.heading != blank or section.settings.text != blank -%}
      <div class="img-wrapper-title{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}">
        {%- if section.settings.heading != blank -%}
        <h2 class="wrapper-title inline-richtext {{ section.settings.heading_size }}">
          {{ section.settings.heading }}
        </h2>
        {%- endif -%}
        {%- if section.settings.text != blank -%}
          <div class="wrapper-sub_title inline-richtext {{ section.settings.text_size }}">
            {{ section.settings.text }}
          </div>
        {%- endif -%}
      </div>
    {%- endif -%}
    
    <div class="img">
      {%- if section.settings.button_label != blank -%}
        <div class="img__item__buttons">
          <a
            {% if section.settings.btn_width != blank and section.settings.btn_width > 0 %}
              style="width: {{ section.settings.btn_width }}px;"
            {% endif %}
            {% if section.settings.link %}
              href="{{ section.settings.link }}"
            {% else %}
              role="link" aria-disabled="true"
            {% endif %}
            class="button f-18 button--secondary"
          >
            {{- section.settings.button_label | escape -}}
          </a>
        </div>
      {%- endif -%}
      <div
        class="img__item {% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}"
      >
        <div class="global-media-settings">
          {% if section.settings.link and section.settings.button_label == blank %}
            <a href="{{ section.settings.link }}" class="full-link"></a>
          {%- endif -%}
          {%- if section.settings.image != blank -%}
            <div
              class="desktop-image media media--transparent ratio"
              style="--ratio-percent: {{ 1 | divided_by: section.settings.image.aspect_ratio | times: 100 }}%"
            >
              {%- capture sizes -%}
                      (min-width: {{ settings.page_width }}px) calc({{ settings.page_width }}px - 100px),
                      (min-width: 750px) calc(100vw - 100px),
                      calc(100vw - 30px)
                      {%- endcapture -%}
              {{
                section.settings.image
                | image_url: width: 3200
                | image_tag:
                  loading: 'lazy',
                  sizes: sizes,
                  widths: '50, 75, 100, 150, 200, 300, 400, 500, 750, 1000, 1250, 1500, 1750, 2000, 2250, 2500, 2750, 3000, 3200'
              }}
            </div>
            {%- if section.settings.mobile_image != blank -%}
              <div
                class="mobile-image media media--transparent ratio"
                style="--ratio-percent: {{ 1 | divided_by: section.settings.mobile_image.aspect_ratio | times: 100 }}%"
              >
                {%- capture sizes -%}
                      (min-width: {{ settings.page_width }}px) calc({{ settings.page_width }}px - 100px),
                      (min-width: 750px) calc(100vw - 100px),
                      calc(100vw - 30px)
                      {%- endcapture -%}
                {{
                  section.settings.mobile_image
                  | image_url: width: 750
                  | image_tag:
                    loading: 'lazy',
                    sizes: sizes,
                    widths: '50, 75, 100, 150, 200, 300, 400, 500, 750, 1000, 1250, 1500, 1750, 2000, 2250, 2500, 2750, 3000, 3200'
                }}
              </div>
            {%- endif -%}
          {%- else -%}
            <div class="media media--transparent ratio" style="--ratio-percent: 100%">
              {{ 'detailed-apparel-1' | placeholder_svg_tag: 'placeholder-svg' }}
            </div>
          {%- endif -%}
        </div>
      </div>
    </div>
  </div>
</div>

