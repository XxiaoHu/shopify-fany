{{ 'percentage-position-banner.css' | asset_url | stylesheet_tag }}

{% style %}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.desktop_padding_top }}px;
    padding-bottom: {{ section.settings.desktop_padding_bottom }}px;
    --ppb-safe-margin: {{ section.settings.text_safe_margin }}px;
    --ppb-safe-margin-mobile: {{ section.settings.mobile_text_safe_margin }}px;
  }

  @media screen and (max-width: 749px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.mobile_padding_top }}px;
      padding-bottom: {{ section.settings.mobile_padding_bottom }}px;
    }
  }

  /* Slide height overrides */
  {%- if section.settings.slide_height == 'small' -%}
    .section-{{ section.id }}-padding .percentage-position-banner__media { height: 560px; }
  {%- elsif section.settings.slide_height == 'medium' -%}
    .section-{{ section.id }}-padding .percentage-position-banner__media { height: 720px; }
  {%- elsif section.settings.slide_height == 'large' -%}
    .section-{{ section.id }}-padding .percentage-position-banner__media { height: 1000px; }
  {%- endif -%}
  {%- unless section.settings.slide_height == 'adapt_image' -%}
    @media screen and (max-width: 749px) {
      .section-{{ section.id }}-padding .percentage-position-banner__media,
      .section-{{ section.id }}-padding .percentage-position-banner__slide { height: calc(100vh - 39px); }
    }
  {%- endunless -%}

  /* Per-slide custom styles */
  {%- for block in section.blocks -%}
    {%- liquid
      assign desktop_image_aspect_ratio = block.settings.image.aspect_ratio
      assign mobile_image_aspect_ratio = desktop_image_aspect_ratio
      if block.settings.mobile_image != blank
        assign mobile_image_aspect_ratio = block.settings.mobile_image.aspect_ratio
      endif
    -%}
    #Slide-{{ section.id }}-{{ forloop.index }} .percentage-position-banner__media::after {
      opacity: {{ block.settings.image_overlay_opacity | divided_by: 100.0 }};
    }

    {%- if block.settings.image != blank -%}
      #Slide-{{ section.id }}-{{ forloop.index }} .percentage-position-banner__media {
        --percentage-position-banner-desktop-ratio: {{ desktop_image_aspect_ratio }};
        --percentage-position-banner-mobile-ratio: {{ mobile_image_aspect_ratio }};
      }
    {%- endif -%}

    {%- if section.settings.slide_height == 'adapt_image' and block.settings.image != blank -%}
      #Slide-{{ section.id }}-{{ forloop.index }} .percentage-position-banner__media--adapt {
        --percentage-position-banner-adapt-ratio: {{ desktop_image_aspect_ratio }};
      }

      @media screen and (max-width: 749px) {
        #Slide-{{ section.id }}-{{ forloop.index }} .percentage-position-banner__media--adapt {
          --percentage-position-banner-adapt-ratio: {{ mobile_image_aspect_ratio }};
        }
      }
    {%- endif -%}

    /* ---- Percentage content position (overlay mode only) ---- */
    @media screen and (min-width: 750px) {
      #Slide-{{ section.id }}-{{ forloop.index }}.percentage-position-banner__slide--desktop-overlay .percentage-position-banner__content {
        inset: auto;
        top: {{ block.settings.desktop_content_top }}%;
        left: {{ block.settings.desktop_content_left }}%;
        width: calc(100% - {{ block.settings.desktop_content_left }}%);
        height: calc(100% - {{ block.settings.desktop_content_top }}%);
        padding: 0;
        align-items: flex-start;
        justify-content: flex-start;
      }
    }

    @media screen and (max-width: 749px) {
      #Slide-{{ section.id }}-{{ forloop.index }}.percentage-position-banner__slide--mobile-overlay .percentage-position-banner__content {
        inset: auto;
        top: {{ block.settings.mobile_content_top }}%;
        left: {{ block.settings.mobile_content_left }}%;
        width: calc(100% - {{ block.settings.mobile_content_left }}%);
        height: calc(100% - {{ block.settings.mobile_content_top }}%);
        padding: 0;
        align-items: flex-start;
        justify-content: flex-start;
      }
    }

    /* ---- Title ---- */
    #Slide-{{ section.id }}-{{ forloop.index }} .percentage-position-banner__title {
      font-weight: {{ block.settings.title_font_weight }};
      line-height: {{ block.settings.title_line_height }};
      letter-spacing: {{ block.settings.title_letter_spacing }}px;
      text-align: {{ block.settings.title_alignment }};
      white-space: pre-line;
      {% if block.settings.title_width != blank and block.settings.title_width > 0 %}
      width: {{ block.settings.title_width }}px;
      max-width: 100%;
      {% endif %}
    }

    /* ---- Subtitle ---- */
    #Slide-{{ section.id }}-{{ forloop.index }} .percentage-position-banner__subtitle {
      font-weight: {{ block.settings.subtitle_font_weight }};
      line-height: {{ block.settings.subtitle_line_height }};
      letter-spacing: {{ block.settings.subtitle_letter_spacing }}px;
      text-align: {{ block.settings.subtitle_alignment }};
      white-space: pre-line;
      {% if block.settings.subtitle_width != blank and block.settings.subtitle_width > 0 %}
      width: {{ block.settings.subtitle_width }}px;
      max-width: 100%;
      {% endif %}
    }
    #Slide-{{ section.id }}-{{ forloop.index }} .percentage-position-banner__title + .percentage-position-banner__subtitle {
      margin-top: calc({{ block.settings.title_subtitle_gap }}px - {{ block.settings.title_desc_gap }}px);
    }
    #Slide-{{ section.id }}-{{ forloop.index }} .percentage-position-banner__subtitle + .percentage-position-banner__description {
      margin-top: calc({{ block.settings.subtitle_desc_gap }}px - {{ block.settings.title_desc_gap }}px);
    }

    /* ---- Description ---- */
    #Slide-{{ section.id }}-{{ forloop.index }} .percentage-position-banner__description {
      font-weight: {{ block.settings.desc_font_weight }};
      line-height: {{ block.settings.desc_line_height }};
      letter-spacing: {{ block.settings.desc_letter_spacing }}px;
      text-align: {{ block.settings.desc_alignment }};
    }
    #Slide-{{ section.id }}-{{ forloop.index }} .percentage-position-banner__description p,
    #Slide-{{ section.id }}-{{ forloop.index }} .percentage-position-banner__description span,
    #Slide-{{ section.id }}-{{ forloop.index }} .percentage-position-banner__description strong,
    #Slide-{{ section.id }}-{{ forloop.index }} .percentage-position-banner__description em {
      line-height: inherit;
    }
    #Slide-{{ section.id }}-{{ forloop.index }} .percentage-position-banner__description p {
      margin: 0;
    }

    /* Title–Description gap */
    #Slide-{{ section.id }}-{{ forloop.index }} .percentage-position-banner__content-inner {
      gap: {{ block.settings.title_desc_gap }}px;
    }

    /* ---- Button ---- */
    #Slide-{{ section.id }}-{{ forloop.index }} .percentage-position-banner__button {
      --ppb-btn-bg: {{ block.settings.btn_bg_color }};
      --ppb-btn-bg-hover: {{ block.settings.btn_bg_hover_color }};
      --ppb-btn-bg-active: {{ block.settings.btn_bg_active_color }};
      --ppb-btn-color: {{ block.settings.btn_text_color }};
      --ppb-btn-color-hover: {{ block.settings.btn_text_hover_color }};
      --ppb-btn-color-active: {{ block.settings.btn_text_active_color }};
      --ppb-btn-radius: {{ block.settings.btn_border_radius }}px;
      --ppb-btn-padding-y: {{ block.settings.btn_padding_y }}px;
      --ppb-btn-padding-x: {{ block.settings.btn_padding_x }}px;
      {% if block.settings.btn_width != blank and block.settings.btn_width > 0 %}
      width: {{ block.settings.btn_width }}px;
      {% endif %}
      font-size: {{ block.settings.btn_font_size }}px;
      align-self: {{ block.settings.button_alignment | default: 'flex-start' }};
    }

    @media screen and (max-width: 749px) {
      #Slide-{{ section.id }}-{{ forloop.index }} .percentage-position-banner__title {
        font-size: {{ block.settings.mobile_title_font_size }}px;
        color: {{ block.settings.mobile_title_color }};
        text-align: {{ block.settings.mobile_title_alignment | default: block.settings.title_alignment }};
      }
      #Slide-{{ section.id }}-{{ forloop.index }} .percentage-position-banner__subtitle {
        font-size: {{ block.settings.mobile_subtitle_font_size }}px;
        color: {{ block.settings.mobile_subtitle_color }};
        text-align: {{ block.settings.mobile_subtitle_alignment | default: block.settings.subtitle_alignment }};
      }
      #Slide-{{ section.id }}-{{ forloop.index }} .percentage-position-banner__description {
        font-size: {{ block.settings.mobile_desc_font_size }}px;
        color: {{ block.settings.mobile_desc_color }};
        text-align: {{ block.settings.mobile_desc_alignment | default: block.settings.desc_alignment }};
      }
      #Slide-{{ section.id }}-{{ forloop.index }} .percentage-position-banner__button {
        align-self: {{ block.settings.mobile_button_alignment | default: block.settings.button_alignment | default: 'flex-start' }};
      }
      #Slide-{{ section.id }}-{{ forloop.index }} .percentage-position-banner__content-inner {
        gap: {{ block.settings.mobile_title_desc_gap }}px;
      }
      #Slide-{{ section.id }}-{{ forloop.index }} .percentage-position-banner__title + .percentage-position-banner__subtitle {
        margin-top: calc({{ block.settings.mobile_title_subtitle_gap }}px - {{ block.settings.mobile_title_desc_gap }}px);
      }
      #Slide-{{ section.id }}-{{ forloop.index }} .percentage-position-banner__subtitle + .percentage-position-banner__description {
        margin-top: calc({{ block.settings.mobile_subtitle_desc_gap }}px - {{ block.settings.mobile_title_desc_gap }}px);
      }
    }

    @media screen and (min-width: 750px) {
      #Slide-{{ section.id }}-{{ forloop.index }} .percentage-position-banner__title {
        font-size: {{ block.settings.title_font_size }}px;
        color: {{ block.settings.title_color }};
      }
      #Slide-{{ section.id }}-{{ forloop.index }} .percentage-position-banner__subtitle {
        font-size: {{ block.settings.subtitle_font_size }}px;
        color: {{ block.settings.subtitle_color }};
      }
      #Slide-{{ section.id }}-{{ forloop.index }} .percentage-position-banner__description {
        font-size: {{ block.settings.desc_font_size }}px;
        color: {{ block.settings.desc_color }};
      }
    }
  {%- endfor -%}
{% endstyle %}

<script src="{{ 'percentage-position-banner.js' | asset_url }}" defer="defer"></script>

<percentage-position-banner-component
  class="percentage-position-banner section-{{ section.id }}-padding"
  role="region"
  aria-label="{{ section.settings.accessibility_info | escape }}"
  aria-roledescription="{{ 'sections.slideshow.carousel' | t }}"
  data-autoplay="{{ section.settings.auto_rotate }}"
  data-speed="{{ section.settings.change_slides_speed }}"
>
  <div
    class="percentage-position-banner__slider{% if section.blocks.size == 0 %} percentage-position-banner--placeholder{% endif %}"
    id="PercentagePositionBannerSlider-{{ section.id }}"
    aria-live="polite"
    aria-atomic="true"
  >
    {%- for block in section.blocks -%}
      <div
        class="percentage-position-banner__slide percentage-position-banner__slide--desktop-{{ block.settings.desktop_layout_mode | default: 'overlay' }} percentage-position-banner__slide--mobile-{{ block.settings.mobile_layout_mode | default: 'overlay' }}"
        id="Slide-{{ section.id }}-{{ forloop.index }}"
        {{ block.shopify_attributes }}
        role="group"
        aria-roledescription="{{ 'sections.slideshow.slide' | t }}"
        aria-label="{{ forloop.index }} {{ 'general.slider.of' | t }} {{ forloop.length }}"
        tabindex="-1"
      >
        {%- if block.settings.link != blank -%}
          <a
            href="{{ block.settings.link }}"
            class="percentage-position-banner__link"
            {% if block.settings.link_target_blank %}target="_blank" rel="noopener noreferrer"{% endif %}
          >
            <span class="visually-hidden">{{ block.settings.link_text | default: block.settings.title | strip_html }}</span>
          </a>
        {%- endif -%}

        {%- if block.settings.image != blank -%}
          <div class="percentage-position-banner__media{% if section.settings.slide_height == 'adapt_image' %} percentage-position-banner__media--adapt{% endif %}">
            {%- liquid
              assign fetch_priority = 'auto'
              if section.index == 1 and forloop.first
                assign fetch_priority = 'high'
              endif
            -%}
            {%- if block.settings.mobile_image != blank -%}
              <picture>
                <source media="(max-width: 749px)" srcset="{{ block.settings.mobile_image | image_url: width: 768 }}">
                {{
                  block.settings.image
                  | image_url: width: 3840
                  | image_tag:
                    loading: 'lazy',
                    fetchpriority: fetch_priority,
                    sizes: '100vw',
                    widths: '375, 550, 750, 1100, 1500, 1780, 2000, 3000, 3840'
                }}
              </picture>
            {%- else -%}
              {{
                block.settings.image
                | image_url: width: 3840
                | image_tag:
                  loading: 'lazy',
                  fetchpriority: fetch_priority,
                  sizes: '100vw',
                  widths: '375, 550, 750, 1100, 1500, 1780, 2000, 3000, 3840'
              }}
            {%- endif -%}
          </div>
        {%- else -%}
          <div class="percentage-position-banner__media">
            {{ 'hero-apparel-2' | placeholder_svg_tag: 'placeholder-svg' }}
          </div>
        {%- endif -%}

        {%- if block.settings.title != blank
          or block.settings.subtitle != blank
          or block.settings.description != blank
          or block.settings.button_label != blank
        -%}
          <div class="
            percentage-position-banner__content
          ">
            <div class="percentage-position-banner__content-inner">
              {%- if block.settings.title != blank -%}
                <h2 class="percentage-position-banner__title inline-richtext">
                  {{ block.settings.title | escape }}
                </h2>
              {%- endif -%}

              {%- if block.settings.subtitle != blank -%}
                <div class="percentage-position-banner__subtitle">{{- block.settings.subtitle | strip | escape -}}</div>
              {%- endif -%}

              {%- if block.settings.description != blank -%}
                <div class="percentage-position-banner__description rte">
                  {{ block.settings.description }}
                </div>
              {%- endif -%}

              {%- if block.settings.button_label != blank -%}
                <a
                  {% if block.settings.button_link != blank %}
                    href="{{ block.settings.button_link }}"
                  {% else %}
                    role="link" aria-disabled="true"
                  {% endif %}
                  class="percentage-position-banner__button percentage-position-banner__button--{{ block.settings.button_style }}"
                >
                  {{- block.settings.button_label | escape -}}
                </a>
              {%- endif -%}
            </div>
          </div>
        {%- endif -%}
      </div>
    {%- else -%}
      {%- comment -%}Empty state placeholder{%- endcomment -%}
      {%- for i in (1..2) -%}
        <div class="percentage-position-banner__slide" role="group">
          <div class="percentage-position-banner__media">
            {{ 'hero-apparel-' | append: i | placeholder_svg_tag: 'placeholder-svg' }}
          </div>
        </div>
      {%- endfor -%}
    {%- endfor -%}
  </div>

  {%- if section.blocks.size > 1 -%}
    {%- comment -%}Arrow Navigation{%- endcomment -%}
    <div class="percentage-position-banner__arrows">
      <button
        type="button"
        class="percentage-position-banner__arrow percentage-position-banner__arrow--prev"
        name="previous"
        aria-label="{{ 'sections.slideshow.previous_slideshow' | t }}"
        aria-controls="PercentagePositionBannerSlider-{{ section.id }}"
      >
        <img src="{{ '1.svg' | asset_url }}" class="percentage-position-banner__arrow-img percentage-position-banner__arrow-img--default" width="60" height="60" alt="">
        <img src="{{ '2.svg' | asset_url }}" class="percentage-position-banner__arrow-img percentage-position-banner__arrow-img--hover" width="60" height="60" alt="">
      </button>
      <button
        type="button"
        class="percentage-position-banner__arrow percentage-position-banner__arrow--next"
        name="next"
        aria-label="{{ 'sections.slideshow.next_slideshow' | t }}"
        aria-controls="PercentagePositionBannerSlider-{{ section.id }}"
      >
        <img src="{{ '1.svg' | asset_url }}" class="percentage-position-banner__arrow-img percentage-position-banner__arrow-img--default" width="60" height="60" alt="">
        <img src="{{ '2.svg' | asset_url }}" class="percentage-position-banner__arrow-img percentage-position-banner__arrow-img--hover" width="60" height="60" alt="">
      </button>
    </div>

    {%- comment -%}Bottom Dot / Pill Indicators{%- endcomment -%}
    <div class="percentage-position-banner__indicators">
      {%- for block in section.blocks -%}
        <button
          class="percentage-position-banner__indicator{% if forloop.first %} percentage-position-banner__indicator--active{% endif %}"
          aria-label="{{ 'sections.slideshow.load_slide' | t }} {{ forloop.index }} {{ 'general.slider.of' | t }} {{ forloop.length }}"
          aria-controls="PercentagePositionBannerSlider-{{ section.id }}"
          {% if forloop.first %}aria-current="true"{% endif %}
        ></button>
      {%- endfor -%}
    </div>
  {%- endif -%}
</percentage-position-banner-component>

{%- if request.design_mode -%}
  <script src="{{ 'theme-editor.js' | asset_url }}" defer="defer"></script>
{%- endif -%}

{% schema %}
{
  "name": "百分比定位 Banner 轮播",
  "tag": "section",
  "class": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "select",
      "id": "slide_height",
      "options": [
        {
          "value": "adapt_image",
          "label": "适配图片高度"
        },
        {
          "value": "small",
          "label": "小（560px）"
        },
        {
          "value": "medium",
          "label": "中（720px）"
        },
        {
          "value": "large",
          "label": "大（1000px）"
        }
      ],
      "default": "large",
      "label": "幻灯片高度"
    },
    {
      "type": "checkbox",
      "id": "auto_rotate",
      "label": "自动轮播",
      "default": true
    },
    {
      "type": "range",
      "id": "change_slides_speed",
      "min": 3,
      "max": 12,
      "step": 1,
      "unit": "s",
      "label": "自动切换间隔",
      "default": 5
    },
    {
      "type": "range",
      "id": "text_safe_margin",
      "min": 0,
      "max": 400,
      "step": 10,
      "unit": "px",
      "label": "文字安全边距（桌面端）",
      "default": 200
    },
    {
      "type": "range",
      "id": "desktop_padding_top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "label": "PC 上间距",
      "default": 0
    },
    {
      "type": "range",
      "id": "desktop_padding_bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "label": "PC 下间距",
      "default": 0
    },
    {
      "type": "header",
      "content": "移动端设置"
    },
    {
      "type": "range",
      "id": "mobile_text_safe_margin",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "label": "文字安全边距（移动端）",
      "default": 24
    },
    {
      "type": "range",
      "id": "mobile_padding_top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 0
    },
    {
      "type": "range",
      "id": "mobile_padding_bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 0
    },
    {
      "type": "header",
      "content": "辅助功能"
    },
    {
      "type": "text",
      "id": "accessibility_info",
      "label": "轮播描述（供屏幕阅读器使用）",
      "default": "首页横幅轮播"
    }
  ],
  "blocks": [
    {
      "type": "slide",
      "name": "幻灯片",
      "settings": [
        {
          "type": "header",
          "content": "图片"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "桌面端图片"
        },
        {
          "type": "image_picker",
          "id": "mobile_image",
          "label": "移动端图片（可选）"
        },
        {
          "type": "range",
          "id": "image_overlay_opacity",
          "min": 0,
          "max": 100,
          "step": 10,
          "unit": "%",
          "label": "图片遮罩透明度",
          "default": 0
        },
        {
          "type": "header",
          "content": "链接"
        },
        {
          "type": "url",
          "id": "link",
          "label": "整页跳转链接（点击整个横幅区域）"
        },
        {
          "type": "text",
          "id": "link_text",
          "label": "链接描述（用于无障碍访问）"
        },
        {
          "type": "checkbox",
          "id": "link_target_blank",
          "label": "在新标签页打开",
          "default": false
        },
        {
          "type": "header",
          "content": "内容位置"
        },
        {
          "type": "select",
          "id": "desktop_layout_mode",
          "options": [
            { "value": "overlay", "label": "当前效果" },
            { "value": "image_text", "label": "上图下文" },
            { "value": "text_image", "label": "上文下图" }
          ],
          "default": "overlay",
          "label": "PC端布局方式"
        },
        {
          "type": "select",
          "id": "mobile_layout_mode",
          "options": [
            { "value": "overlay", "label": "当前效果" },
            { "value": "image_text", "label": "上图下文" },
            { "value": "text_image", "label": "上文下图" }
          ],
          "default": "overlay",
          "label": "移动端布局方式"
        },
        {
          "type": "header",
          "content": "PC 文字百分比位置"
        },
        {
          "type": "range",
          "id": "desktop_content_top",
          "min": 0,
          "max": 100,
          "step": 1,
          "unit": "%",
          "default": 40,
          "label": "距离顶部"
        },
        {
          "type": "range",
          "id": "desktop_content_left",
          "min": 0,
          "max": 100,
          "step": 1,
          "unit": "%",
          "default": 10,
          "label": "距离左侧"
        },
        {
          "type": "header",
          "content": "移动端文字百分比位置"
        },
        {
          "type": "range",
          "id": "mobile_content_top",
          "min": 0,
          "max": 100,
          "step": 1,
          "unit": "%",
          "default": 65,
          "label": "距离顶部"
        },
        {
          "type": "range",
          "id": "mobile_content_left",
          "min": 0,
          "max": 100,
          "step": 1,
          "unit": "%",
          "default": 6,
          "label": "距离左侧"
        },
        {
          "type": "header",
          "content": "标题"
        },
        {
          "type": "textarea",
