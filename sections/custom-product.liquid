<div class="productContainer">
  <!-- 左侧商品主图 -->
  <div class="left-panel">
    <div style="--swiper-navigation-color: #fff; --swiper-pagination-color: #fff" class="displayContainer">
      <div class="swiper product-thumbnail-swiper small-img">
        <div class="swiper-wrapper">
          <div class="swiper-slide">
            <img src="image/productDetail/mainImg1.png" />
          </div>
          <div class="swiper-slide">
            <img src="image/productDetail/mainImg2.jpg" />
          </div>
          <div class="swiper-slide">
            <img src="image/productDetail/mainImg3.jpg" />
          </div>
          <div class="swiper-slide">
            <img src="image/productDetail/mainImg4.jpg" />
          </div>
          <div class="swiper-slide">
            <img src="image/productDetail/mainImg5.jpg" />
          </div>
          <div class="swiper-slide">
            <img src="image/productDetail/mainImg6.jpg" />
          </div>
          <div class="swiper-slide">
            <img src="image/productDetail/mainImg7.jpg" />
          </div>
          <div class="swiper-slide">
            <img src="image/productDetail/mainImg8.jpg" />
          </div>
        </div>
      </div>
      <div thumbsSlider="" class="swiper product-main-swiper product-image">
        <div class="swiper-wrapper">
          <div class="swiper-slide">
            <img src="image/productDetail/mainImg1.png" />
          </div>
          <div class="swiper-slide">
            <img src="image/productDetail/mainImg2.jpg" />
          </div>
          <div class="swiper-slide">
            <img src="image/productDetail/mainImg3.jpg" />
          </div>
          <div class="swiper-slide">
            <img src="image/productDetail/mainImg4.jpg" />
          </div>
          <div class="swiper-slide">
            <img src="image/productDetail/mainImg5.jpg" />
          </div>
          <div class="swiper-slide">
            <img src="image/productDetail/mainImg6.jpg" />
          </div>
          <div class="swiper-slide">
            <img src="image/productDetail/mainImg7.jpg" />
          </div>
          <div class="swiper-slide">
            <img src="image/productDetail/mainImg8.jpg" />
          </div>
        </div>
        <div class="swiper-button-next productNextBtn"></div>
        <div class="swiper-button-prev productPreBtn"></div>
      </div>
    </div>
    <div class="iconContainer">
      <ul class="productIconList">
        <li><img src="image/productDetail/mainImage/FreeU.S.shipping.png" alt=""/><span>Free U.S. shipping</span></li>
        <li><img src="image/productDetail/mainImage/Shipin1–3businessdays.png" alt=""/><span>Ship in 1–3 business days</span></li>
        <li><img src="image/productDetail/mainImage/2-yearwarranty.png" alt=""/><span>2-year warranty</span></li>
        <li><img src="image/productDetail/mainImage/60-daymoneybackguarantee.png" alt=""/><span>60-day money back guarantee</span></li>
      </ul>
    </div>
  </div>
  <div class="right-panel">
    <div class="product-info">
      <h1 class="latoBold productTitle">FANY Luna Classic<br/>Smartwatch</h1>
      <p class="subTitle latoRegular">Designed for Women's Stylish& Wellness Life</p>
      <p class="description latoRegular">· Next-generation accurate heart rate sensor 
        <br/>· Connect with all five major satellite systems 
        <br/>· Wide range of activity modes and third-party integrations 
        <br/>· Free global offline maps for on-wrist navigation</p>
      <div class="productAi"><i class="fl aiImg"></i><span class="fl">TryStyle AI</span></div>
      <div class="latoBold"><span class="finalPrice">$79</span><span class="initPrice latoLight">$99</span></div>
      <p class="productColor latoBold">Option/Color</p>
      <ul class="productColorList clearfix">
        <li class="latoRegular active"><i class="modena"></i><span>Modena</span></li>
        <li class="latoRegular"><i class="champagne"></i><span>Champagne</span></li>
        <li class="latoRegular"><i class="gray"></i><span>Grey</span></li>
      </ul>
      <p class="addBansTitle latoBold">Additional Bands</p>
      <ul class="product-list">
        <li class="product-item active">
          <img class="item-thumbnail fl" src="image/productDetail/mainImage/LeatherBand-Modena.png" alt="">
          <span class="item-title fl">Leather Band-Modena</span>
          <span class="item-select fr selected" onclick="itemSeleted(this)"></span>
          <span class="item-price fr">$29</span>
        </li>
        <li class="product-item">
          <img class="item-thumbnail fl" src="image/productDetail/mainImage/NylonBand-Grey.png" alt="">
          <span class="item-title fl">Nylon Band-Grey</span>
          <span class="item-select fr" onclick="itemSeleted(this)"></span>
          <span class="item-price fr">$16</span>
        </li>
        <li class="product-item">
          <img class="item-thumbnail fl" src="image/productDetail/mainImage/SiliconeBand-Champagne.png" alt="">
          <span class="item-title fl">Silicone Band-Champagne</span>
          <span class="item-select fr" onclick="itemSeleted(this)"></span>
          <span class="item-price fr">$16</span>
        </li>
      </ul>
      <div class="addToCard">
        <img src="image/productDetail/mainImage/ADDTOCARD.png" alt=""><span>ADD TO CARD</span>
      </div>
    </div>
  </div>
</div>
{% schema %}
  {
    "name": "Section name",
    "settings": []
  }
{% endschema %}