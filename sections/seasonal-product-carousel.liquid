    },
    {
      "type": "range",
      "id": "desktop_heading_line_height",
      "min": 80,
      "max": 200,
      "step": 5,
      "unit": "%",
      "label": "标题行高",
      "default": 120
    },
    {
      "type": "range",
      "id": "desktop_description_size",
