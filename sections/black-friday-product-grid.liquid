{{ 'black-friday-product-grid.css' | asset_url | stylesheet_tag }}
{{ 'black-friday-promo-heading.css' | asset_url | stylesheet_tag }}
<script src="{{ 'black-friday-gift-sets.js' | asset_url }}" defer="defer"></script>

<black-friday-gift-sets
  id="BlackFridayProductGrid-{{ section.id }}"
  class="black-friday-product-grid"
  {% if section.settings.navigation_anchor != blank %}data-navigation-anchor="{{ section.settings.navigation_anchor | handleize | escape }}"{% endif %}
  data-cart-add-url="{{ routes.cart_add_url | escape }}"
  data-cart-url="{{ routes.cart_url | escape }}"
  data-error-message="{{ 'sections.cart.cart_error' | t | escape }}"
  style="
    --bfpg-background-color: {{ section.settings.background_color }};
    --bfpg-mobile-background-color: {{ section.settings.mobile_background_color }};
    --bfpg-heading-color: {{ section.settings.heading_color }};
    --bfpg-description-color: {{ section.settings.description_color }};
    --bfpg-highlight-color: {{ section.settings.highlight_color }};
    --bfpg-glow-color: {{ section.settings.glow_color }};
    --bfpg-glow-inner-color: {{ section.settings.glow_inner_color }};
    --bfpg-card-background: {{ section.settings.card_background }};
    --bfpg-card-text-color: {{ section.settings.card_text_color }};
    --bfpg-price-color: {{ section.settings.price_color }};
    --bfpg-buy-background: {{ section.settings.buy_background }};
    --bfpg-buy-text: {{ section.settings.buy_text }};
    --bfpg-description-opacity: {{ section.settings.description_opacity | divided_by: 100.0 }};
    --bfpg-desktop-heading-size: {{ section.settings.desktop_heading_size }}px;
    --bfpg-desktop-heading-width: {{ section.settings.desktop_heading_width }}px;
    --bfpg-desktop-description-size: {{ section.settings.desktop_description_size }}px;
    --bfpg-desktop-description-width: {{ section.settings.desktop_description_width }}px;
    --bfpg-desktop-image-width: {{ section.settings.desktop_image_width }}px;
    --bfpg-desktop-image-height: {{ section.settings.desktop_image_height }}px;
    --bfpg-desktop-card-title-size: {{ section.settings.desktop_card_title_size }}px;
    --bfpg-desktop-card-title-line-height: {{ section.settings.desktop_card_title_line_height | divided_by: 100.0 }};
    --bfpg-desktop-price-size: {{ section.settings.desktop_price_size }}px;
    --bfpg-desktop-compare-size: {{ section.settings.desktop_compare_size }}px;
    --bfpg-desktop-heading-line-height: {{ section.settings.desktop_heading_line_height | divided_by: 100.0 }};
    --bfpg-desktop-description-line-height: {{ section.settings.desktop_description_line_height | divided_by: 100.0 }};
    --bfpg-mobile-heading-size: {{ section.settings.mobile_heading_size }}px;
    --bfpg-mobile-heading-width: {{ section.settings.mobile_heading_width }}px;
    --bfpg-mobile-description-size: {{ section.settings.mobile_description_size }}px;
    --bfpg-mobile-description-width: {{ section.settings.mobile_description_width }}px;
    --bfpg-mobile-image-width: {{ section.settings.mobile_image_width }}px;
    --bfpg-mobile-image-height: {{ section.settings.mobile_image_height }}px;
    --bfpg-mobile-card-title-size: {{ section.settings.mobile_card_title_size }}px;
    --bfpg-mobile-card-title-line-height: {{ section.settings.mobile_card_title_line_height | divided_by: 100.0 }};
    --bfpg-mobile-price-size: {{ section.settings.mobile_price_size }}px;
    --bfpg-mobile-compare-size: {{ section.settings.mobile_compare_size }}px;
    --bfpg-mobile-heading-line-height: {{ section.settings.mobile_heading_line_height | divided_by: 100.0 }};
    --bfpg-mobile-description-line-height: {{ section.settings.mobile_description_line_height | divided_by: 100.0 }};
    --bfpg-desktop-image-heading-gap: {{ section.settings.desktop_image_heading_gap }}px;
    --bfpg-desktop-heading-description-gap: {{ section.settings.desktop_heading_description_gap }}px;
    --bfpg-desktop-header-cards-gap: {{ section.settings.desktop_header_cards_gap }}px;
    --bfpg-desktop-card-gap: {{ section.settings.desktop_card_gap }}px;
    --bfpg-desktop-copy-gap: {{ section.settings.desktop_copy_gap }}px;
    --bfpg-mobile-image-heading-gap: {{ section.settings.mobile_image_heading_gap }}px;
    --bfpg-mobile-heading-description-gap: {{ section.settings.mobile_heading_description_gap }}px;
    --bfpg-mobile-header-cards-gap: {{ section.settings.mobile_header_cards_gap }}px;
    --bfpg-mobile-card-gap: {{ section.settings.mobile_card_gap }}px;
    --bfpg-mobile-copy-gap: {{ section.settings.mobile_copy_gap }}px;
    --bfpg-desktop-column-gap: {{ section.settings.desktop_column_gap }}px;
    --bfpg-mobile-column-gap: {{ section.settings.mobile_column_gap }}px;
    --bfpg-desktop-padding-top: {{ section.settings.desktop_padding_top }}px;
    --bfpg-desktop-padding-bottom: {{ section.settings.desktop_padding_bottom }}px;
    --bfpg-mobile-padding-top: {{ section.settings.mobile_padding_top }}px;
    --bfpg-mobile-padding-bottom: {{ section.settings.mobile_padding_bottom }}px;
  "
>
  <div class="black-friday-product-grid__heading black-friday-product-grid__heading--desktop">
    {% render 'black-friday-promo-heading', config: section.settings, full_default_image: true %}
  </div>
  <div class="black-friday-product-grid__heading black-friday-product-grid__heading--mobile">
    {% render 'black-friday-promo-heading', config: section.settings, heading_override: section.settings.mobile_heading, description_override: section.settings.mobile_description %}
  </div>
  <div class="black-friday-product-grid__cards">
    {%- for block in section.blocks -%}
      {%- if block.settings.variant_id != blank or request.design_mode -%}
        {% render 'black-friday-gift-sets-card', block: block, section: section, card_layout: 'grid' %}
      {%- endif -%}
    {%- endfor -%}
  </div>
</black-friday-gift-sets>

{% schema %}
{
  "name": "黑五变体商品网格",
  "tag": "section",
  "class": "black-friday-product-grid-section",
  "disabled_on": {
    "groups": [
      "header",
      "footer"
    ]
  },
  "settings": [
    {
      "type": "header",
      "content": "内容"
    },
    {
      "type": "text",
      "id": "navigation_anchor",
      "label": "导航锚点",
      "info": "与黑五导航的目标锚点填写相同值；每个模块请使用不同锚点。",
      "default": "best-sellers"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "标题",
      "default": "Early Black Friday Deals"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "说明文字",
      "info": "展示文案手动填写；移动端可单独配置说明。不会自动计算促销或修改结账优惠。",
      "default": "<p>Spend Less, Gift More. Buy 2 for 15% off, 3 or more for 20% off, and get a FREE Butterfly Bracelet ($39.99 value)</p><p>with every Leather Smartwatch purchase.</p>"
    },
    {
      "type": "inline_richtext",
      "id": "mobile_heading",
      "label": "移动端标题（留空使用 PC）",
      "default": "Black Friday Gift Sets Are Here!"
    },
    {
      "type": "richtext",
      "id": "mobile_description",
      "label": "移动端说明（留空使用 PC）",
