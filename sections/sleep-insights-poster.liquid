{{ 'sleep-insights-poster.css' | asset_url | stylesheet_tag }}

<div
  id="SleepInsightsPoster-{{ section.id }}"
  class="sleep-insights-poster"
  data-desktop-position="{{ section.settings.desktop_text_position }}"
  data-desktop-text-alignment="{{ section.settings.desktop_text_alignment }}"
  data-mobile-position="{{ section.settings.mobile_text_position }}"
  data-mobile-layout="{{ section.settings.mobile_layout }}"
  data-mobile-text-alignment="{{ section.settings.mobile_text_alignment }}"
  style="--sleep-poster-desktop-copy-width: {{ section.settings.desktop_copy_width }}px; --sleep-poster-desktop-title-size: {{ section.settings.desktop_title_size }}px; --sleep-poster-desktop-body-size: {{ section.settings.desktop_body_size }}px; --sleep-poster-mobile-title-size: {{ section.settings.mobile_title_size }}px; --sleep-poster-mobile-body-size: {{ section.settings.mobile_body_size }}px; --sleep-poster-desktop-title-color: {{ section.settings.desktop_title_color }}; --sleep-poster-desktop-body-color: {{ section.settings.desktop_body_color }}; --sleep-poster-mobile-title-color: {{ section.settings.mobile_title_color }}; --sleep-poster-mobile-body-color: {{ section.settings.mobile_body_color }};"
>
  <div class="sleep-insights-poster__picture">
    {%- if section.settings.desktop_image != blank -%}
      {{
        section.settings.desktop_image
        | image_url: width: 3840
        | image_tag:
          class: 'sleep-insights-poster__image',
          loading: 'lazy',
          widths: '750, 1000, 1440, 1836, 2400, 3000, 3840',
          sizes: '100vw',
          alt: section.settings.title
      }}
    {%- else -%}
      {{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder-svg sleep-insights-poster__image sleep-insights-poster__placeholder' }}
    {%- endif -%}

    {%- if section.settings.mobile_image != blank -%}
      {{
        section.settings.mobile_image
        | image_url: width: 1000
        | image_tag:
          class: 'sleep-insights-poster__image sleep-insights-poster__mobile-image',
          loading: 'lazy',
          widths: '400, 600, 800, 1000',
          sizes: '100vw',
          alt: section.settings.title
      }}
    {%- endif -%}
  </div>

  <div class="sleep-insights-poster__shade" aria-hidden="true"></div>

  {%- if section.settings.title != blank or section.settings.body != blank -%}
    <div class="sleep-insights-poster__content">
      <div class="sleep-insights-poster__copy">
        {%- if section.settings.title != blank -%}
          <h2 class="sleep-insights-poster__title">{{ section.settings.title | escape }}</h2>
        {%- endif -%}

        {%- if section.settings.body != blank -%}
          <div class="sleep-insights-poster__body rte">{{ section.settings.body }}</div>
        {%- endif -%}
      </div>
    </div>
  {%- endif -%}
</div>

{% schema %}
{
  "name": "睡眠数据海报",
  "tag": "section",
  "class": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "image_picker",
      "id": "desktop_image",
      "label": "桌面端背景图片",
      "info": "建议比例 1920:1700；未设置时使用 Shopify 默认占位图"
    },
    {
      "type": "image_picker",
      "id": "mobile_image",
      "label": "移动端背景图片",
      "info": "建议比例 393:472；未设置时使用桌面端图片"
    },
    {
      "type": "header",
      "content": "文案"
    },
    {
      "type": "text",
      "id": "title",
      "label": "标题",
      "default": "Better Sleep Better You"
    },
    {
      "type": "richtext",
      "id": "body",
      "label": "正文",
      "default": "<p>The FANY smartwatch tracks key sleep metrics including heart rate, HRV, breathing, blood oxygen and movements to generate your personalized report. Every morning, instantly check your sleep score, sleep stages (deep/light/REM), sleep timing (fall asleep/wake time), plus tailored insights and improvement tips</p>"
    },
    {
      "type": "header",
      "content": "桌面端文案样式"
    },
    {
      "type": "select",
      "id": "desktop_text_position",
      "label": "文本位置",
      "options": [
        { "value": "top-left", "label": "左上" },
        { "value": "center-left", "label": "左中" },
        { "value": "bottom-left", "label": "左下" },
        { "value": "top-center", "label": "顶部居中" },
        { "value": "center-center", "label": "正中" },
        { "value": "bottom-center", "label": "底部居中" },
        { "value": "top-right", "label": "右上" },
        { "value": "center-right", "label": "右中" },
        { "value": "bottom-right", "label": "右下" }
      ],
      "default": "top-left"
    },
    {
      "type": "select",
      "id": "desktop_text_alignment",
      "label": "文本对齐方式",
      "options": [
        { "value": "left", "label": "左对齐" },
        { "value": "center", "label": "居中" },
        { "value": "right", "label": "右对齐" }
      ],
      "default": "left"
    },
    {
      "type": "range",
      "id": "desktop_copy_width",
      "min": 200,
      "max": 800,
      "step": 10,
      "unit": "px",
      "label": "文本内容宽度",
      "default": 340
    },
    {
      "type": "range",
      "id": "desktop_title_size",
      "min": 16,
      "max": 72,
      "step": 1,
      "unit": "px",
      "label": "标题字号",
      "default": 40
    },
    {
      "type": "range",
      "id": "desktop_body_size",
      "min": 12,
      "max": 36,
      "step": 1,
      "unit": "px",
      "label": "正文字号",
      "default": 20
    },
    {
      "type": "color",
      "id": "desktop_title_color",
      "label": "标题颜色",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "desktop_body_color",
      "label": "正文颜色",
      "default": "#ffffff"
    },
    {
      "type": "header",
      "content": "移动端文案样式"
    },
    {
      "type": "select",
      "id": "mobile_layout",
      "label": "文字与图片关系",
      "options": [
        { "value": "overlay", "label": "悬浮在图片上" },
        { "value": "above", "label": "排在图片上方" },
        { "value": "below", "label": "排在图片下方" }
      ],
      "default": "overlay"
    },
    {
      "type": "select",
      "id": "mobile_text_position",
      "label": "文本位置",
      "options": [
        { "value": "top-left", "label": "左上" },
        { "value": "center-left", "label": "左中" },
        { "value": "bottom-left", "label": "左下" },
        { "value": "top-center", "label": "顶部居中" },
        { "value": "center-center", "label": "正中" },
        { "value": "bottom-center", "label": "底部居中" },
        { "value": "top-right", "label": "右上" },
        { "value": "center-right", "label": "右中" },
        { "value": "bottom-right", "label": "右下" }
      ],
      "default": "top-left"
    },
    {
      "type": "range",
      "id": "mobile_title_size",
      "min": 16,
      "max": 48,
      "step": 1,
      "unit": "px",
      "label": "标题字号",
      "default": 28
    },
    {
      "type": "range",
      "id": "mobile_body_size",
      "min": 12,
      "max": 28,
      "step": 1,
      "unit": "px",
      "label": "正文字号",
      "default": 16
    },
    {
      "type": "color",
      "id": "mobile_title_color",
      "label": "标题颜色",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "mobile_body_color",
      "label": "正文颜色",
      "default": "#ffffff"
    },
    {
      "type": "select",
      "id": "mobile_text_alignment",
      "label": "文本对齐方式",
      "options": [
        { "value": "left", "label": "左对齐" },
        { "value": "center", "label": "居中" },
        { "value": "right", "label": "右对齐" }
      ],
      "default": "left"
    }
  ],
  "presets": [
    {
      "name": "睡眠数据海报"
    }
  ]
}
{% endschema %}
