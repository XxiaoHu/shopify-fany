{{ 'section-multicolumn.css' | asset_url | stylesheet_tag }}
{{ 'component-slider.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .multicolumn-card {
    display: flex;
    flex-direction: column;
    height: 100%;
  }

  .multicolumn-card__info {
    flex-grow: 1;
  }

  /* multicolumn-list_only_image 相关的样式是针对纯图多列的-tw */
  .multicolumn-list_only_image li:nth-child(odd) {
    text-align: right;
  }

  .multicolumn-list_only_image .media{
    display: inline-block;
  }

  .multicolumn-list_only_image h3{
    color: #fff;
    position: absolute;
    bottom: 30px;
    left: 0;
    width: 100%;
    text-align: center;
  }

  @media screen and (min-width: 1422px){
    .multicolumn-list_only_image .multicolumn-card__imag{

    }
  }
  @media screen and (max-width: 989px) {
    .multicolumn-list_only_image li {
      text-align: center !important;;
    }
  }

  @media screen and (min-width: 750px) {
    .multicolumn-list_only_image{
      --grid-desktop-horizontal-spacing: 30px;
      --grid-desktop-vertical-spacing: 30px;
    }
  }
  .multicolumn-list_only_image{
    line-height: 0;
  }
  .multicolumn-list_only_image li .multicolumn-card__image {
    position: inherit !important;
    display: inline-block !important;
    /* height: revert-layer !important; */
  }
  .multicolumn-list_only_image .multicolumn-card__image-wrapper{
    margin: 0;
  }

  .section-{{ section.id }}-padding .title_info {
    padding-top: 2rem;
    color: #686766;
    font-size: {{ section.settings.text_font_size }}px;
  }

  .section-{{ section.id }}-padding .multicolumn__title {
    text-align: {{ section.settings.title_alignment }};
  }

  .section-{{ section.id }}-padding  .multicolumn-card__info .title {
    color: rgba(var(--color-foreground));
    font-size: {{ section.settings.column_title_size }}px !important;
  }

  .section-{{ section.id }}-padding  .multicolumn-card__info .sub-title {
    color: rgba(var(--color-foreground));
    font-size: {{ section.settings.column_subtitle_size }}px !important;
  }

  .section-{{ section.id }}-padding  .multicolumn-card__info .multicolumn-card__text {
    --color-foreground: 104, 103, 102;
    color: rgba(var(--color-foreground));
    font-size: {{ section.settings.column_text_size }}px !important;
  }

  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }

  .section-{{ section.id }}-padding {
    max-width: none;
    width: 100%;
    padding-top: 120px;
    padding-bottom: 120px;
    padding-left: 200px;
    padding-right: 200px;
  }

  .section-{{ section.id }}-padding .multicolumn__title {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 20px;
    width: 100%;
    margin-bottom: 40px;
    text-align: center;
  }

  .section-{{ section.id }}-padding .multicolumn__title .title {
    font-family: Lato, sans-serif;
    font-size: 28px;
    font-weight: 700;
    line-height: 1.2;
    letter-spacing: 0;
    color: #1e0e06;
    text-align: center;
  }

  .section-{{ section.id }}-padding .title_info {
    padding-top: 0;
    font-family: Lato, sans-serif;
    font-size: 16px;
    font-weight: 400;
    line-height: 1.5;
    letter-spacing: 0;
    color: #686766;
    text-align: center;
  }

  .section-{{ section.id }}-padding .multicolumn-list {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 16px;
    width: 100%;
  }

  .section-{{ section.id }}-padding .multicolumn-list__item {
    width: 100%;
    max-width: none;
    padding-bottom: 0;
  }

  .section-{{ section.id }}-padding .multicolumn-card {
    min-height: 245px;
    align-items: center;
    justify-content: center;
    gap: 10px;
    padding: 10px 20px;
    border-radius: 4px;
    background: #f5f5f5;
  }

  .section-{{ section.id }}-padding .multicolumn-card__image-wrapper {
    width: 60px;
    height: 60px;
    margin: 0;
    padding: 0;
    flex: 0 0 60px;
  }

  .section-{{ section.id }}-padding .multicolumn-card__image-wrapper .media {
    width: 60px;
    height: 60px;
    padding-bottom: 0 !important;
    background: transparent;
  }

  .section-{{ section.id }}-padding .multicolumn-card__image {
    position: static;
    width: 60px;
    height: 60px;
    object-fit: contain;
  }

  .section-{{ section.id }}-padding .multicolumn-card__info {
    display: flex;
    flex: 0 1 auto;
    flex-direction: column;
    align-items: center;
    gap: 10px;
    width: 100%;
    padding: 0;
    text-align: center;
  }

  .section-{{ section.id }}-padding .multicolumn-card__info > :nth-child(2) {
    margin-top: 0;
  }

  .section-{{ section.id }}-padding .multicolumn-card__info .title {
    width: 100%;
    font-family: Lato, sans-serif;
    font-size: 16px !important;
    font-weight: 400;
    line-height: 1.5;
    letter-spacing: 0;
    color: #1e0e06;
    text-align: center;
  }

  .section-{{ section.id }}-padding .multicolumn-card__info .sub-title,
  .section-{{ section.id }}-padding .multicolumn-card__info .multicolumn-card__text {
    width: 100%;
    font-family: Lato, sans-serif;
    font-size: 14px !important;
    font-weight: 300;
    line-height: 1.5;
    letter-spacing: 0;
    color: #686766;
    text-align: center;
  }

  .section-{{ section.id }}-padding .multicolumn-card__info .sub-title p,
  .section-{{ section.id }}-padding .multicolumn-card__info .multicolumn-card__text p {
    margin: 0;
  }

  @media screen and (max-width: 768px) {
    .section-{{ section.id }}-padding {
      padding-top: 40px;
      padding-bottom: 40px;
      padding-left: 16px;
      padding-right: 16px;
    }

    .section-{{ section.id }}-padding .multicolumn__title {
      gap: 20px;
      margin-bottom: 20px;
      text-align: center;
    }

    .section-{{ section.id }}-padding .multicolumn__title .title {
      width: 267px;
      max-width: 100%;
      font-size: 24px;
      font-weight: 700;
      line-height: 1.2;
      letter-spacing: 0;
      color: #1e0e06;
      text-align: center;
    }

    .section-{{ section.id }}-padding .title_info {
      padding-top: 0;
      width: 100%;
      font-size: 16px;
      font-weight: 400;
      line-height: 1.5;
      letter-spacing: 0;
      color: #686766;
      text-align: center;
    }

    .section-{{ section.id }}-padding  .multicolumn-card__info .title {
      color: #1e0e06;
      font-size: 12px !important;
    }

    .section-{{ section.id }}-padding  .multicolumn-card__info .sub-title {
      color: #686766;
      font-size: 10px !important;
    }

    .section-{{ section.id }}-padding  .multicolumn-card__info .multicolumn-card__text {
      color: #686766;
      font-size: 10px !important;
    }

    .section-{{ section.id }}-padding .multicolumn-list {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 10px;
    }

    .section-{{ section.id }}-padding .multicolumn-card {
      aspect-ratio: 1 / 1;
      min-height: 0;
      gap: 10px;
      padding: 0 24px;
      background: #f5f5f5;
    }

    .section-{{ section.id }}-padding .multicolumn-card__image-wrapper {
      width: 40px;
      height: 40px;
      flex-basis: 40px;
    }

    .section-{{ section.id }}-padding .multicolumn-card__image-wrapper .media {
      width: 40px;
      height: 40px;
    }

    .section-{{ section.id }}-padding .multicolumn-card__image {
      width: 40px;
      height: 40px;
    }

    .section-{{ section.id }}-padding .multicolumn-card__info {
      gap: 10px;
    }

    .section-{{ section.id }}-padding .multicolumn-card__info .title {
      width: 128px;
      max-width: 100%;
      min-height: 30px;
      font-weight: 400;
      line-height: 15px;
      letter-spacing: 0;
      text-align: center;
    }

    .section-{{ section.id }}-padding .multicolumn-card__info .sub-title,
    .section-{{ section.id }}-padding .multicolumn-card__info .multicolumn-card__text {
      width: 128px;
      max-width: 100%;
      font-weight: 400;
      line-height: 1.5;
      letter-spacing: 0;
      text-align: center;
    }
  }
{%- endstyle -%}

{%- liquid
  assign columns_mobile_int = section.settings.columns_mobile | plus: 0
  assign show_mobile_slider = false
  if section.settings.swipe_on_mobile and section.blocks.size > columns_mobile_int
    assign show_mobile_slider = true
  endif
-%}

<div class="multicolumn color-{{ section.settings.section_color_scheme }} gradient{% unless section.settings.background_style == 'none' and settings.text_boxes_border_thickness > 0 or settings.text_boxes_shadow_opacity > 0 %} background-{{ section.settings.background_style }} hover-background-{{ section.settings.hover_background_style }}{% endunless %}{% if section.settings.title == blank %} no-heading{% endif %}">
  <div
    class="page-width section-{{ section.id }}-padding isolate{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}"
    {% if settings.animations_reveal_on_scroll %}
      data-cascade
    {% endif %}
  >
    {%- unless section.settings.title == blank -%}
      <div class="title-wrapper-with-link title-wrapper--self-padded-mobile title-wrapper--no-top-margin multicolumn__title">
        <h2 class="title inline-richtext {{ section.settings.heading_size }}">
          {{ section.settings.title }}
        </h2>
        {%- if section.settings.button_label != blank and show_mobile_slider -%}
          <a href="{{ section.settings.button_link }}" class="link underlined-link large-up-hide">
            {{- section.settings.button_label | escape -}}
          </a>
        {%- endif -%}

        {%- unless section.settings.title == blank -%}
          <div class="title_info">{{ section.settings.text }}</div>
        {%- endunless -%}
      </div>
    {%- endunless -%}
    <slider-component class="slider-mobile-gutter color-{{ section.settings.color_scheme }}">
      <ul
        class="multicolumn-list contains-content-container grid grid--{{ section.settings.columns_mobile }}-col-tablet-down grid--{{ section.settings.columns_desktop }}-col-desktop{% if show_mobile_slider %} slider slider--tablet grid--peek{% endif %}{% if section.settings.only_image %} multicolumn-list_only_image {% endif %}"
        id="Slider-{{ section.id }}"
        role="list"
      >
        {%- liquid
          assign highest_ratio = 0
          for block in section.blocks
            if block.settings.image.aspect_ratio > highest_ratio
              assign highest_ratio = block.settings.image.aspect_ratio
            endif
          endfor
        -%}
        {%- for block in section.blocks -%}
          {%- assign empty_column = '' -%}
          {%- if block.settings.image == blank
            and block.settings.title == blank
            and block.settings.text == blank
            and block.settings.link_label == blank
          -%}
            {%- assign empty_column = ' multicolumn-list__item--empty' -%}
          {%- endif -%}
          <li
            id="Slide-{{ section.id }}-{{ forloop.index }}"
            class="multicolumn-list__item grid__item{% if section.settings.swipe_on_mobile %} slider__slide{% endif %}{% if section.settings.column_alignment == 'center' %} center{% endif %}{{ empty_column }}{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}"
            {{ block.shopify_attributes }}
            {% if settings.animations_reveal_on_scroll %}
              data-cascade
              style="--animation-order: {{ forloop.index }};"
            {% endif %}
          >
            <div class="multicolumn-card content-container">
              {%- if block.settings.image != blank -%}
                {% if section.settings.image_ratio == 'adapt' or section.settings.image_ratio == 'circle' %}
                  {% assign spaced_image = true %}
                {% endif %}

                {% if section.settings.only_image and block.settings.link != blank -%}
                  <a href="{{ block.settings.link }}" class="full-unstyled-link">
                {%- endif -%}
                <div class="multicolumn-card__image-wrapper multicolumn-card__image-wrapper--{{ section.settings.image_width }}-width{% if section.settings.image_width != 'full' or spaced_image %} multicolumn-card-spacing{% endif %}">
                  <div
                    class="media media--transparent media--{{ section.settings.image_ratio }}"
                    {% if section.settings.image_ratio == 'adapt' and section.settings.only_image != true %}
                      style="padding-bottom: {{ 1 | divided_by: highest_ratio | times: 100 }}%;"
                    {% endif %}
                  >
                    {%- liquid
                      assign number_of_columns = section.settings.columns_desktop
                      assign number_of_columns_mobile = section.settings.columns_mobile
                      assign grid_space_desktop = number_of_columns | minus: 1 | times: settings.spacing_grid_horizontal | plus: 100 | append: 'px'
                      assign grid_space_tablet = number_of_columns_mobile | minus: 1 | times: settings.spacing_grid_horizontal | plus: 100 | append: 'px'
                      assign grid_space_mobile = number_of_columns_mobile | minus: 1 | times: settings.spacing_grid_horizontal | divided_by: 2 | plus: 30 | append: 'px'
                      assign width = 3200
                      if section.settings.only_image
                        assign width = block.settings.image.width
                      endif
                      if section.settings.image_width == 'auto'
                        assign width = block.settings.image.width
                        assign image_width = 1
                      elsif section.settings.image_width == 'half'
                        assign image_width = 0.5
                      elsif section.settings.image_width == 'third'
                        assign image_width = 0.33
                      else
                        assign image_width = 1
                      endif
                    -%}
                    {% if section.settings.image_width != 'auto' %}
                      {% capture sizes %}
                      (min-width: {{ settings.page_width }}px) calc(({{ settings.page_width }}px - {{ grid_space_desktop }}) * {{ image_width }} /  {{ number_of_columns }}),
                      (min-width: 990px) calc((100vw - {{ grid_space_desktop }}) * {{ image_width }} / {{ number_of_columns }}),
                      (min-width: 750px) calc((100vw - {{ grid_space_tablet }}) * {{ image_width }} / {{ number_of_columns_mobile }}),
                      calc((100vw - {{ grid_space_mobile }}) * {{ image_width }} / {{ number_of_columns_mobile }})
                      {% endcapture %}
                    {% endif %}
                    {{
                      block.settings.image
                      | image_url: width: width
                      | image_tag:
                        loading: 'lazy',
                        widths: '50, 75, 100, 150, 200, 300, 400, 500, 750, 1000, 1250, 1500, 1750, 2000, 2250, 2500, 2750, 3000, 3200',
                        sizes: sizes,
                        class: 'multicolumn-card__image'
                    }}
                    {%- if block.settings.title != blank and section.settings.only_image -%}
                      <h3 class="inline-richtext">{{ block.settings.title }}</h3>
                    {%- endif -%}
                  </div>
                  {% if section.settings.only_image and block.settings.link != blank %}</a>{%- endif -%}
                </div>
              {%- endif -%}
              {% unless section.settings.only_image %}
                <div class="multicolumn-card__info">
                  {%- if block.settings.title != blank -%}
                    <div class="title">{{ block.settings.title }}</div>
                  {%- endif -%}
                  {%- if block.settings.subtitle != blank -%}
                    <div class="sub-title rte">{{ block.settings.subtitle }}</div>
                  {%- endif -%}
                  {%- if block.settings.hr -%}
                    <hr class="multicolumn-card__hr{% if section.settings.column_alignment == 'center' %} hr-center{% endif %}">
                  {%- endif -%}
                  {%- if block.settings.text != blank -%}
                    <div class="multicolumn-card__text rte">{{ block.settings.text }}</div>
                  {%- endif -%}
                  {%- if block.settings.link_label != blank -%}
                    <a
                      class="link animate-arrow"
                      {% if block.settings.link == blank %}
                        role="link" aria-disabled="true"
                      {% else %}
                        href="{{ block.settings.link }}"
                      {% endif %}
                    >
                      {{- block.settings.link_label | escape -}}
                      <span class="svg-wrapper"
                        ><span class="icon-wrap">&nbsp;{{ 'icon-arrow.svg' | inline_asset_content }}</span></span
                      >
                    </a>
                  {%- endif -%}
                </div>
              {% endunless %}
            </div>
          </li>
        {%- endfor -%}
      </ul>

      {%- if show_mobile_slider -%}
        <div class="slider-buttons large-up-hide">
          <button
            type="button"
            class="slider-button slider-button--prev"
            name="previous"
            aria-label="{{ 'general.slider.previous_slide' | t }}"
          >
            <span class="svg-wrapper">{{ 'icon-caret.svg' | inline_asset_content }}</span>
          </button>
          <div class="slider-counter caption">
            <span class="slider-counter--current">1</span>
            <span aria-hidden="true"> / </span>
            <span class="visually-hidden">{{ 'general.slider.of' | t }}</span>
            <span class="slider-counter--total">{{ section.blocks.size }}</span>
          </div>
          <button
            type="button"
            class="slider-button slider-button--next"
            name="next"
            aria-label="{{ 'general.slider.next_slide' | t }}"
          >
            <span class="svg-wrapper">{{ 'icon-caret.svg' | inline_asset_content }}</span>
          </button>
        </div>
      {%- endif -%}
    </slider-component>
    <div class="center{% if show_mobile_slider %} small-hide medium-hide{% endif %}">
      {%- if section.settings.button_label != blank -%}
        <a
          class="button button--primary"
          {% if section.settings.button_link == blank %}
            role="link" aria-disabled="true"
          {% else %}
            href="{{ section.settings.button_link }}"
          {% endif %}
        >
          {{ section.settings.button_label | escape }}
        </a>
      {%- endif -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "t:sections.multicolumn.name",
  "class": "section",
  "tag": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "checkbox",
      "id": "only_image",
      "label": "only_image",
      "default": false
    },
    {
      "type": "inline_richtext",
      "id": "title",
      "default": "Quality Without Compromise",
      "label": "t:sections.multicolumn.settings.title.label"
    },
    {
      "type": "select",
      "id": "heading_size",
      "options": [
        {
          "value": "h1",
          "label": "H1"
        },
        {
          "value": "h2",
          "label": "H2"
        },
        {
          "value": "h3",
          "label": "H3"
        },
        {
          "value": "h4",
          "label": "H4"
        },
        {
          "value": "h5",
          "label": "H5"
        },
        {
          "value": "h6",
          "label": "H6"
        },
        {
          "value": "f-18",
          "label": "大小18"
        },
        {
          "value": "f-20",
          "label": "大小20"
        },
        {
          "value": "f-22",
          "label": "大小22"
        },
        {
          "value": "f-24",
          "label": "大小24"
        },
        {
          "value": "f-28",
          "label": "大小28"
        },
        {
          "value": "f-36",
          "label": "大小36"
        }
      ],
      "default": "h1",
      "label": "t:sections.all.heading_size.label"
    },
    {
      "type": "inline_richtext",
      "id": "text",
      "label": "描述",
      "default": "Your satisfaction is our greatest honor."
    },
    {
      "type": "range",
      "id": "text_font_size",
      "min": 10,
      "max": 56,
      "step": 1,
      "unit": "px",
      "label": "字体大小",
      "default": 20
    },
    {
      "type": "header",
      "content": "t:sections.multicolumn.settings.header_image.content"
    },
    {
      "type": "select",
      "id": "image_width",
      "options": [
        {
          "value": "third",
          "label": "t:sections.multicolumn.settings.image_width.options__1.label"
        },
        {
          "value": "half",
          "label": "t:sections.multicolumn.settings.image_width.options__2.label"
        },
        {
          "value": "full",
          "label": "t:sections.multicolumn.settings.image_width.options__3.label"
        },
        {
          "value": "auto",
          "label": "适应图片"
        }
      ],
      "default": "full",
      "label": "t:sections.multicolumn.settings.image_width.label"
    },
    {
      "type": "select",
      "id": "image_ratio",
      "options": [
        {
          "value": "adapt",
          "label": "t:sections.multicolumn.settings.image_ratio.options__1.label"
        },
        {
          "value": "portrait",
          "label": "t:sections.multicolumn.settings.image_ratio.options__2.label"
        },
        {
          "value": "square",
          "label": "t:sections.multicolumn.settings.image_ratio.options__3.label"
        },
        {
          "value": "circle",
          "label": "t:sections.multicolumn.settings.image_ratio.options__4.label"
        }
      ],
      "default": "adapt",
      "label": "t:sections.multicolumn.settings.image_ratio.label"
    },
    {
      "type": "header",
      "content": "t:sections.multicolumn.settings.header_button.content"
    },
    {
      "type": "text",
      "id": "button_label",
      "default": "t:sections.multicolumn.settings.button_label.default",
      "label": "t:sections.multicolumn.settings.button_label.label",
      "info": "t:sections.multicolumn.settings.button_label.info"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "t:sections.multicolumn.settings.button_link.label"
    },
    {
      "type": "header",
      "content": "t:sections.multicolumn.settings.header_layout.content"
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "min": 1,
      "max": 6,
      "step": 1,
      "default": 4,
      "label": "t:sections.multicolumn.settings.columns_desktop.label"
    },
    {
      "type": "select",
      "id": "title_alignment",
      "options": [
        {
          "value": "left",
          "label": "t:sections.multicolumn.settings.column_alignment.options__1.label"
        },
        {
          "value": "center",
          "label": "t:sections.multicolumn.settings.column_alignment.options__2.label"
        }
      ],
      "default": "center",
      "label": "标题对齐方式"
    },
    {
      "type": "select",
      "id": "column_alignment",
      "options": [
        {
          "value": "left",
          "label": "t:sections.multicolumn.settings.column_alignment.options__1.label"
        },
        {
          "value": "center",
          "label": "t:sections.multicolumn.settings.column_alignment.options__2.label"
        }
      ],
      "default": "left",
      "label": "t:sections.multicolumn.settings.column_alignment.label"
    },
    {
      "type": "select",
      "id": "background_style",
      "options": [
        {
          "value": "none",
          "label": "t:sections.multicolumn.settings.background_style.options__1.label"
        },
        {
          "value": "primary",
          "label": "t:sections.multicolumn.settings.background_style.options__2.label"
