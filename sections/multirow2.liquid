{{ 'component-image-with-text.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .section-{{ section.id }}-padding .multirow__inner {
    position: relative;
    --grid-desktop-vertical-spacing: {{ section.settings.row_gap }}px;
    --grid-mobile-vertical-spacing: {{ section.settings.mobile_row_gap }}px;
  }

  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top}}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }

  {%- if section.settings.image != blank -%}
  .section-{{ section.id }}-padding .background-image {
    display: none;
  }
  @media screen and (min-width: 769px) {
    .section-{{ section.id }}-padding .background-image {
      display: block;
      width: 100%;
      height: 100%;
      background-image: url("{{section.settings.image | image_url: width: section.settings.image.width}}");
      background-size: cover;
      background-position: center;
      background-attachment: local;
      background-repeat: no-repeat;
      position: absolute;
      z-index: 2;
      pointer-events: none;
      top: 0px;
      left: 0px;
    }
  }
  {%- endif -%}
  
  @media screen and (max-width: 749px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.mobile_padding_top }}px;
      padding-bottom: {{ section.settings.mobile_padding_bottom }}px;
    }
  }
{%- endstyle -%}

{%- liquid
  if section.settings.row_color_scheme == section.settings.section_color_scheme
    assign no_content_background = true
  endif

  if settings.text_boxes_shadow_opacity == 0 and settings.text_boxes_border_thickness == 0 or settings.text_boxes_border_opacity == 0
    assign no_content_styles = true
  endif

  if settings.text_boxes_border_thickness > 0 and settings.text_boxes_border_opacity > 0 and settings.media_border_thickness > 0 and settings.media_border_opacity > 0
    assign borders_class = ' collapse-borders'
  endif

  if no_content_background and no_content_styles
    assign padding_class = ' collapse-padding'
  endif

  unless no_content_background and no_content_styles
    assign corners_class = ' collapse-corners'
  endunless
-%}

<div class="multirow section-{{ section.id }}-padding gradient color-{{ section.settings.section_color_scheme }}">
  <div class="multirow__inner page-width">
    {%- if section.settings.image != blank -%}
      <div class="background-image"></div>
    {%- endif  -%}
    {%- for block in section.blocks -%}
      {%- style -%}
        {%- if block.settings.background != blank -%}
        #item-{{ section.id }}-{{ forloop.index }} .image-with-text__text-item {
          background-image: url("{{block.settings.background | image_url: width: block.settings.background.width}}");
          background-size: cover;
          background-position: center;
          background-attachment: local;
          background-repeat: no-repeat;
        }
        {%- endif -%}

        @media screen and (min-width:750px) {
          #item-{{ section.id }}-{{ forloop.index }} .image-with-text__content.has-quote:not(.image-with-text__content--desktop-center) > :not(.image-with-text__heading,.image-with-text__sub-heading) {
            margin-left: calc(20px + max({{ block.settings.heading_font_size }}px, {{ block.settings.sub_heading_font_size }}px));
          }

          #item-{{ section.id }}-{{ forloop.index }} .image-with-text__grid--desktop-right {
            flex-direction: row-reverse;
          }
        }

        #item-{{ section.id }}-{{ forloop.index }} .image-with-text__text--caption {
          font-size: {{ block.settings.caption_font_size }}px;
          color: {{ block.settings.caption_color }};
          text-transform: none;
        }

        #item-{{ section.id }}-{{ forloop.index }} .image-with-text__heading svg,
        #item-{{ section.id }}-{{ forloop.index }} .image-with-text__sub-heading svg {
          width: max({{ block.settings.heading_font_size }}px, {{ block.settings.sub_heading_font_size }}px);
          height: max({{ block.settings.heading_font_size }}px, {{ block.settings.sub_heading_font_size }}px);
        }

        #item-{{ section.id }}-{{ forloop.index }} .image-with-text__heading {
          display: grid;
          grid-template-columns: 1fr auto;
          column-gap: 2rem;
          font-size: {{ block.settings.heading_font_size }}px;
          align-items: center;
        }

        #item-{{ section.id }}-{{ forloop.index }} .image-with-text__sub-heading {
          display: grid;
          grid-template-columns: 1fr auto 1fr;
          column-gap: 2rem;
          font-size: {{ block.settings.sub_heading_font_size }}px;
          align-items: center;
        }

        #item-{{ section.id }}-{{ forloop.index }} .image-with-text__text-item .image-with-text__media-item {
          display: none;
        }

        @media screen and (max-width:749px) {
          #item-{{ section.id }}-{{ forloop.index }} .image-with-text__heading,
          #item-{{ section.id }}-{{ forloop.index }} .image-with-text__sub-heading {
            column-gap: 1rem;
          }

          #item-{{ section.id }}-{{ forloop.index }} .image-with-text__content.has-quote:not(.image-with-text__content--mobile-center) > :not(.image-with-text__heading,.image-with-text__sub-heading) {
            margin-left: calc(10px + max({{ block.settings.mobile_heading_font_size }}px, {{ block.settings.mobile_sub_heading_font_size }}px));
          }

          #item-{{ section.id }}-{{ forloop.index }} .image-with-text__text--caption {
            font-size: {{ block.settings.mobile_caption_font_size }}px;
            color: {{ block.settings.mobile_caption_color }};
          }

          #item-{{ section.id }}-{{ forloop.index }} .image-with-text__heading svg,
          #item-{{ section.id }}-{{ forloop.index }} .image-with-text__sub-heading svg {
            width: max({{ block.settings.mobile_heading_font_size }}px, {{ block.settings.mobile_sub_heading_font_size }}px);
            height: max({{ block.settings.mobile_heading_font_size }}px, {{ block.settings.mobile_sub_heading_font_size }}px);
          }

          #item-{{ section.id }}-{{ forloop.index }} .image-with-text__heading {
            font-size: {{ block.settings.mobile_heading_font_size }}px;
          }

          #item-{{ section.id }}-{{ forloop.index }} .image-with-text__sub-heading {
            font-size: {{ block.settings.mobile_sub_heading_font_size }}px;
          }

          #item-{{ section.id }}-{{ forloop.index }} .image-with-text__grid--mobile-bottom {
            flex-direction: column-reverse;
          }

          #item-{{ section.id }}-{{ forloop.index }} .image-with-text__grid--mobile-center .image-with-text__text-item .image-with-text__media-item {
            display: block;
          }

          #item-{{ section.id }}-{{ forloop.index }} .image-with-text__grid--mobile-center > .image-with-text__media-item {
            display: none;
          }
        }
      {%- endstyle -%}

      <div
        id="item-{{ section.id }}-{{ forloop.index }}"
        class="image-with-text isolate{{ borders_class }}{{ corners_class }}{{ padding_class }}{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}"
        {{ block.shopify_attributes }}
      >
        <div class="image-with-text__grid grid grid--gapless grid--1-col grid--{% if block.settings.desktop_image_width == 'medium' %}2-col-tablet{% else %}3-col-tablet{% endif %} image-with-text__grid--desktop-{{ block.settings.image_layout }} image-with-text__grid--mobile-{{ block.settings.mobile_image_layout }}">
          <div class="image-with-text__media-item image-with-text__media-item--{{ block.settings.desktop_image_width }} grid__item">
            <picture
              class="image-with-text__media image-with-text__media--{{ block.settings.image_height }} global-media-settings{% if block.settings.image != blank %} media{% else %} image-with-text__media--placeholder placeholder{% endif %}"
              {% if block.settings.image_height == 'adapt' and block.settings.image != blank %}
                style="padding-bottom: {{ 1 | divided_by: block.settings.image.aspect_ratio | times: 100 }}%;"
              {% endif %}
            >
              {%- if block.settings.mobile_image != blank -%}
                <source media="(max-width: 749px)" srcset="{{ block.settings.mobile_image | image_url: width: 749 }}">
              {%- endif -%}
              {%- if block.settings.image != blank -%}
                {%- capture sizes -%}
                  (min-width: {{ settings.page_width }}px) {{ settings.page_width | minus: 100 | divided_by: 2 }}px,
                  (min-width: 750px) calc((100vw - 130px) / 2), calc((100vw - 50px) / 2)
                {%- endcapture -%}
                {{
                  block.settings.image
                  | image_url: width: 1500
                  | image_tag: sizes: sizes, loading: 'lazy', widths: '165, 360, 535, 750, 1070, 1500'
                }}
              {%- else -%}
                {{ 'detailed-apparel-1' | placeholder_svg_tag: 'placeholder-svg' }}
              {%- endif -%}
            </picture>
          </div>
          <div class="image-with-text__text-item grid__item gradient color-{{ section.settings.row_color_scheme }}">
            <div class="image-with-text__content{% if block.settings.quote %} has-quote{% endif %} image-with-text__content--{{ block.settings.desktop_content_position }} image-with-text__content--desktop-{{ block.settings.desktop_content_alignment }} image-with-text__content--mobile-{{ block.settings.mobile_content_alignment }} content-container">
              {%- if block.settings.caption -%}
                <p class="image-with-text__text--caption">
                  {{ block.settings.caption | escape }}
                </p>
              {%- endif -%}
              {%- if block.settings.heading != blank -%}
                <div class="image-with-text__heading rte">
                  {%- if block.settings.quote -%}
                    <svg xmlns="http://www.w3.org/2000/svg" width="50" height="50" viewBox="0 0 50 50" fill="none">
                      <path d="M41.9667 39.6694H27.6752V29.3628C27.6752 25.1592 28.0399 21.8574 28.7692 19.4672C29.4986 17.0737 30.2577 15.4758 32.2401 13.563C34.2226 11.6501 35.5984 11.0733 38.5123 10.3274L40.5478 14.7034C38.5123 15.4791 37.2758 15.8272 35.363 17.8096C33.4468 19.7887 33.3076 21.7082 33.3076 23.3558H41.9667V39.6694ZM22.3081 39.6694H8.01997V29.3628C8.01997 25.1592 8.38463 21.8574 9.11395 19.4672C9.84327 17.0737 10.6024 15.4758 12.5849 13.563C14.5673 11.6468 15.9431 11.07 18.8537 10.3241L20.8892 14.7C18.8537 15.4791 17.6139 15.8239 15.7044 17.8063C13.7916 19.7887 13.6523 21.7082 13.6523 23.3558H22.3114V39.6694H22.3081Z" fill="#B18D82"/>
                    </svg>
                  {%- endif -%}
                  <span>{{ block.settings.heading }}</span>
                  {%- if block.settings.quote and block.settings.sub_heading == blank -%}
                    <svg xmlns="http://www.w3.org/2000/svg" width="50" height="50" viewBox="0 0 50 50" fill="none">
                      <g opacity="0.5">
                      <path d="M8.03333 10.3306L22.3248 10.3306V20.6372C22.3248 24.8408 21.9601 28.1426 21.2308 30.5328C20.5014 32.9263 19.7423 34.5242 17.7599 36.437C15.7774 38.3499 14.4016 38.9267 11.4877 39.6726L9.45219 35.2966C11.4877 34.5209 12.7242 34.1728 14.637 32.1904C16.5532 30.2113 16.6924 28.2918 16.6924 26.6442H8.03333L8.03333 10.3306ZM27.6919 10.3306L41.98 10.3306V20.6372C41.98 24.8408 41.6154 28.1426 40.8861 30.5328C40.1567 32.9263 39.3976 34.5242 37.4151 36.437C35.4327 38.3532 34.0569 38.93 31.1463 39.6759L29.1108 35.3C31.1463 34.5209 32.3861 34.1761 34.2956 32.1937C36.2084 30.2113 36.3477 28.2918 36.3477 26.6442H27.6886L27.6886 10.3306H27.6919Z" fill="#B18D82"/>
                      </g>
                    </svg>
                  {% endif %}
                </div>
              {%- endif -%}
              {%- if block.settings.sub_heading != blank -%}
                <div class="image-with-text__sub-heading rte">
                  <svg
                    xmlns="http://www.w3.org/2000/svg"
                    {% if block.settings.quote and block.settings.heading != blank %}
                      style="visibility: hidden;"
                    {% endif %}
                    width="50"
                    height="50"
                    viewBox="0 0 50 50"
                    fill="none"
                  >
                    <path d="M41.9667 39.6694H27.6752V29.3628C27.6752 25.1592 28.0399 21.8574 28.7692 19.4672C29.4986 17.0737 30.2577 15.4758 32.2401 13.563C34.2226 11.6501 35.5984 11.0733 38.5123 10.3274L40.5478 14.7034C38.5123 15.4791 37.2758 15.8272 35.363 17.8096C33.4468 19.7887 33.3076 21.7082 33.3076 23.3558H41.9667V39.6694ZM22.3081 39.6694H8.01997V29.3628C8.01997 25.1592 8.38463 21.8574 9.11395 19.4672C9.84327 17.0737 10.6024 15.4758 12.5849 13.563C14.5673 11.6468 15.9431 11.07 18.8537 10.3241L20.8892 14.7C18.8537 15.4791 17.6139 15.8239 15.7044 17.8063C13.7916 19.7887 13.6523 21.7082 13.6523 23.3558H22.3114V39.6694H22.3081Z" fill="#B18D82"/>
                  </svg>
                  <span>{{ block.settings.sub_heading }}</span>
                  {%- if block.settings.quote -%}
                    <svg xmlns="http://www.w3.org/2000/svg" width="50" height="50" viewBox="0 0 50 50" fill="none">
                      <g opacity="0.5">
                      <path d="M8.03333 10.3306L22.3248 10.3306V20.6372C22.3248 24.8408 21.9601 28.1426 21.2308 30.5328C20.5014 32.9263 19.7423 34.5242 17.7599 36.437C15.7774 38.3499 14.4016 38.9267 11.4877 39.6726L9.45219 35.2966C11.4877 34.5209 12.7242 34.1728 14.637 32.1904C16.5532 30.2113 16.6924 28.2918 16.6924 26.6442H8.03333L8.03333 10.3306ZM27.6919 10.3306L41.98 10.3306V20.6372C41.98 24.8408 41.6154 28.1426 40.8861 30.5328C40.1567 32.9263 39.3976 34.5242 37.4151 36.437C35.4327 38.3532 34.0569 38.93 31.1463 39.6759L29.1108 35.3C31.1463 34.5209 32.3861 34.1761 34.2956 32.1937C36.2084 30.2113 36.3477 28.2918 36.3477 26.6442H27.6886L27.6886 10.3306H27.6919Z" fill="#B18D82"/>
                      </g>
                    </svg>
                  {%- endif -%}
                </div>
              {%- endif -%}
              {%- if block.settings.hr -%}
                <hr class="image-with-text__hr">
              {%- endif -%}
              <div class="image-with-text__media-item grid__item">
                <picture
                  class="image-with-text__media image-with-text__media--{{ block.settings.image_height }} global-media-settings{% if block.settings.image != blank %} media{% else %} image-with-text__media--placeholder placeholder{% endif %}"
                  {% if block.settings.image_height == 'adapt' and block.settings.image != blank %}
                    style="padding-bottom: {{ 1 | divided_by: block.settings.image.aspect_ratio | times: 100 }}%;"
                  {% endif %}
                >
                  {%- if block.settings.mobile_image != blank -%}
                    <source media="(max-width: 749px)" srcset="{{ block.settings.mobile_image | image_url: width: 749 }}">
                  {%- endif -%}
                  {%- if block.settings.image != blank -%}
                    {%- capture sizes -%}
                      (min-width: {{ settings.page_width }}px) {{ settings.page_width | minus: 100 | divided_by: 2 }}px,
                      (min-width: 750px) calc((100vw - 130px) / 2), calc((100vw - 50px) / 2)
                    {%- endcapture -%}
                    {{
                      block.settings.image
                      | image_url: width: 1500
                      | image_tag: sizes: sizes, loading: 'lazy', widths: '165, 360, 535, 750, 1070, 1500'
                    }}
                  {%- else -%}
                    {{ 'detailed-apparel-1' | placeholder_svg_tag: 'placeholder-svg' }}
                  {%- endif -%}
                </picture>
              </div>
              {%- if block.settings.text -%}
                <div class="image-with-text__text rte">{{ block.settings.text }}</div>
              {%- endif -%}
              {%- if block.settings.button_label != blank -%}
                <a
                  {% if block.settings.button_link == blank %}
                    role="link" aria-disabled="true"
                  {% else %}
                    href="{{ block.settings.button_link }}"
                  {% endif %}
                  class="button button--{{ block.settings.button_style }}"
                >
                  {{ block.settings.button_label | escape }}
                </a>
              {%- endif -%}
            </div>
          </div>
        </div>
      </div>
    {%- endfor -%}
  </div>
</div>

{% schema %}
{
  "name": "多行2",
  "class": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "header",
      "content": "t:sections.multirow.settings.header_3.content"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "背景图"
    },
    {
      "type": "color_scheme",
      "id": "section_color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-1"
    },
    {
      "type": "color_scheme",
      "id": "row_color_scheme",
      "label": "t:sections.multirow.settings.container_color_scheme.label",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 36
    },
    {
      "type": "range",
      "id": "row_gap",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "label": "行距",
      "default": 4
    },
    {
      "type": "header",
      "content": "移动端布局"
    },
    {
      "type": "range",
      "id": "mobile_padding_top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 36
    },
    {
      "type": "range",
      "id": "mobile_padding_bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 36
    },
    {
      "type": "range",
      "id": "mobile_row_gap",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "label": "行距",
      "default": 2
    }
  ],
  "blocks": [
    {
      "type": "row",
      "name": "t:sections.multirow.blocks.row.name",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "图片"
        },
        {
          "type": "image_picker",
          "id": "mobile_image",
          "label": "移动端图片"
        },
        {
          "type": "select",
          "id": "image_height",
          "options": [
            {
              "value": "adapt",
              "label": "t:sections.multirow.settings.image_height.options__1.label"
            },
            {
              "value": "small",
              "label": "t:sections.multirow.settings.image_height.options__2.label"
            },
            {
              "value": "medium",
              "label": "t:sections.multirow.settings.image_height.options__3.label"
            },
            {
              "value": "large",
              "label": "t:sections.multirow.settings.image_height.options__4.label"
            }
          ],
          "default": "medium",
          "label": "t:sections.multirow.settings.image_height.label"
        },
        {
          "type": "select",
          "id": "desktop_image_width",
          "options": [
            {
              "value": "small",
              "label": "t:sections.multirow.settings.desktop_image_width.options__1.label"
            },
            {
              "value": "medium",
              "label": "t:sections.multirow.settings.desktop_image_width.options__2.label"
            },
            {
              "value": "large",
              "label": "t:sections.multirow.settings.desktop_image_width.options__3.label"
            }
          ],
          "default": "medium",
          "label": "t:sections.multirow.settings.desktop_image_width.label"
        },
        {
          "type": "image_picker",
          "id": "background",
          "label": "背景图"
        },
        {
          "type": "text",
          "id": "caption",
          "default": "t:sections.multirow.blocks.row.settings.caption.default",
          "label": "t:sections.multirow.blocks.row.settings.caption.label"
        },
        {
          "type": "checkbox",
          "id": "hr",
          "default": false,
          "label": "t:sections.all.hr"
        },
        {
          "type": "checkbox",
          "id": "quote",
          "default": false,
          "label": "引号"
        },
        {
          "type": "inline_richtext",
          "id": "heading",
          "label": "标题"
        },
        {
          "type": "inline_richtext",
          "id": "sub_heading",
          "label": "副标题"
        },
        {
          "type": "richtext",
          "id": "text",
          "default": "t:sections.multirow.blocks.row.settings.text.default",
          "label": "t:sections.multirow.blocks.row.settings.text.label"
        },
        {
          "type": "text",
          "id": "button_label",
          "default": "t:sections.multirow.blocks.row.settings.button_label.default",
          "label": "t:sections.multirow.blocks.row.settings.button_label.label",
          "info": "t:sections.multirow.blocks.row.settings.button_label.info"
        },
        {
          "type": "url",
          "id": "button_link",
          "label": "t:sections.multirow.blocks.row.settings.button_link.label"
        },
        {
          "type": "select",
          "id": "button_style",
          "options": [
            {
              "value": "primary",
              "label": "t:sections.multirow.settings.button_style.options__1.label"
            },
            {
              "value": "secondary",
              "label": "t:sections.multirow.settings.button_style.options__2.label"
            }
          ],
          "default": "secondary",
          "label": "t:sections.multirow.settings.button_style.label"
        },
        {
          "type": "header",
          "content": "布局"
        },
        {
          "type": "select",
          "id": "image_layout",
          "options": [
            {
              "value": "left",
              "label": "左"
            },
            {
              "value": "right",
              "label": "右"
            }
          ],
          "default": "left",
          "label": "图片位置"
        },
        {
          "type": "select",
          "id": "desktop_content_position",
          "options": [
            {
              "value": "top",
              "label": "t:sections.multirow.settings.desktop_content_position.options__1.label"
            },
            {
              "value": "middle",
              "label": "t:sections.multirow.settings.desktop_content_position.options__2.label"
            },
            {
              "value": "bottom",
              "label": "t:sections.multirow.settings.desktop_content_position.options__3.label"
            }
          ],
          "default": "middle",
          "label": "t:sections.multirow.settings.desktop_content_position.label"
