{{ 'component-newsletter.css' | asset_url | stylesheet_tag }}
{{ 'newsletter-section.css' | asset_url | stylesheet_tag }}
{{ 'newsletter-custom.css' | asset_url | stylesheet_tag }}

{%- style -%}
  {%- if section.settings.background_image != blank -%}
    .section-{{ section.id }}-padding.newsletter__wrapper {
      background-image: url('{{ section.settings.background_image | image_url }}');
      background-size: cover;
      background-position: center;
      background-attachment: local;
    }
  {%- endif -%}
  @media screen and (max-width: 749px) {
    {%- if section.settings.mobile_background_image != blank -%}
      .section-{{ section.id }}-padding.newsletter__wrapper {
        background-image: url('{{ section.settings.mobile_background_image | image_url: width: 1500 }}');
        background-size: cover;
        background-position: {{ section.settings.mobile_background_image.presentation.focal_point | default: 'center center' }};
        background-attachment: local;
      }
    {%- endif -%}
    .section-{{ section.id }}-padding,
    .section-{{ section.id }}-padding > .inline-richtext,
    .section-{{ section.id }}-padding .newsletter__subheading,
    .section-{{ section.id }}-padding .newsletter__subheading > *,
    .section-{{ section.id }}-padding .newsletter-form__message {
      text-align: center;
    }
  }

{%- endstyle -%}

<div class="newsletter newsletter-custom center {% if section.settings.full_width == false %}newsletter--narrow page-width{% endif %}">
  <div class="newsletter__wrapper color-{{ section.settings.color_scheme }} gradient content-container isolate{% if section.settings.full_width %} content-container--full-width{% endif %} section-{{ section.id }}-padding"
    style="
      --nl-heading-color: {{ section.settings.heading_color | default: 'inherit' }};
      --nl-content-color: {{ section.settings.content_color | default: 'inherit' }};
      --nl-input-background: {{ section.settings.input_background | default: 'transparent' }};
      --nl-input-text: {{ section.settings.input_text_color | default: 'transparent' }};
      --nl-placeholder: {{ section.settings.input_placeholder_color | default: 'transparent' }};
      --nl-border: {{ section.settings.input_border_color | default: 'transparent' }};
      --nl-focus: {{ section.settings.input_focus_color | default: 'transparent' }};
      --nl-button-text: {{ section.settings.button_text_color | default: 'transparent' }};
      --nl-button-hover-background: {{ section.settings.button_hover_background | default: 'transparent' }};
      --nl-button-hover-text: {{ section.settings.button_hover_text_color | default: 'transparent' }};
      --nl-height: {{ section.settings.input_height }}px;
      --nl-radius: {{ section.settings.input_radius }}px;
      --nl-border-width: {{ section.settings.input_border_width }}px;
      --nl-button-radius: {{ section.settings.button_radius }}px;
      --nl-button-border: {{ section.settings.button_border_color }};
      --nl-button-border-width: {{ section.settings.button_border_width }}px;
      --nl-button-background: {% if section.settings.button_style == 'outline' %}transparent{% else %}{{ section.settings.button_background }}{% endif %};
      --nl-desktop-top: {{ section.settings.padding_top }}px;
      --nl-desktop-bottom: {{ section.settings.padding_bottom }}px;
      --nl-mobile-top: {{ section.settings.mobile_padding_top }}px;
      --nl-mobile-bottom: {{ section.settings.mobile_padding_bottom }}px;
    "
  >
    {%- for block in section.blocks -%}
      {%- case block.type -%}
        {%- when '@app' -%}
          {% render block %}
        {%- when 'heading' -%}
          <h2
            class="inline-richtext{% if section.settings.heading_color != blank %} newsletter-custom__heading--colored{% endif %} {{ block.settings.heading_size }}{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}"
            {{ block.shopify_attributes }}
            {% if settings.animations_reveal_on_scroll %}
              data-cascade
              style="--animation-order: {{ forloop.index }};"
            {% endif %}
          >
            {{ block.settings.heading }}
          </h2>
        {%- when 'paragraph' -%}
          <div
            class="newsletter__subheading{% if section.settings.content_color != blank %} newsletter-custom__content--colored{% endif %} rte{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %} {{ block.settings.text_style }}"
            {{ block.shopify_attributes }}
            {% if settings.animations_reveal_on_scroll %}
              data-cascade
              style="--animation-order: {{ forloop.index }};"
            {% endif %}
          >
            {{ block.settings.text }}
          </div>
        {%- when 'email_form' -%}
          <div
            {{ block.shopify_attributes }}
            {% if block.settings.override_form_style %}
            style="
              --nl-input-background: {{ block.settings.input_background | default: 'transparent' }};
              --nl-input-text: {{ block.settings.input_text_color | default: 'transparent' }};
              --nl-placeholder: {{ block.settings.input_placeholder_color | default: 'transparent' }};
              --nl-border: {{ block.settings.input_border_color | default: 'transparent' }};
              --nl-focus: {{ block.settings.input_focus_color | default: 'transparent' }};
              --nl-button-text: {{ block.settings.button_text_color | default: 'transparent' }};
              --nl-button-hover-background: {{ block.settings.button_hover_background | default: 'transparent' }};
              --nl-button-hover-text: {{ block.settings.button_hover_text_color | default: 'transparent' }};
              --nl-height: {{ block.settings.input_height }}px;
              --nl-radius: {{ block.settings.input_radius }}px;
              --nl-border-width: {{ block.settings.input_border_width }}px;
              --nl-button-radius: {{ block.settings.button_radius }}px;
              --nl-button-border: {{ block.settings.button_border_color }};
              --nl-button-border-width: {{ block.settings.button_border_width }}px;
              --nl-button-background: {% if block.settings.button_style == 'outline' %}transparent{% else %}{{ block.settings.button_background }}{% endif %};
            "
            {% endif %}
          >
            {% form 'customer', class: 'newsletter-form' %}
              <input type="hidden" name="contact[tags]" value="newsletter">
              <div
                class="newsletter-form__field-wrapper{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}"
                {% if settings.animations_reveal_on_scroll %}
                  data-cascade
                  style="--animation-order: {{ forloop.index }};"
                {% endif %}
              >
                <div class="field">
                  <input
                    id="NewsletterForm--{{ section.id }}"
                    type="email"
                    name="contact[email]"
                    class="field__input"
                    value="{{ form.email | escape }}"
                    aria-required="true"
                    autocorrect="off"
                    autocapitalize="off"
                    autocomplete="email"
                    {% if form.errors %}
                      autofocus
                      aria-invalid="true"
                      aria-describedby="Newsletter-error--{{ section.id }}"
                    {% elsif form.posted_successfully? %}
                      aria-describedby="Newsletter-success--{{ section.id }}"
                    {% endif %}
                    {% if section.settings.placeholder %}
                      placeholder="{{ section.settings.placeholder | escape }}"
                    {% else %}
                      placeholder="{{ 'newsletter.label' | t }}"
                    {% endif %}
                    required
                  >
                  <label class="field__label" for="NewsletterForm--{{ section.id }}">
                    {% if section.settings.placeholder %}{{ section.settings.placeholder | escape }}{% else %}{{ 'newsletter.label' | t }}{% endif %}
                  </label>
                  <button
                    type="submit"
                    class="newsletter-form__button field__button f-16"
                    name="commit"
                    id="Subscribe-{{ section.id }}"
                    aria-label="{{ 'newsletter.button_label' | t }}"
                  >
                    <span class='btn-defult'>SIGN UP</span>
                    <span class="btn-mobile newsletter-custom__arrow" aria-hidden="true"></span>
                  </button>
                </div>
                {%- if form.errors -%}
                  <small class="newsletter-form__message form__message" id="Newsletter-error--{{ section.id }}">
                    <span class="svg-wrapper">
                      {{- 'icon-error.svg' | inline_asset_content -}}
                    </span>
                    {{- form.errors.translated_fields.email | capitalize }}
                    {{ form.errors.messages.email -}}
                  </small>
                {%- endif -%}
              </div>
              {%- if form.posted_successfully? -%}
                <h3
                  class="newsletter-form__message newsletter-form__message--success form__message"
                  id="Newsletter-success--{{ section.id }}"
                  tabindex="-1"
                  autofocus
                >
                  <span class="svg-wrapper">
                    {{- 'icon-success.svg' | inline_asset_content -}}
                  </span>
                  {{- 'newsletter.success' | t }}
                </h3>
              {%- endif -%}
            {% endform %}
          </div>
      {%- endcase -%}
    {%- endfor -%}
  </div>
</div>

{% schema %}
