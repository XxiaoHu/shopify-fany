{{ 'swiper-bundle.min.css' | asset_url | stylesheet_tag }}
{{ 'product-category-home-list.css' | asset_url | stylesheet_tag }}

{% style %}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
    --pc-safe-margin: {{ section.settings.text_safe_margin }}px;
    --pc-image-gap: {{ section.settings.image_gap }}px;
    --pc-image-gap-mobile: {{ section.settings.mobile_image_gap }}px;
    --pc-mobile-gap: {{ section.settings.mobile_gap }}px;
    --pc-image-radius: {{ section.settings.card_border_radius }}px;
    --pc-image-text-gap: {{ section.settings.image_text_gap }}px;

    /* Tab colors */
    --pc-tab-color: {{ section.settings.tab_color }};
    --pc-tab-active-color: {{ section.settings.tab_active_color }};
    --pc-tab-hover-color: {{ section.settings.tab_hover_color }};
    --pc-tab-active-hover-color: {{ section.settings.tab_active_hover_color }};

    /* Title */
    --pc-title-font-weight: {{ section.settings.title_font_weight }};
    --pc-title-font-size: {{ section.settings.title_font_size }}px;
    --pc-title-line-height: {{ section.settings.title_line_height }};
    --pc-title-letter-spacing: {{ section.settings.title_letter_spacing }}px;
    --pc-title-align: {{ section.settings.title_alignment }};
    --pc-title-color: {{ section.settings.title_color }};

    /* Price */
    --pc-price-font-weight: {{ section.settings.price_font_weight }};
    --pc-price-font-size: {{ section.settings.price_font_size }}px;
    --pc-price-line-height: {{ section.settings.price_line_height }};
    --pc-price-letter-spacing: {{ section.settings.price_letter_spacing }}px;
    --pc-price-align: {{ section.settings.price_alignment }};
    --pc-price-color: {{ section.settings.price_color }};
    --pc-price-inner-gap: {{ section.settings.price_inner_gap }}px;

    /* Title–Price gap */
    --pc-title-price-gap: {{ section.settings.title_price_gap }}px;
  }

  /* Apply title styles via CSS variables */
  .section-{{ section.id }}-padding .card-title {
    font-weight: var(--pc-title-font-weight);
    font-size: var(--pc-title-font-size);
    line-height: var(--pc-title-line-height);
    letter-spacing: var(--pc-title-letter-spacing);
    text-align: var(--pc-title-align);
    color: var(--pc-title-color);
    margin-bottom: var(--pc-title-price-gap);
  }

  /* Apply price styles via CSS variables */
  .section-{{ section.id }}-padding .card-price {
    font-family: Merriweather, serif;
    font-weight: var(--pc-price-font-weight);
    font-size: var(--pc-price-font-size);
    line-height: var(--pc-price-line-height);
    letter-spacing: var(--pc-price-letter-spacing);
    text-align: var(--pc-price-align);
    color: var(--pc-price-color);
  }

  /* Apply section subtitle styles */
  .section-{{ section.id }}-padding .product-category-section-subtitle {
    font-weight: {{ section.settings.section_subtitle_font_weight }};
    line-height: {{ section.settings.section_subtitle_line_height }};
    letter-spacing: {{ section.settings.section_subtitle_letter_spacing }}px;
    text-align: center;
    color: {{ section.settings.section_subtitle_color }};
    margin-top: {{ section.settings.section_subtitle_margin_top }}px;
    margin-bottom: {{ section.settings.section_subtitle_margin_bottom }}px;
    {% if section.settings.section_subtitle_width != blank and section.settings.section_subtitle_width > 0 %}
    max-width: {{ section.settings.section_subtitle_width }}px;
    margin-left: auto;
    margin-right: auto;
    {% endif %}
  }

  /* Apply section title styles */
  .section-{{ section.id }}-padding .product-category-section-title {
    font-weight: {{ section.settings.section_title_font_weight }};
    line-height: {{ section.settings.section_title_line_height }};
    letter-spacing: {{ section.settings.section_title_letter_spacing }}px;
    text-align: center !important;
    display: block;
    width: 100%;
    margin-top: {{ section.settings.section_title_margin_top }}px;
    margin-bottom: {{ section.settings.section_title_margin_bottom }}px;
    {% if section.settings.section_title_width != blank and section.settings.section_title_width > 0 %}
    max-width: {{ section.settings.section_title_width }}px;
    margin-left: auto;
    margin-right: auto;
    {% endif %}
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
    .section-{{ section.id }}-padding .product-category-section-title {
      font-size: {{ section.settings.section_title_font_size }}px;
    }
    .section-{{ section.id }}-padding .product-category-section-subtitle {
      font-size: {{ section.settings.section_subtitle_font_size }}px;
    }
  }

  @media screen and (max-width: 768px) {
    .section-{{ section.id }}-padding {
      padding-top: 40px;
      padding-bottom: 40px;
      --pc-safe-margin: 16px;
      --pc-image-gap-mobile: 11px;
      --pc-mobile-gap: 20px;
      --pc-image-text-gap: 4px;
      --pc-title-price-gap: 10px;
    }
    .section-{{ section.id }}-padding .product-category-section-title {
      font-family: Lato, sans-serif;
      font-size: 24px;
      font-weight: 700;
      line-height: 1.2;
      letter-spacing: 0;
      color: #1E0E06;
      max-width: 268px;
      margin: 0 auto 20px;
    }
    .section-{{ section.id }}-padding .product-category-section-subtitle {
      font-size: 16px;
      font-weight: 400;
      line-height: 1.5;
      letter-spacing: 0;
      color: #686766;
      margin: 0 auto 20px;
    }
    .section-{{ section.id }}-padding .card-title {
      font-family: Lato, sans-serif;
      font-size: 14px;
      font-weight: 400;
      line-height: 1.5;
      letter-spacing: 0;
      color: #1E0E06;
      text-align: left;
    }
    .section-{{ section.id }}-padding .card-price {
      font-family: Merriweather, serif;
      font-size: 16px;
      font-weight: 700;
      line-height: 1;
      letter-spacing: 0;
      color: #93726C;
      text-align: left;
    }
  }
{% endstyle %}

<script src="{{ 'swiper-bundle.min.js' | asset_url }}" defer="defer"></script>
<script src="{{ 'product-category-home-list.js' | asset_url }}" defer="defer"></script>


<div class="isolate">
  <div class="section-{{ section.id }}-padding" style="padding-left: var(--pc-safe-margin); padding-right: var(--pc-safe-margin);">

    {%- if section.settings.section_title != blank -%}
      <h2 class="product-category-section-title">{{ section.settings.section_title | escape | newline_to_br }}</h2>
    {%- endif -%}
    {%- if section.settings.section_subtitle != blank -%}
      <p class="product-category-section-subtitle">{{ section.settings.section_subtitle | escape | newline_to_br }}</p>
    {%- endif -%}

    <!-- 顶部菜单 -->
    <div class="product-category-top-menu">
      {%- assign first_valid_group = true -%}
      {% for block in section.blocks %}
        {% if block.type == 'product_group' %}
          {% assign group_data = block.settings.group_data %}
          {%- if group_data != blank -%}
            {%- liquid
              assign group_key = group_data.key.value | default: group_data.key
              assign group_menu = group_data.menu.value | default: group_data.menu
            -%}
            <div class="menu-item{% if first_valid_group %} active{% endif %}" data-group="{{ group_key | escape }}">{{ group_menu }}</div>
            {%- assign first_valid_group = false -%}
          {%- endif -%}
        {% endif %}
      {% endfor %}
    </div>

    <!-- Swiper 容器 -->
    <div class="swiper product-category-home-swiper">
        <div class="swiper-wrapper"></div>
        <!-- 左右箭头 -->
        <div class="swiper-button-prev product-category-slider-button"></div>
        <div class="swiper-button-next product-category-slider-button"></div>
    </div>
  </div>
</div>
<script>
window.slideGroups = {
  {% for block in section.blocks %}
    {% if block.type == 'product_group' %}
      {% assign group_data = block.settings.group_data %}
      {%- if group_data != blank -%}
        {%- liquid
          assign group_key = group_data.key.value | default: group_data.key
        -%}
        {{ group_key | json }}: [
          {% for item in group_data.productdata.value %}
            {%- liquid
              assign item_title = item.title.value | default: item.title
              assign item_badge_text = item.badgetext.value | default: item.badgetext
              assign item_image = item.imageurl.value | default: item.imageurl
              assign item_hover_image = item.imageurlhover.value | default: item.imageurlhover | default: item_image
              assign item_url = item.url.value.url | default: item.url.value | default: item.url
              assign item_price = item.price.value | default: item.price
              assign item_discount_price = item.disprice.value | default: item.disprice
            -%}
            {
              "title": {{ item_title | json }},
              "badgeText": {{ item_badge_text | json }},
              "imgUrl": {% if item_image != blank %}{{ item_image | image_url: width: 900 | json }}{% else %}""{% endif %},
              "imgHoverUrl": {% if item_hover_image != blank %}{{ item_hover_image | image_url: width: 900 | json }}{% else %}""{% endif %},
              "price": {% if item_price != blank %}{{ item_price | money_without_trailing_zeros | json }}{% else %}""{% endif %},
              "disPrice": {% if item_discount_price != blank %}{{ item_discount_price | money_without_trailing_zeros | json }}{% else %}""{% endif %},
              "url": {{ item_url | json }}
            }{% unless forloop.last %},{% endunless %}
          {% endfor %}
        ]{% unless forloop.last %},{% endunless %}
      {%- endif -%}
    {% endif %}
  {% endfor %}
};
</script>
