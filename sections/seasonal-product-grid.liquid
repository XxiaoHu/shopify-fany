{{ 'seasonal-product-grid.css' | asset_url | stylesheet_tag }}

<section
  id="SeasonalProductGrid-{{ section.id }}"
  class="seasonal-product-grid"
  style="
    --spg-background: {{ section.settings.background_color }};
    --spg-heading-color: {{ section.settings.heading_color }};
    --spg-description-color: {{ section.settings.description_color }};
    --spg-card-heading-color: {{ section.settings.card_heading_color }};
    --spg-card-description-color: {{ section.settings.card_description_color }};
    --spg-media-background: {{ section.settings.media_background_color }};
    --spg-desktop-heading-size: {{ section.settings.desktop_heading_size }}px;
    --spg-desktop-heading-line-height: {{ section.settings.desktop_heading_line_height | divided_by: 100.0 }};
    --spg-desktop-description-size: {{ section.settings.desktop_description_size }}px;
    --spg-desktop-description-line-height: {{ section.settings.desktop_description_line_height | divided_by: 100.0 }};
    --spg-desktop-card-heading-size: {{ section.settings.desktop_card_heading_size }}px;
    --spg-desktop-card-heading-line-height: {{ section.settings.desktop_card_heading_line_height | divided_by: 100.0 }};
    --spg-desktop-card-description-size: {{ section.settings.desktop_card_description_size }}px;
    --spg-desktop-card-description-line-height: {{ section.settings.desktop_card_description_line_height | divided_by: 100.0 }};
    --spg-mobile-heading-size: {{ section.settings.mobile_heading_size }}px;
    --spg-mobile-heading-line-height: {{ section.settings.mobile_heading_line_height | divided_by: 100.0 }};
    --spg-mobile-description-size: {{ section.settings.mobile_description_size }}px;
    --spg-mobile-description-line-height: {{ section.settings.mobile_description_line_height | divided_by: 100.0 }};
    --spg-mobile-card-heading-size: {{ section.settings.mobile_card_heading_size }}px;
    --spg-mobile-card-heading-line-height: {{ section.settings.mobile_card_heading_line_height | divided_by: 100.0 }};
    --spg-mobile-card-description-size: {{ section.settings.mobile_card_description_size }}px;
    --spg-mobile-card-description-line-height: {{ section.settings.mobile_card_description_line_height | divided_by: 100.0 }};
    --spg-desktop-padding-top: {{ section.settings.desktop_padding_top }}px;
    --spg-desktop-padding-bottom: {{ section.settings.desktop_padding_bottom }}px;
    --spg-mobile-padding-top: {{ section.settings.mobile_padding_top }}px;
    --spg-mobile-padding-bottom: {{ section.settings.mobile_padding_bottom }}px;
  "
>
  {%- if section.settings.navigation_anchor != blank -%}
    <span
      id="SeasonalProductGridAnchor-{{ section.id }}"
      class="seasonal-product-grid__anchor"
      data-navigation-anchor="{{ section.settings.navigation_anchor | handleize }}"
      aria-hidden="true"
    ></span>
  {%- endif -%}

  <div class="seasonal-product-grid__inner">
    {%- if section.settings.heading != blank or section.settings.description != blank -%}
      <div class="seasonal-product-grid__header">
        {%- if section.settings.heading != blank -%}
          <h2 class="seasonal-product-grid__heading">{{ section.settings.heading }}</h2>
        {%- endif -%}
        {%- if section.settings.description != blank -%}
          <div class="seasonal-product-grid__description rte">{{ section.settings.description }}</div>
        {%- endif -%}
      </div>
    {%- endif -%}

    {%- if section.blocks.size > 0 -%}
      <div class="seasonal-product-grid__items">
        {%- for block in section.blocks -%}
          {%- liquid
            assign desktop_image = block.settings.desktop_image
            assign mobile_image = block.settings.mobile_image
            assign fallback_image = desktop_image | default: mobile_image
            assign card_tag = 'div'
            if block.settings.link != blank
              assign card_tag = 'a'
            endif
          -%}
          <article
            id="SeasonalProductGridCard-{{ section.id }}-{{ block.id }}"
            class="seasonal-product-grid__card{% if forloop.index > section.settings.mobile_visible_blocks %} seasonal-product-grid__card--mobile-hidden{% endif %}"
            {{ block.shopify_attributes }}
          >
            <{{ card_tag }}
              class="seasonal-product-grid__card-link"
              {% if block.settings.link != blank %}href="{{ block.settings.link }}"{% endif %}
            >
              <div class="seasonal-product-grid__media">
                {%- if fallback_image != blank -%}
                  <picture class="seasonal-product-grid__picture">
                    {%- if mobile_image != blank -%}
                      <source
                        media="(max-width: 749px)"
                        srcset="
                          {{ mobile_image | image_url: width: 240 }} 240w,
                          {{ mobile_image | image_url: width: 400 }} 400w,
                          {{ mobile_image | image_url: width: 600 }} 600w
                        "
                        sizes="calc((100vw - 43px) / 2)"
                      >
                    {%- endif -%}
                    {{
                      fallback_image
                      | image_url: width: 1000
                      | image_tag:
                        class: 'seasonal-product-grid__image',
                        loading: 'lazy',
                        widths: '240, 400, 600, 736, 1000',
                        sizes: '(max-width: 749px) calc((100vw - 43px) / 2), (max-width: 1199px) calc((100vw - 128px) / 4), 368px',
                        alt: block.settings.image_alt
                    }}
                  </picture>
                {%- elsif request.design_mode -%}
                  {{ 'product-1' | placeholder_svg_tag: 'seasonal-product-grid__placeholder placeholder-svg' }}
                {%- endif -%}
              </div>

              {%- if block.settings.heading != blank or block.settings.description != blank -%}
                <div class="seasonal-product-grid__card-copy">
                  {%- if block.settings.heading != blank -%}
                    <h3 class="seasonal-product-grid__card-heading">{{ block.settings.heading | escape }}</h3>
                  {%- endif -%}
                  {%- if block.settings.description != blank -%}
                    <p class="seasonal-product-grid__card-description">{{ block.settings.description | escape }}</p>
                  {%- endif -%}
                </div>
              {%- endif -%}
            </{{ card_tag }}>
          </article>
        {%- endfor -%}
      </div>
    {%- elsif request.design_mode -%}
      <p class="seasonal-product-grid__empty">请添加产品卡片</p>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "节日产品网格",
  "tag": "section",
  "class": "section",
  "disabled_on": { "groups": ["header", "footer"] },
  "settings": [
    { "type": "header", "content": "内容" },
    { "type": "inline_richtext", "id": "heading", "label": "标题", "default": "Other" },
    { "type": "richtext", "id": "description", "label": "描述", "default": "<p>Distinct silhouettes and thoughtful details. This season’s watches explore texture, proportion, and finish with quiet confidence.</p>" },
    { "type": "text", "id": "navigation_anchor", "label": "导航锚点", "info": "用于吸顶导航跳转，例如 other；同一页面不能重复。" },

    { "type": "header", "content": "移动端显示" },
    { "type": "range", "id": "mobile_visible_blocks", "min": 1, "max": 20, "step": 1, "label": "移动端显示卡片数量", "default": 4, "info": "只控制移动端显示前几个卡片；PC 端始终显示全部卡片。" },

    { "type": "header", "content": "颜色" },
    { "type": "color", "id": "background_color", "label": "背景颜色", "default": "#ffffff" },
    { "type": "color", "id": "heading_color", "label": "标题颜色", "default": "#1e0e06" },
    { "type": "color", "id": "description_color", "label": "描述颜色", "default": "#686766" },
    { "type": "color", "id": "card_heading_color", "label": "卡片标题颜色", "default": "#1e0e06" },
    { "type": "color", "id": "card_description_color", "label": "卡片描述颜色", "default": "#686766" },
    { "type": "color", "id": "media_background_color", "label": "图片区域背景颜色", "default": "#f7f7f7" },

    { "type": "header", "content": "PC 字号与行高" },
    { "type": "range", "id": "desktop_heading_size", "min": 16, "max": 56, "step": 1, "unit": "px", "label": "标题字号", "default": 28 },
    { "type": "range", "id": "desktop_heading_line_height", "min": 80, "max": 200, "step": 5, "unit": "%", "label": "标题行高", "default": 120 },
    { "type": "range", "id": "desktop_description_size", "min": 12, "max": 32, "step": 1, "unit": "px", "label": "描述字号", "default": 16 },
    { "type": "range", "id": "desktop_description_line_height", "min": 100, "max": 220, "step": 5, "unit": "%", "label": "描述行高", "default": 150 },
    { "type": "range", "id": "desktop_card_heading_size", "min": 12, "max": 36, "step": 1, "unit": "px", "label": "卡片标题字号", "default": 20 },
    { "type": "range", "id": "desktop_card_heading_line_height", "min": 80, "max": 200, "step": 5, "unit": "%", "label": "卡片标题行高", "default": 120 },
    { "type": "range", "id": "desktop_card_description_size", "min": 10, "max": 28, "step": 1, "unit": "px", "label": "卡片描述字号", "default": 16 },
    { "type": "range", "id": "desktop_card_description_line_height", "min": 100, "max": 220, "step": 5, "unit": "%", "label": "卡片描述行高", "default": 150 },

    { "type": "header", "content": "移动端字号与行高" },
    { "type": "range", "id": "mobile_heading_size", "min": 16, "max": 40, "step": 1, "unit": "px", "label": "标题字号", "default": 24 },
    { "type": "range", "id": "mobile_heading_line_height", "min": 80, "max": 200, "step": 5, "unit": "%", "label": "标题行高", "default": 120 },
    { "type": "range", "id": "mobile_description_size", "min": 12, "max": 28, "step": 1, "unit": "px", "label": "描述字号", "default": 16 },
    { "type": "range", "id": "mobile_description_line_height", "min": 100, "max": 220, "step": 5, "unit": "%", "label": "描述行高", "default": 150 },
    { "type": "range", "id": "mobile_card_heading_size", "min": 12, "max": 28, "step": 1, "unit": "px", "label": "卡片标题字号", "default": 16 },
    { "type": "range", "id": "mobile_card_heading_line_height", "min": 80, "max": 200, "step": 5, "unit": "%", "label": "卡片标题行高", "default": 120 },
    { "type": "range", "id": "mobile_card_description_size", "min": 10, "max": 24, "step": 1, "unit": "px", "label": "卡片描述字号", "default": 14 },
    { "type": "range", "id": "mobile_card_description_line_height", "min": 100, "max": 220, "step": 5, "unit": "%", "label": "卡片描述行高", "default": 150 },

    { "type": "header", "content": "上下间距" },
    { "type": "range", "id": "desktop_padding_top", "min": 0, "max": 160, "step": 4, "unit": "px", "label": "PC 上间距", "default": 80 },
    { "type": "range", "id": "desktop_padding_bottom", "min": 0, "max": 160, "step": 4, "unit": "px", "label": "PC 下间距", "default": 80 },
    { "type": "range", "id": "mobile_padding_top", "min": 0, "max": 120, "step": 4, "unit": "px", "label": "移动端上间距", "default": 40 },
    { "type": "range", "id": "mobile_padding_bottom", "min": 0, "max": 120, "step": 4, "unit": "px", "label": "移动端下间距", "default": 40 }
  ],
  "blocks": [
    {
      "type": "product_card",
      "name": "产品卡片",
      "settings": [
        { "type": "image_picker", "id": "desktop_image", "label": "PC 图片" },
        { "type": "image_picker", "id": "mobile_image", "label": "移动端图片", "info": "留空时自动使用 PC 图片。" },
        { "type": "text", "id": "image_alt", "label": "图片替代文字" },
        { "type": "text", "id": "heading", "label": "标题", "default": "Surf Holiday" },
        { "type": "textarea", "id": "description", "label": "描述", "default": "Design Story: Ride the golden sunset waves into late-summer freedom; relaxation is the true spirit of the season." },
        { "type": "url", "id": "link", "label": "链接" }
      ]
    }
  ],
  "presets": [
    {
      "name": "节日产品网格",
      "blocks": [
        { "type": "product_card" },
        { "type": "product_card" },
        { "type": "product_card" },
        { "type": "product_card" },
        { "type": "product_card" },
        { "type": "product_card" },
        { "type": "product_card" },
        { "type": "product_card" }
      ]
    }
  ]
}
{% endschema %}
