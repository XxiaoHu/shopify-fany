    },
    {
      "type": "range",
      "id": "desktop_button_size",
      "min": 10,
      "max": 24,
      "step": 1,
      "unit": "px",
      "label": "按钮字号",
      "default": 16
    },
    {
      "type": "range",
      "id": "desktop_note_size",
      "min": 10,
      "max": 24,
      "step": 1,
      "unit": "px",
      "label": "按钮下方文案字号",
      "default": 14
    },
    {
      "type": "range",
      "id": "desktop_offer_size",
      "min": 10,
      "max": 24,
      "step": 1,
      "unit": "px",
      "label": "权益字号",
      "default": 14
    },
    {
      "type": "header",
      "content": "移动端字号"
    },
    {
      "type": "range",
      "id": "mobile_eyebrow_size",
      "min": 10,
      "max": 20,
      "step": 1,
      "unit": "px",
      "label": "眉题字号",
      "default": 14
    },
    {
      "type": "range",
      "id": "mobile_heading_size",
      "min": 20,
      "max": 48,
      "step": 1,
      "unit": "px",
      "label": "标题字号",
      "default": 28
    },
    {
      "type": "range",
      "id": "mobile_lead_size",
      "min": 12,
      "max": 24,
      "step": 1,
      "unit": "px",
      "label": "描述字号",
      "default": 16
    },
    {
      "type": "range",
      "id": "mobile_button_size",
      "min": 10,
      "max": 22,
      "step": 1,
      "unit": "px",
      "label": "按钮字号",
      "default": 16
    },
    {
      "type": "range",
      "id": "mobile_note_size",
      "min": 10,
      "max": 20,
      "step": 1,
      "unit": "px",
      "label": "按钮下方文案字号",
      "default": 14
    },
    {
      "type": "range",
      "id": "mobile_offer_size",
      "min": 10,
      "max": 20,
      "step": 1,
      "unit": "px",
      "label": "权益字号",
      "default": 14
    },
    {
      "type": "header",
