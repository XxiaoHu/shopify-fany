  ],
  "blocks": [
    {
      "type": "offer_item",
      "name": "权益项",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "文字",
          "default": "Available styles"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "商务 Hero",
      "blocks": [
        { "type": "offer_item", "settings": { "text": "Available styles" } },
        { "type": "offer_item", "settings": { "text": "Business pricing" } },
