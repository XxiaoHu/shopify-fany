      "max": 56,
      "step": 1,
      "unit": "px",
      "label": "左侧标题字号",
      "default": 40
    },
    {
      "type": "range",
      "id": "mobile_description_size",
      "min": 12,
      "max": 24,
      "step": 1,
      "unit": "px",
      "label": "左侧说明字号",
      "default": 16
    },
    {
      "type": "range",
      "id": "mobile_form_heading_size",
      "min": 18,
      "max": 32,
      "step": 1,
      "unit": "px",
      "label": "表单主标题字号",
      "default": 24
    },
    {
      "type": "range",
      "id": "mobile_form_text_size",
      "min": 12,
      "max": 22,
      "step": 1,
      "unit": "px",
      "label": "表单输入文字字号",
      "default": 16
    },
    {
      "type": "range",
      "id": "mobile_horizontal_padding",
