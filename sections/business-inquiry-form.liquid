      "default": "Thank you."
    },
    {
      "type": "textarea",
      "id": "success_message",
      "label": "提交成功说明",
      "default": "Your request has been sent to the FANY business team."
    },
    {
      "type": "header",
      "content": "颜色"
    },
    {
      "type": "color",
      "id": "section_background",
      "label": "Section 背景",
      "default": "#9E7163"
    },
    {
      "type": "color",
      "id": "left_text_color",
      "label": "左侧文字颜色",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "form_background",
      "label": "表单背景",
      "default": "#FFFDFD"
    },
    {
      "type": "color",
      "id": "form_heading_color",
      "label": "表单标题颜色",
      "default": "#1E0E06"
    },
    {
      "type": "color",
      "id": "form_text_color",
      "label": "表单说明颜色",
