{{ 'section-blog-post.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign read_on_items = article.metafields.custom.read_on.value
  if read_on_items == blank
    assign read_on_items = article.metafields.custom.read_on | replace: '[', '' | replace: ']', '' | replace: '"', '' | split: ','
  endif

  assign related_article_handles = '' | split: ''
  for item in read_on_items
    assign item_url = item.url | default: item | strip
    assign article_path = item_url | split: '/blogs/' | last
    assign article_path = article_path | split: '?' | first | split: '#' | first
    if article_path != blank
      assign related_article = articles[article_path]
      if related_article != blank
        assign article_handle = article_path | split: ','
        assign related_article_handles = related_article_handles | concat: article_handle
      endif
    endif
  endfor

  assign related_article_limit = section.settings.post_limit
  assign recommended_products = article.metafields.custom.recommended_products.value
  assign has_sidebar_content = false
  if recommended_products != blank or related_article_handles.size > 0
    assign has_sidebar_content = true
  endif

  assign article_image_render_width = 1720
  assign article_image_widths = '550, 750, 1100, 1500, 1720'
  assign article_image_sizes = '(min-width: 1320px) 860px, (min-width: 990px) calc(100vw - 460px), calc(100vw - 32px)'
  unless has_sidebar_content
    assign article_image_render_width = 2560
    assign article_image_widths = '550, 750, 1100, 1500, 1720, 2200, 2560'
    assign article_image_sizes = '(min-width: 1400px) 1280px, (min-width: 990px) calc(100vw - 64px), (min-width: 750px) calc(100vw - 40px), calc(100vw - 32px)'
  endunless
-%}

<article class="article-template">
  <div class="article-template__layout{% unless has_sidebar_content %} article-template__layout--single{% endunless %}">
    <div class="article-template__primary">
      <header class="article-template__header">
        <div class="article-template__media">
          {%- if article.image -%}
            {{
              article.image
              | image_url: width: article_image_render_width
              | image_tag:
                class: 'article-template__featured-image',
                fetchpriority: 'high',
                sizes: article_image_sizes,
                widths: article_image_widths
            }}
          {%- else -%}
            {{ 'detailed-apparel-1' | placeholder_svg_tag: 'placeholder-svg article-template__featured-image' }}
          {%- endif -%}
        </div>

        <div class="article-template__intro">
          <h1 class="article-template__title">{{ article.title | escape }}</h1>
          {%- if article.excerpt != blank -%}
            <div class="article-template__excerpt">{{ article.excerpt }}</div>
          {%- endif -%}
          {%- render 'social-icons', class: 'article-template__social' -%}
        </div>
      </header>

      <div class="article-template__line" aria-hidden="true"></div>

      <div class="article-template__main_box rte">
        {{ article.content }}
      </div>
    </div>

    {%- if has_sidebar_content -%}
      <aside class="article-template__sidebar" aria-label="Recommended products and related articles">
        {%- if recommended_products != blank -%}
          <div class="article-template__products" aria-label="Recommended products">
            {%- for recommended_product in recommended_products -%}
              {%- assign recommended_product_image_alt = recommended_product.featured_image.alt
                | default: recommended_product.title
              -%}
              <a href="{{ recommended_product.url }}" class="article-template__product-card">
                <div class="article-template__product-media">
                  {%- if recommended_product.featured_image != blank -%}
                    {{
                      recommended_product.featured_image
                      | image_url: width: 680
                      | image_tag:
                        class: 'article-template__product-image',
                        loading: 'lazy',
                        alt: recommended_product_image_alt,
                        sizes: '340px',
                        widths: '340, 510, 680'
                    }}
                  {%- else -%}
                    {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg article-template__product-image' }}
                  {%- endif -%}
                </div>
                <div class="article-template__product-content">
                  <span class="article-template__product-title">{{ recommended_product.title | escape }}</span>
                  <span class="article-template__product-action">
                    <span class="article-template__product-price">{{ recommended_product.price | money }}</span>
                    <span class="article-template__product-cta" aria-hidden="true">Shop now</span>
                  </span>
                </div>
              </a>
            {%- endfor -%}
          </div>
        {%- endif -%}

        {%- if related_article_handles.size > 0 -%}
          <section class="article-template__related" aria-labelledby="RelatedHeading-{{ section.id }}">
            <h2 id="RelatedHeading-{{ section.id }}" class="article-template__related-heading">RELATED</h2>
            <div class="article-template__related-list">
              {%- for handle in related_article_handles limit: related_article_limit -%}
                {%- liquid
                  assign clean_handle = handle | strip
                  assign related_article = articles[clean_handle]
                -%}
                {%- if related_article != blank -%}
                  <a href="{{ related_article.url }}" class="article-template__related-card">
                    <div class="article-template__related-media">
                      {%- if related_article.image != blank -%}
                        {{
                          related_article.image
                          | image_url: width: 440
                          | image_tag:
                            class: 'article-template__related-image',
                            loading: 'lazy',
                            sizes: '110px',
                            widths: '220, 330, 440'
                        }}
                      {%- else -%}
                        {{ 'image' | placeholder_svg_tag: 'placeholder-svg article-template__related-image' }}
                      {%- endif -%}
                    </div>
                    <span class="article-template__related-content">
                      <span class="article-template__related-title">{{ related_article.title | escape }}</span>
                      <time
                        class="article-template__related-date"
                        datetime="{{ related_article.published_at | date: '%Y-%m-%d' }}"
                      >
                        {{- related_article.published_at | date: '%m/%d/%Y' -}}
                      </time>
                    </span>
                  </a>
                {%- endif -%}
              {%- endfor -%}
            </div>
          </section>
        {%- endif -%}
      </aside>
    {%- endif -%}
  </div>

  {%- if blog.comments_enabled? -%}
    <div class="article-template__comment-wrapper background-secondary">
      <div
        id="comments"
        class="page-width page-width--narrow{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}"
      >
        {%- if article.comments_count > 0 -%}
          {%- assign anchorId = '#Comments-' | append: article.id -%}

          <h2 id="Comments-{{ article.id }}" tabindex="-1">
            {{ 'blogs.article.comments' | t: count: article.comments_count }}
          </h2>
          {% paginate article.comments by 5 %}
            <div class="article-template__comments">
              {%- if comment.status == 'pending' and comment.content -%}
                <article id="{{ comment.id }}" class="article-template__comments-comment">
                  {{ comment.content }}
                  <footer class="right">
                    <span class="circle-divider caption-with-letter-spacing">{{ comment.author }}</span>
                  </footer>
                </article>
              {%- endif -%}

              {%- for comment in article.comments -%}
                <article id="{{ comment.id }}" class="article-template__comments-comment">
                  {{ comment.content }}
                  <footer class="right">
                    <span class="circle-divider caption-with-letter-spacing">{{ comment.author }}</span
                    ><span class="caption-with-letter-spacing">
                      {{- comment.created_at | time_tag: format: 'date' -}}
                    </span>
                  </footer>
                </article>
              {%- endfor -%}
              {% render 'pagination', paginate: paginate, anchor: anchorId %}
            </div>
          {% endpaginate %}
        {%- endif -%}
        {% form 'new_comment', article %}
          {%- liquid
            assign post_message = 'blogs.article.success'
            if blog.moderated? and comment.status == 'unapproved'
              assign post_message = 'blogs.article.success_moderated'
            endif
          -%}
          <h2>{{ 'blogs.article.comment_form_title' | t }}</h2>
          {%- if form.errors -%}
            <div class="form__message" role="alert">
              <h3 class="form-status caption-large text-body" tabindex="-1" autofocus>
                <span class="svg-wrapper">
                  {{- 'icon-error.svg' | inline_asset_content -}}
                </span>
                {{ 'templates.contact.form.error_heading' | t }}
              </h3>
            </div>
            <ul class="form-status-list caption-large">
              {%- for field in form.errors -%}
                <li>
                  <a href="#CommentForm-{{ field }}" class="link">
                    {%- if form.errors.translated_fields[field] contains 'author' -%}
                      {{ 'blogs.article.name' | t }}
                    {%- elsif form.errors.translated_fields[field] contains 'body' -%}
                      {{ 'blogs.article.message' | t }}
                    {%- else -%}
                      {{ form.errors.translated_fields[field] }}
                    {%- endif -%}
                    {{ form.errors.messages[field] }}
                  </a>
                </li>
              {%- endfor -%}
            </ul>
          {%- elsif form.posted_successfully? -%}
            <div class="form-status-list form__message" role="status">
              <h3 class="form-status" tabindex="-1" autofocus>
                <span class="svg-wrapper">
                  {{- 'icon-success.svg' | inline_asset_content -}}
                </span>
                {{ post_message | t }}
              </h3>
            </div>
          {%- endif -%}

          <div
            {% if blog.moderated? == false %}
              class="article-template__comments-fields"
            {% endif %}
          >
            <div class="article-template__comment-fields">
              <div class="field field--with-error">
                <input
                  type="text"
                  name="comment[author]"
                  id="CommentForm-author"
                  class="field__input"
                  autocomplete="name"
                  value="{{ form.author }}"
                  aria-required="true"
                  required
                  {% if form.errors contains 'author' %}
                    aria-invalid="true"
                    aria-describedby="CommentForm-author-error"
                  {% endif %}
                  placeholder="{{ 'blogs.article.name' | t }}"
                >
                <label class="field__label" for="CommentForm-author">
                  {{- 'blogs.article.name' | t }}
                  <span aria-hidden="true">*</span></label
                >
                {%- if form.errors contains 'author' -%}
                  <small id="CommentForm-author-error">
                    <span class="form__message">
                      <span class="svg-wrapper">
                        {{- 'icon-error.svg' | inline_asset_content -}}
                      </span>
                      {{- 'blogs.article.name' | t }}
                      {{ form.errors.messages.author }}.</span
                    >
                  </small>
                {%- endif -%}
              </div>
              <div class="field field--with-error">
                <input
                  type="email"
                  name="comment[email]"
                  id="CommentForm-email"
                  autocomplete="email"
                  class="field__input"
                  value="{{ form.email }}"
                  autocorrect="off"
                  autocapitalize="off"
                  aria-required="true"
                  required
                  {% if form.errors contains 'email' %}
                    aria-invalid="true"
                    aria-describedby="CommentForm-email-error"
                  {% endif %}
                  placeholder="{{ 'blogs.article.email' | t }}"
                >
                <label class="field__label" for="CommentForm-email">
                  {{- 'blogs.article.email' | t }}
                  <span aria-hidden="true">*</span></label
                >
                {%- if form.errors contains 'email' -%}
                  <small id="CommentForm-email-error">
                    <span class="form__message">
                      <span class="svg-wrapper">
                        {{- 'icon-error.svg' | inline_asset_content -}}
                      </span>
                      {{- 'blogs.article.email' | t }}
                      {{ form.errors.messages.email }}.</span
                    >
                  </small>
                {%- endif -%}
              </div>
            </div>
            <div class="field field--with-error">
              <textarea
                rows="5"
                name="comment[body]"
                id="CommentForm-body"
                class="text-area field__input"
                aria-required="true"
                required
                {% if form.errors contains 'body' %}
                  aria-invalid="true"
                  aria-describedby="CommentForm-body-error"
                {% endif %}
                placeholder="{{ 'blogs.article.message' | t }}"
              >{{ form.body }}</textarea>
              <label class="form__label field__label" for="CommentForm-body">
                {{- 'blogs.article.message' | t }}
                <span aria-hidden="true">*</span></label
              >
            </div>
            {%- if form.errors contains 'body' -%}
              <small id="CommentForm-body-error">
                <span class="form__message">
                  <span class="svg-wrapper">
                    {{- 'icon-error.svg' | inline_asset_content -}}
                  </span>
                  {{- 'blogs.article.message' | t }}
                  {{ form.errors.messages.body }}.</span
                >
              </small>
            {%- endif -%}
          </div>
          {%- if blog.moderated? -%}
            <p class="article-template__comment-warning caption">{{ 'blogs.article.moderated' | t }}</p>
          {%- endif -%}
          <input type="submit" class="button" value="{{ 'blogs.article.post' | t }}">
        {% endform %}
      </div>
    </div>
  {%- endif -%}
</article>

<script type="application/ld+json">
  {{ article | structured_data }}
</script>

{% schema %}
{
  "name": "t:sections.main-article.name",
  "tag": "section",
  "class": "section",
  "blocks": [
    {
      "type": "@app"
    }
  ],
  "settings": [
    {
      "type": "range",
      "id": "post_limit",
      "min": 1,
      "max": 6,
      "step": 1,
      "default": 3,
      "label": "RELATED 文章数量"
    }
  ]
}
{% endschema %}
