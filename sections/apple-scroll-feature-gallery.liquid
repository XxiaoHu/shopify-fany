      "max": 800,
      "step": 10,
      "unit": "px",
      "label": "桌面端标题宽度",
      "default": 340
    },
    {
      "type": "range",
      "id": "desktop_detail_body_width",
      "min": 160,
      "max": 800,
      "step": 10,
      "unit": "px",
      "label": "桌面端正文宽度",
      "default": 340
    },
    {
      "type": "range",
      "id": "mobile_detail_heading_width",
      "min": 120,
      "max": 400,
      "step": 5,
      "unit": "px",
      "label": "移动端标题宽度",
      "default": 355
    },
    {
      "type": "range",
      "id": "mobile_detail_body_width",
      "min": 120,
      "max": 400,
      "step": 5,
      "unit": "px",
      "label": "移动端正文宽度",
      "default": 355
    },
    {
      "type": "color",
      "id": "desktop_detail_text_color",
      "label": "桌面端文字颜色",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "mobile_detail_text_color",
      "label": "移动端文字颜色",
      "default": "#FFFFFF"
    },
    {
      "type": "range",
      "id": "desktop_detail_heading_size",
      "min": 20,
      "max": 72,
      "step": 1,
      "unit": "px",
      "label": "桌面端标题字号",
      "default": 40
    },
    {
      "type": "range",
      "id": "desktop_detail_body_size",
      "min": 12,
      "max": 36,
      "step": 1,
      "unit": "px",
      "label": "桌面端正文字号",
