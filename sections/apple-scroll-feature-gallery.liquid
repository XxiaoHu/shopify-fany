    },
    {
      "type": "range",
      "id": "desktop_intro_body_size",
      "min": 12,
      "max": 36,
      "step": 1,
      "unit": "px",
      "label": "桌面端正文字号",
      "default": 20
    },
    {
      "type": "range",
      "id": "mobile_intro_heading_size",
      "min": 18,
      "max": 48,
      "step": 1,
      "unit": "px",
      "label": "移动端标题字号",
      "default": 28
    },
    {
      "type": "range",
      "id": "mobile_intro_body_size",
      "min": 12,
      "max": 28,
      "step": 1,
      "unit": "px",
      "label": "移动端正文字号",
      "default": 16
    },
    {
      "type": "header",
      "content": "第二阶段文案"
    },
    {
      "type": "textarea",
      "id": "detail_heading",
