{{ 'how-to-video-list.css' | asset_url | stylesheet_tag }}
{{ 'video-section.css' | asset_url | stylesheet_tag }}
{{ 'component-deferred-media.css' | asset_url | stylesheet_tag }}
<script src="{{ 'how-to-video-list.js' | asset_url }}" defer></script>
{%- style -%}
  @media screen and (min-width: 769px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
  @media screen and (max-width: 768px) {
    .section-{{ section.id }}-padding {
      padding: 0;
      padding-top: {{ section.settings.padding_top | times: 0.6 | round: 0 }}px;
    }
  }
{%- endstyle -%}

<div class="gradient section-{{ section.id }}-padding isolate{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}">
  <div class="page-width">
    <div class="how-to-vedio-list">
      <div class="title">
        <h3 class="f-42">HOW-TO-VIDEOS</h3>
        <span class="total-count"></span>
      </div>
      <div class="video-list-box">
        {% assign first_types = metaobjects.video_first_type.values | sort: 'field_name' | reverse %}
        {% assign second_types = metaobjects.video_second_type.values %}
        <div class="video-type">
          <div class="search-input">
            <span class="svg-wrapper">
              {{- 'icon-search.svg' | inline_asset_content -}}
            </span>
            <input type="text" placeholder="Search Support" onkeydown="searchVideoByQuery(event)">
          </div>
          <div class="type-content">
          {% for f_t in first_types %}
            <div class="first-type-box">
              <h4>{{ f_t.name }}</h4>
              <ul class="second-type-box">
              {% for s_t in second_types %}
                {% if s_t.first_type.value == f_t %}
                  <li class="second-type-box-li f-24" onclick="changeVideoType(this)" data-second-type-handle="{{ s_t.name | handle }}">{{ s_t.name }}</li>
                {% endif %}
              {% endfor %}
              </ul>
            </div>
          {% endfor %}
          </div>
          
          <div class="scroll-trigger animate--slide-in m-type-content" data-cascade>
            {% for f_t in first_types %}
              <details>
                <summary>
                  <span class="h4">
                    {{- f_t.name -}}
                  </span>
                </summary>
                <div>
                  <ul class="m-second-type-box list-unstyled" role="list">
                    {%- for s_t in second_types -%}
                      {% if s_t.first_type.value == f_t %}
                      <li class="m-second-type-box-li f-24" onclick="changeVideoType(this)" data-second-type-handle="{{ s_t.name | handle }}">
                        {{ s_t.name }}
                      </li>
                      {% endif %}
                    {%- endfor -%}
                  </ul>
                </div>
              </details>
            {% endfor %}
          </div>
        </div>
        <div class="video-list-content">
            <div class="list-box"></div>
            <div class="rich-text__buttons scroll-trigger animate--slide-in" data-cascade="" style="--animation-order: 0; margin-top: 1rem;">
              <a href="javascript:void(0)" class="button f-22  button--secondary" onclick="loadMoreVideo()">Load More</a>
            </div>
        </div>
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "how to video list",
  "tag": "section",
  "class": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 36
    }
  ],
  "presets": [
    {
      "name": "how to video list"
    }
  ]
}
{% endschema %}
