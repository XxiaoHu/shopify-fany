{{ 'use-cases.css' | asset_url | stylesheet_tag }}
{{ 'main-image-carousel.css' | asset_url | stylesheet_tag }}
<script src="{{ 'use-cases.js' | asset_url }}" defer="defer"></script>

{% style %}
  .section-{{ section.id }}-padding {
    --uc-padding-top: {{ section.settings.padding_top }}px;
    --uc-padding-bottom: {{ section.settings.padding_bottom }}px;
    --uc-safe-margin: {{ section.settings.text_safe_margin }}px;
    --uc-safe-margin-mobile: {{ section.settings.mobile_text_safe_margin }}px;
    --uc-mobile-padding-y: {{ section.settings.mobile_padding_y }}px;
    --uc-image-gap: {{ section.settings.image_gap }}px;
    --uc-mobile-image-gap: {{ section.settings.mobile_image_gap }}px;
    --uc-card-radius: {{ section.settings.card_border_radius }}px;
  }

  /* ---- Header: Title ---- */
  .section-{{ section.id }}-padding .use-cases__title {
    font-weight: {{ section.settings.title_font_weight }};
    font-size: {{ section.settings.title_font_size }}px;
    line-height: {{ section.settings.title_line_height }};
    letter-spacing: {{ section.settings.title_letter_spacing }}px;
    text-align: {{ section.settings.title_alignment }};
    color: {{ section.settings.title_color }};
  }

  /* ---- Header: Description ---- */
  .section-{{ section.id }}-padding .use-cases__description {
    font-weight: {{ section.settings.desc_font_weight }};
    font-size: {{ section.settings.desc_font_size }}px;
    line-height: {{ section.settings.desc_line_height }};
    letter-spacing: {{ section.settings.desc_letter_spacing }}px;
    text-align: {{ section.settings.desc_alignment }};
    color: {{ section.settings.desc_color }};
    {% if section.settings.desc_width != blank and section.settings.desc_width > 0 %}
    max-width: {{ section.settings.desc_width }}px;
    {% endif %}
  }

  /* ---- Header gap ---- */
  .section-{{ section.id }}-padding .use-cases__header {
    --uc-header-gap: {{ section.settings.header_gap }}px;
  }

  @media screen and (max-width: 768px) {
    .section-{{ section.id }}-padding .use-cases__header {
      --uc-mobile-header-gap: {{ section.settings.mobile_header_gap }}px;
    }

    .section-{{ section.id }}-padding .use-cases__title {
      font-size: {{ section.settings.mobile_title_font_size }}px;
    }

    .section-{{ section.id }}-padding .use-cases__description {
      font-size: {{ section.settings.mobile_desc_font_size }}px;
    }
  }

  /* ---- Per-card styles ---- */
  {%- for block in section.blocks -%}
    #UseCaseCard-{{ section.id }}-{{ forloop.index }} {
      --uc-overlay-opacity: {{ block.settings.overlay_opacity | divided_by: 100.0 }};
    }

    #UseCaseCard-{{ section.id }}-{{ forloop.index }} .use-cases__card-text {
      {%- if block.settings.card_text_font_weight == '700_italic' -%}
        font-weight: 700;
        font-style: italic;
      {%- else -%}
        font-weight: {{ block.settings.card_text_font_weight }};
        font-style: normal;
      {%- endif -%}
      font-size: {{ block.settings.card_text_font_size }}px;
      line-height: {{ block.settings.card_text_line_height }};
      letter-spacing: {{ block.settings.card_text_letter_spacing }}px;
      color: {{ block.settings.card_text_color }};
      text-shadow: 0 0 4px rgba(0, 0, 0, 0.25);
    }

    @media screen and (max-width: 768px) {
      #UseCaseCard-{{ section.id }}-{{ forloop.index }} .use-cases__card-text {
        font-size: {{ block.settings.mobile_card_text_font_size }}px;
      }
    }
  {%- endfor -%}
{% endstyle %}

<div class="use-cases section-{{ section.id }}-padding">
  {%- if section.settings.title != blank or section.settings.description != blank -%}
    <div class="use-cases__header">
      {%- if section.settings.title != blank -%}
        <h2 class="use-cases__title inline-richtext">
          {{ section.settings.title }}
        </h2>
      {%- endif -%}
      {%- if section.settings.description != blank -%}
        <div class="use-cases__description rte">
          {{ section.settings.description }}
        </div>
      {%- endif -%}
    </div>
  {%- endif -%}

  <div class="use-cases__grid">
    {%- liquid
      assign card_index = 0
    -%}
    {%- for block in section.blocks -%}
      {%- liquid
        assign mod = forloop.index0 | modulo: 2
        assign card_index = forloop.index
      -%}
      {%- if mod == 0 -%}
        <div class="use-cases__row">
      {%- endif -%}

      <div
        class="use-cases__card"
        id="UseCaseCard-{{ section.id }}-{{ card_index }}"
        {{ block.shopify_attributes }}
      >
        <button
          type="button"
          class="use-cases__card-trigger"
          data-use-case-modal-id="UseCaseModal-{{ section.id }}-{{ block.id }}"
          aria-haspopup="dialog"
          aria-controls="UseCaseModal-{{ section.id }}-{{ block.id }}"
        >
          <span class="visually-hidden">
            {{- block.settings.card_text | default: block.settings.title | default: block.settings.image.alt | escape -}}
          </span>
        </button>

        {%- if block.settings.image != blank -%}
          {{
            block.settings.image
            | image_url: width: 1504
            | image_tag:
              class: 'use-cases__card-image',
              loading: 'lazy',
              sizes: '(max-width: 768px) 100vw, 50vw',
              widths: '375, 550, 752, 1100, 1504'
          }}
        {%- else -%}
          <div class="use-cases__card-image" style="background: #f7f7f7;">
            {{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}
          </div>
        {%- endif -%}

        {%- if block.settings.card_text != blank -%}
          <p class="use-cases__card-text">{{ block.settings.card_text | escape }}</p>
        {%- endif -%}
      </div>

      {%- if mod == 1 or forloop.last -%}
        </div>
      {%- endif -%}
    {%- else -%}
      {%- comment -%}Empty state placeholder{%- endcomment -%}
      <div class="use-cases__row">
        {%- for i in (1..2) -%}
          <div class="use-cases__card">
            <div class="use-cases__card-image" style="background: #f7f7f7;">
              {{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}
            </div>
          </div>
        {%- endfor -%}
      </div>
      <div class="use-cases__row">
        {%- for i in (1..2) -%}
          <div class="use-cases__card">
            <div class="use-cases__card-image" style="background: #f7f7f7;">
              {{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}
            </div>
          </div>
        {%- endfor -%}
      </div>
    {%- endfor -%}
  </div>
</div>

{%- for block in section.blocks -%}
  <div
    class="modal-overlay use-cases__modal"
    id="UseCaseModal-{{ section.id }}-{{ block.id }}"
    role="dialog"
    aria-modal="true"
    aria-hidden="true"
    {% if block.settings.title != blank %}
      aria-labelledby="UseCaseModalTitle-{{ section.id }}-{{ block.id }}"
    {% else %}
      aria-label="{{ block.settings.card_text | default: 'Use case details' | escape }}"
    {% endif %}
  >
    <div class="modal-content">
      <button type="button" class="modal-close" aria-label="Close">
        <svg xmlns="http://www.w3.org/2000/svg" width="29" height="29" viewBox="0 0 29 29" fill="none" aria-hidden="true">
          <path d="M7.11095 7.1084L14.2221 14.2195L21.3332 7.1084M7.11098 21.3359L14.2221 14.2247L21.3332 21.3359" stroke="white" stroke-width="2.37037" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </button>

      <div class="modal-wrapper">
        <div class="modal-img-wrapper">
          {%- if block.settings.modal_image != blank -%}
            <picture>
              {%- if block.settings.mobile_modal_image != blank -%}
                <source
                  media="(max-width: 1260px)"
                  srcset="{{ block.settings.mobile_modal_image | image_url: width: 1260 }}"
                >
              {%- endif -%}
              {{
                block.settings.modal_image
                | image_url: width: 2400
                | image_tag: loading: 'lazy', widths: '550, 750, 1100, 1500, 2000, 2400'
              }}
            </picture>
          {%- endif -%}
        </div>

        <div class="modal-text-wrapper">
          {%- if block.settings.eye_brow_label != blank or block.settings.eye_brow_value != blank -%}
            <div class="modal-eyebrow-section">
              <div class="eye-brow-label">{{ block.settings.eye_brow_label }}</div>
              <div class="eye-brow-value">{{ block.settings.eye_brow_value }}</div>
            </div>
          {%- endif -%}
          {%- if block.settings.title != blank -%}
            <h2 class="modal-title" id="UseCaseModalTitle-{{ section.id }}-{{ block.id }}">
              {{ block.settings.title }}
            </h2>
          {%- endif -%}
          {%- if block.settings.des1 != blank -%}
            <div class="modal-desc">{{ block.settings.des1 }}</div>
          {%- endif -%}
          {%- if block.settings.eyebrow != blank or block.settings.comment != blank or block.settings.author != blank -%}
            <div class="modal-testimonial">
              <div class="quote-eyebrow">{{ block.settings.eyebrow }}</div>
              <div class="testimonial-text">{{ block.settings.comment }}</div>
              <div class="testimonial-author">{{ block.settings.author }}</div>
            </div>
          {%- endif -%}
          {%- if block.settings.des2 != blank -%}
            <div class="modal-other-desc">{{ block.settings.des2 }}</div>
          {%- endif -%}
        </div>
      </div>
    </div>
  </div>
{%- endfor -%}

{%- if request.design_mode -%}
  <script src="{{ 'theme-editor.js' | asset_url }}" defer="defer"></script>
{%- endif -%}

{% schema %}
{
  "name": "使用场景",
  "tag": "section",
  "class": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "header",
      "content": "标题与描述"
    },
    {
      "type": "inline_richtext",
      "id": "title",
      "default": "Get a complete picture of your health",
      "label": "标题文本"
    },
    {
      "type": "range",
      "id": "title_font_size",
      "min": 14,
      "max": 60,
      "step": 1,
      "unit": "px",
      "label": "标题字号-桌面端",
      "default": 28
    },
    {
      "type": "range",
      "id": "mobile_title_font_size",
      "min": 12,
      "max": 48,
      "step": 1,
      "unit": "px",
      "label": "标题字号-移动端",
      "default": 24
    },
    {
      "type": "select",
      "id": "title_font_weight",
      "options": [
        { "value": "300", "label": "Light (300)" },
        { "value": "400", "label": "Regular (400)" },
        { "value": "500", "label": "Medium (500)" },
        { "value": "600", "label": "Semi Bold (600)" },
        { "value": "700", "label": "Bold (700)" },
        { "value": "800", "label": "Extra Bold (800)" }
      ],
      "default": "700",
      "label": "标题字重"
    },
    {
      "type": "range",
      "id": "title_line_height",
      "min": 0.8,
      "max": 2.5,
      "step": 0.1,
      "label": "标题行高",
      "default": 1.2
    },
    {
      "type": "range",
      "id": "title_letter_spacing",
      "min": -5,
      "max": 20,
      "step": 0.5,
      "unit": "px",
      "label": "标题字距",
      "default": 0
    },
    {
      "type": "select",
      "id": "title_alignment",
      "options": [
        { "value": "left", "label": "左对齐" },
        { "value": "center", "label": "居中" },
        { "value": "right", "label": "右对齐" }
      ],
      "default": "left",
      "label": "标题对齐"
    },
    {
      "type": "color",
      "id": "title_color",
      "label": "标题颜色",
      "default": "#1e0e06"
    },
    {
      "type": "richtext",
      "id": "description",
      "default": "<p>With 24/7 monitoring across sleep, strain, stress, and heart health, FANY gives you a complete view of your health - so you can make smarter decisions every day.</p>",
      "label": "描述文本"
    },
    {
      "type": "range",
      "id": "desc_font_size",
      "min": 12,
      "max": 36,
      "step": 1,
      "unit": "px",
      "label": "描述字号-桌面端",
      "default": 16
    },
    {
      "type": "range",
      "id": "mobile_desc_font_size",
      "min": 10,
      "max": 28,
      "step": 1,
      "unit": "px",
      "label": "描述字号-移动端",
      "default": 16
    },
    {
      "type": "select",
      "id": "desc_font_weight",
      "options": [
        { "value": "300", "label": "Light (300)" },
        { "value": "400", "label": "Regular (400)" },
        { "value": "500", "label": "Medium (500)" },
        { "value": "600", "label": "Semi Bold (600)" },
        { "value": "700", "label": "Bold (700)" }
      ],
      "default": "400",
      "label": "描述字重"
    },
    {
      "type": "range",
      "id": "desc_line_height",
      "min": 0.8,
      "max": 2.5,
      "step": 0.1,
      "label": "描述行高",
      "default": 1.5
    },
    {
      "type": "range",
      "id": "desc_letter_spacing",
      "min": -5,
      "max": 20,
      "step": 0.5,
      "unit": "px",
      "label": "描述字距",
      "default": 0
    },
    {
      "type": "select",
      "id": "desc_alignment",
      "options": [
        { "value": "left", "label": "左对齐" },
        { "value": "center", "label": "居中" },
        { "value": "right", "label": "右对齐" }
      ],
      "default": "left",
      "label": "描述对齐"
    },
    {
      "type": "color",
      "id": "desc_color",
