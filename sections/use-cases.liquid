      "max": 400,
      "step": 10,
      "unit": "px",
      "label": "安全边距-桌面端",
      "default": 200
    },
    {
      "type": "range",
      "id": "mobile_text_safe_margin",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "安全边距-移动端",
      "default": 16
    },
    {
