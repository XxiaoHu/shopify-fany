{{ 'featured-product-showcase.css' | asset_url | stylesheet_tag }}
<script src="{{ 'featured-product-showcase.js' | asset_url }}" defer="defer"></script>

{%- liquid
  assign feature_desktop_image = section.settings.feature_desktop_image
  assign feature_mobile_image = section.settings.feature_mobile_image
  assign feature_fallback_image = feature_desktop_image | default: feature_mobile_image
  assign desktop_gap_total_cqi = section.settings.desktop_columns | minus: 1 | times: 32.0 | divided_by: 15.2
-%}

<featured-product-showcase
  id="FeaturedProductShowcase-{{ section.id }}"
  class="featured-product-showcase"
  data-desktop-columns="{{ section.settings.desktop_columns }}"
  style="
    --fps-background: {{ section.settings.background_color }};
    --fps-heading-color: {{ section.settings.heading_color }};
    --fps-description-color: {{ section.settings.description_color }};
    --fps-card-heading-color: {{ section.settings.card_heading_color }};
    --fps-card-description-color: {{ section.settings.card_description_color }};
    --fps-media-background: {{ section.settings.media_background_color }};
    --fps-desktop-columns: {{ section.settings.desktop_columns }};
    --fps-mobile-columns: {{ section.settings.mobile_columns }};
    --fps-desktop-card-width: calc((100% - {{ desktop_gap_total_cqi }}cqi) / {{ section.settings.desktop_columns }});
    --fps-desktop-heading-width: {{ section.settings.desktop_heading_width }}px;
    --fps-desktop-description-width: {{ section.settings.desktop_description_width }}px;
    --fps-desktop-heading-size: {{ section.settings.desktop_heading_size }}px;
    --fps-desktop-heading-line-height: {{ section.settings.desktop_heading_line_height | divided_by: 100.0 }};
    --fps-desktop-description-size: {{ section.settings.desktop_description_size }}px;
    --fps-desktop-description-line-height: {{ section.settings.desktop_description_line_height | divided_by: 100.0 }};
    --fps-desktop-card-heading-size: {{ section.settings.desktop_card_heading_size }}px;
    --fps-desktop-card-heading-line-height: {{ section.settings.desktop_card_heading_line_height | divided_by: 100.0 }};
    --fps-desktop-card-description-size: {{ section.settings.desktop_card_description_size }}px;
    --fps-desktop-card-description-line-height: {{ section.settings.desktop_card_description_line_height | divided_by: 100.0 }};
    --fps-mobile-heading-size: {{ section.settings.mobile_heading_size }}px;
    --fps-mobile-heading-line-height: {{ section.settings.mobile_heading_line_height | divided_by: 100.0 }};
    --fps-mobile-description-size: {{ section.settings.mobile_description_size }}px;
    --fps-mobile-description-line-height: {{ section.settings.mobile_description_line_height | divided_by: 100.0 }};
    --fps-mobile-heading-width: {{ section.settings.mobile_heading_width }}px;
    --fps-mobile-description-width: {{ section.settings.mobile_description_width }}px;
    --fps-mobile-card-heading-size: {{ section.settings.mobile_card_heading_size }}px;
    --fps-mobile-card-heading-line-height: {{ section.settings.mobile_card_heading_line_height | divided_by: 100.0 }};
    --fps-mobile-card-description-size: {{ section.settings.mobile_card_description_size }}px;
    --fps-mobile-card-description-line-height: {{ section.settings.mobile_card_description_line_height | divided_by: 100.0 }};
    --fps-desktop-padding-top: {{ section.settings.desktop_padding_top }}px;
    --fps-desktop-padding-bottom: {{ section.settings.desktop_padding_bottom }}px;
    --fps-mobile-padding-top: {{ section.settings.mobile_padding_top }}px;
    --fps-mobile-padding-bottom: {{ section.settings.mobile_padding_bottom }}px;
  "
>
  {%- if section.settings.navigation_anchor != blank -%}
    <span
      id="FeaturedProductShowcaseAnchor-{{ section.id }}"
      class="featured-product-showcase__anchor"
      data-navigation-anchor="{{ section.settings.navigation_anchor | handleize }}"
      aria-hidden="true"
    ></span>
  {%- endif -%}

  <div class="featured-product-showcase__inner">
    {%- if section.settings.heading != blank or section.settings.description != blank -%}
      <div class="featured-product-showcase__header">
        {%- if section.settings.heading != blank -%}
          <h2 class="featured-product-showcase__heading">{{ section.settings.heading }}</h2>
        {%- endif -%}
        {%- if section.settings.description != blank -%}
          <div class="featured-product-showcase__description rte">{{ section.settings.description }}</div>
        {%- endif -%}
      </div>
    {%- endif -%}

    <div class="featured-product-showcase__content{% if feature_fallback_image == blank and request.design_mode == false %} featured-product-showcase__content--without-feature{% endif %}">
      {%- if feature_fallback_image != blank or request.design_mode -%}
        <div class="featured-product-showcase__feature">
          {%- if section.settings.feature_link != blank -%}
            <a class="featured-product-showcase__feature-link" href="{{ section.settings.feature_link }}">
          {%- else -%}
            <div class="featured-product-showcase__feature-link">
          {%- endif -%}
              {%- if feature_fallback_image != blank -%}
                <picture class="featured-product-showcase__feature-picture">
                  {%- if feature_mobile_image != blank -%}
                    <source
                      media="(max-width: 749px)"
                      srcset="
                        {{ feature_mobile_image | image_url: width: 480 }} 480w,
                        {{ feature_mobile_image | image_url: width: 750 }} 750w,
                        {{ feature_mobile_image | image_url: width: 1000 }} 1000w
                      "
                      sizes="calc(100vw - 32px)"
                    >
                  {%- endif -%}
                  {{
                    feature_fallback_image
                    | image_url: width: 1200
                    | image_tag:
                      class: 'featured-product-showcase__feature-image',
                      loading: 'lazy',
                      widths: '480, 750, 900, 1200',
                      sizes: '(max-width: 749px) calc(100vw - 32px), 388px',
                      alt: section.settings.feature_image_alt
                  }}
                </picture>
              {%- elsif request.design_mode -%}
                {{ 'lifestyle-1' | placeholder_svg_tag: 'featured-product-showcase__feature-placeholder placeholder-svg' }}
              {%- endif -%}
          {%- if section.settings.feature_link != blank -%}
            </a>
          {%- else -%}
            </div>
          {%- endif -%}
        </div>
      {%- endif -%}

      {%- if section.blocks.size > 0 -%}
        <div class="featured-product-showcase__products">
          <button
            class="featured-product-showcase__arrow featured-product-showcase__arrow--previous"
            type="button"
            data-fps-previous
            aria-label="上一组产品"
            aria-controls="FeaturedProductTrack-{{ section.id }}"
          >
            <img src="{{ 'featured-showcase-arrow-prev.svg' | asset_url }}" width="50" height="50" alt="">
          </button>

          <div
            id="FeaturedProductTrack-{{ section.id }}"
            class="featured-product-showcase__track"
            data-fps-track
            tabindex="0"
            role="region"
            aria-roledescription="carousel"
            aria-label="{{ section.settings.carousel_label | escape }}"
          >
            {%- for block in section.blocks -%}
              {%- liquid
                assign desktop_image = block.settings.desktop_image
                assign mobile_image = block.settings.mobile_image
                assign fallback_image = desktop_image | default: mobile_image
              -%}
              <article
                id="FeaturedProductCard-{{ section.id }}-{{ block.id }}"
                class="featured-product-showcase__card"
                data-fps-card
                {{ block.shopify_attributes }}
              >
                {%- if block.settings.link != blank -%}
                  <a class="featured-product-showcase__card-link" href="{{ block.settings.link }}">
                {%- else -%}
                  <div class="featured-product-showcase__card-link">
                {%- endif -%}
                    <div class="featured-product-showcase__card-media">
                      {%- if fallback_image != blank -%}
                        <picture class="featured-product-showcase__card-picture">
                          {%- if mobile_image != blank -%}
                            <source
                              media="(max-width: 749px)"
                              srcset="
                                {{ mobile_image | image_url: width: 240 }} 240w,
                                {{ mobile_image | image_url: width: 400 }} 400w,
                                {{ mobile_image | image_url: width: 600 }} 600w
                              "
                              sizes="calc((100vw - 32px) / {{ section.settings.mobile_columns }})"
                            >
                          {%- endif -%}
                          {%- capture card_sizes -%}(max-width: 749px) calc((100vw - 32px) / {{ section.settings.mobile_columns }}), 330px{%- endcapture -%}
                          {{
                            fallback_image
                            | image_url: width: 900
                            | image_tag:
                              class: 'featured-product-showcase__card-image',
                              loading: 'lazy',
                              widths: '240, 400, 600, 750, 900',
                              sizes: card_sizes,
                              alt: block.settings.image_alt
                          }}
                        </picture>
                      {%- elsif request.design_mode -%}
                        {{ 'product-1' | placeholder_svg_tag: 'featured-product-showcase__card-placeholder placeholder-svg' }}
                      {%- endif -%}
                    </div>

                    {%- if block.settings.heading != blank or block.settings.description != blank -%}
                      <div class="featured-product-showcase__card-copy">
                        {%- if block.settings.heading != blank -%}
                          <h3 class="featured-product-showcase__card-heading">{{ block.settings.heading | escape }}</h3>
                        {%- endif -%}
                        {%- if block.settings.description != blank -%}
                          <p class="featured-product-showcase__card-description">{{ block.settings.description | escape }}</p>
                        {%- endif -%}
                      </div>
                    {%- endif -%}
                {%- if block.settings.link != blank -%}
                  </a>
                {%- else -%}
                  </div>
                {%- endif -%}
              </article>
            {%- endfor -%}
          </div>

          <button
            class="featured-product-showcase__arrow featured-product-showcase__arrow--next"
            type="button"
            data-fps-next
            aria-label="下一组产品"
            aria-controls="FeaturedProductTrack-{{ section.id }}"
          >
            <img src="{{ 'featured-showcase-arrow-next.svg' | asset_url }}" width="50" height="50" alt="">
          </button>
        </div>
      {%- elsif request.design_mode -%}
        <p class="featured-product-showcase__empty">请添加产品卡片</p>
      {%- endif -%}
    </div>
  </div>
</featured-product-showcase>

{% schema %}
{
  "name": "主视觉产品展示",
  "tag": "section",
  "class": "section",
  "disabled_on": { "groups": ["header", "footer"] },
  "settings": [
    { "type": "header", "content": "内容" },
    { "type": "inline_richtext", "id": "heading", "label": "标题", "default": "Women's Equality Day" },
    { "type": "richtext", "id": "description", "label": "描述", "default": "<p>Distinct silhouettes and thoughtful details. This season’s watches explore texture, proportion, and finish with quiet confidence.</p>" },
    { "type": "text", "id": "navigation_anchor", "label": "导航锚点", "info": "用于吸顶导航跳转，例如 womens-equality；同一页面不能重复。" },
    { "type": "text", "id": "carousel_label", "label": "轮播无障碍名称", "default": "节日产品" },

    { "type": "header", "content": "主视觉图片" },
    { "type": "image_picker", "id": "feature_desktop_image", "label": "PC 主视觉图片" },
    { "type": "image_picker", "id": "feature_mobile_image", "label": "移动端主视觉图片", "info": "留空时自动使用 PC 图片。" },
    { "type": "text", "id": "feature_image_alt", "label": "主视觉替代文字" },
    { "type": "url", "id": "feature_link", "label": "主视觉链接" },

    { "type": "header", "content": "布局与显示数量" },
    { "type": "range", "id": "desktop_columns", "min": 1, "max": 4, "step": 1, "label": "PC 每屏产品数量", "default": 3 },
    { "type": "range", "id": "mobile_columns", "min": 1, "max": 3, "step": 1, "label": "移动端每行产品数量", "default": 2 },

    { "type": "header", "content": "颜色" },
    { "type": "color", "id": "background_color", "label": "背景颜色", "default": "#ffffff" },
    { "type": "color", "id": "heading_color", "label": "标题颜色", "default": "#1e0e06" },
    { "type": "color", "id": "description_color", "label": "描述颜色", "default": "#686766" },
    { "type": "color", "id": "card_heading_color", "label": "卡片标题颜色", "default": "#1e0e06" },
    { "type": "color", "id": "card_description_color", "label": "卡片描述颜色", "default": "#686766" },
    { "type": "color", "id": "media_background_color", "label": "图片区域背景颜色", "default": "#f7f7f7" },

    { "type": "header", "content": "PC 字号与行高" },
    { "type": "range", "id": "desktop_heading_width", "min": 160, "max": 1200, "step": 16, "unit": "px", "label": "标题宽度", "default": 416 },
    { "type": "range", "id": "desktop_description_width", "min": 160, "max": 1200, "step": 16, "unit": "px", "label": "描述宽度", "default": 576 },
    { "type": "range", "id": "desktop_heading_size", "min": 16, "max": 56, "step": 1, "unit": "px", "label": "标题字号", "default": 28 },
    { "type": "range", "id": "desktop_heading_line_height", "min": 80, "max": 200, "step": 5, "unit": "%", "label": "标题行高", "default": 120 },
    { "type": "range", "id": "desktop_description_size", "min": 12, "max": 32, "step": 1, "unit": "px", "label": "描述字号", "default": 16 },
    { "type": "range", "id": "desktop_description_line_height", "min": 100, "max": 220, "step": 5, "unit": "%", "label": "描述行高", "default": 150 },
    { "type": "range", "id": "desktop_card_heading_size", "min": 12, "max": 36, "step": 1, "unit": "px", "label": "卡片标题字号", "default": 20 },
    { "type": "range", "id": "desktop_card_heading_line_height", "min": 80, "max": 200, "step": 5, "unit": "%", "label": "卡片标题行高", "default": 120 },
    { "type": "range", "id": "desktop_card_description_size", "min": 10, "max": 28, "step": 1, "unit": "px", "label": "卡片描述字号", "default": 16 },
    { "type": "range", "id": "desktop_card_description_line_height", "min": 100, "max": 220, "step": 5, "unit": "%", "label": "卡片描述行高", "default": 150 },

    { "type": "header", "content": "移动端字号与行高" },
    { "type": "range", "id": "mobile_heading_width", "min": 120, "max": 500, "step": 4, "unit": "px", "label": "标题宽度", "default": 300 },
    { "type": "range", "id": "mobile_description_width", "min": 120, "max": 500, "step": 4, "unit": "px", "label": "描述宽度", "default": 356 },
    { "type": "range", "id": "mobile_heading_size", "min": 16, "max": 40, "step": 1, "unit": "px", "label": "标题字号", "default": 24 },
    { "type": "range", "id": "mobile_heading_line_height", "min": 80, "max": 200, "step": 5, "unit": "%", "label": "标题行高", "default": 120 },
    { "type": "range", "id": "mobile_description_size", "min": 12, "max": 28, "step": 1, "unit": "px", "label": "描述字号", "default": 16 },
    { "type": "range", "id": "mobile_description_line_height", "min": 100, "max": 220, "step": 5, "unit": "%", "label": "描述行高", "default": 150 },
    { "type": "range", "id": "mobile_card_heading_size", "min": 12, "max": 28, "step": 1, "unit": "px", "label": "卡片标题字号", "default": 16 },
    { "type": "range", "id": "mobile_card_heading_line_height", "min": 80, "max": 200, "step": 5, "unit": "%", "label": "卡片标题行高", "default": 120 },
    { "type": "range", "id": "mobile_card_description_size", "min": 10, "max": 24, "step": 1, "unit": "px", "label": "卡片描述字号", "default": 14 },
    { "type": "range", "id": "mobile_card_description_line_height", "min": 100, "max": 220, "step": 5, "unit": "%", "label": "卡片描述行高", "default": 150 },

    { "type": "header", "content": "上下间距" },
    { "type": "range", "id": "desktop_padding_top", "min": 0, "max": 160, "step": 4, "unit": "px", "label": "PC 上间距", "default": 80 },
    { "type": "range", "id": "desktop_padding_bottom", "min": 0, "max": 160, "step": 4, "unit": "px", "label": "PC 下间距", "default": 80 },
    { "type": "range", "id": "mobile_padding_top", "min": 0, "max": 120, "step": 4, "unit": "px", "label": "移动端上间距", "default": 40 },
    { "type": "range", "id": "mobile_padding_bottom", "min": 0, "max": 120, "step": 4, "unit": "px", "label": "移动端下间距", "default": 40 }
  ],
  "blocks": [
    {
      "type": "product_card",
      "name": "产品卡片",
      "settings": [
        { "type": "image_picker", "id": "desktop_image", "label": "PC 图片" },
        { "type": "image_picker", "id": "mobile_image", "label": "移动端图片", "info": "留空时自动使用 PC 图片。" },
        { "type": "text", "id": "image_alt", "label": "图片替代文字" },
        { "type": "text", "id": "heading", "label": "标题", "default": "Surf Holiday" },
        { "type": "textarea", "id": "description", "label": "描述", "default": "Design Story: Ride the golden sunset waves into late-summer freedom; relaxation is the true spirit of" },
        { "type": "url", "id": "link", "label": "链接" }
      ]
    }
  ],
  "presets": [
    {
      "name": "主视觉产品展示",
      "blocks": [
        { "type": "product_card" },
        { "type": "product_card" },
        { "type": "product_card" },
        { "type": "product_card" }
      ]
    }
  ]
}
{% endschema %}
