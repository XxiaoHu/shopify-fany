{{ 'user-manual-files.css' | asset_url | stylesheet_tag }}
{%- style -%}
  @media screen and (min-width: 769px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
  @media screen and (max-width: 768px) {
    .section-{{ section.id }}-padding {
      padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
      padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    }
  }
{%- endstyle -%}

<div class="gradient section-{{ section.id }}-padding isolate{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}">
  <div class="page-width">
    <div class="user-manual-file-box">
      <div class="files-box">
        <h1>{{ section.settings.header }}</h1>
        {{ section.settings.text | replace: '<p', '<p class="f-30"' }}
        {% if section.settings.files != blank %}
          {% assign files = metaobjects['download_file'][section.settings.files].files.value %}
          <ul>
            {% for file in files %}
              <li>
                <a download="" href="{{ file.url }}"> 
                  {% assign filename = file.alt %}
                  {% if filename == null %}
                    {% assign filename = file.url | split: '?' | first | split: '/' | last %}
                  {% endif %}
                  <span>{{ filename }}</span>
                  <span class="svg-wrapper">
                    {{- 'icon-download.svg' | inline_asset_content -}}
                  </span>
                </a>
              </li>
            {% endfor %}
          </ul>
        {% endif %}
      </div>
      <div class="img-box">
        {% if section.settings.image != blank %}
          <img
            src="{{ section.settings.image | image_url: width: section.settings.image.width }}"
            sizes="(min-width: {{ settings.page_width }}px) {{ settings.page_width | minus: 100 | divided_by: 2 }}px, (min-width: 750px) calc((100vw - 130px) / 2), calc((100vw - 50px) / 2)"
            class="motion-reduce"
            loading="lazy"
            width="{{ section.settings.image.width }}"
            height="{{ section.settings.image.height }}"
          >
        {% endif %}
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "user manual files",
  "tag": "section",
  "class": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "图片"
    },
    {
      "type": "inline_richtext",
      "id": "header",
      "label": "标题"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "描述"
    },
    {
      "type": "metaobject",
      "id": "files",
      "label": "文件组",
      "metaobject_type": "download_file"
    },
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 36
    }
  ],
  "presets": [
    {
      "name": "user manual files"
    }
  ]
}
{% endschema %}
