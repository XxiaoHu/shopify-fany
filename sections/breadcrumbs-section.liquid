{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
    padding-left: {{ section.settings.padding_left | times: 0.75 | round: 0 }}px;
    padding-right: {{ section.settings.padding_right | times: 0.75 | round: 0 }}px;
  }
  .section-{{ section.id }}-padding .breadcrumb {
    font-size: {{ section.settings.desktop_font_size | times: 0.75 | round: 0 }}px;
  }

  @media screen and (max-width: 768px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top_mobile }}px;
      padding-bottom: {{ section.settings.padding_bottom_mobile }}px;
      padding-left: {{ section.settings.padding_left_mobile }}px;
      padding-right: {{ section.settings.padding_right_mobile }}px;
    }
    .section-{{ section.id }}-padding .breadcrumb {
      font-size: {{ section.settings.mobile_font_size }}px;
    }
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
      padding-left: {{ section.settings.padding_left }}px;
      padding-right: {{ section.settings.padding_right }}px;
    }
    .section-{{ section.id }}-padding .breadcrumb {
      font-size: {{ section.settings.desktop_font_size }}px;
    }
  }
{%- endstyle -%}

<div class="color-{{ section.settings.color_scheme }} isolate gradient section-{{ section.id }}-padding">
  <div class="page-width" style="padding: 0;">
    {% render 'breadcrumbs', parent_label: section.settings.parent_label, parent_link: section.settings.parent_link %}
  </div>
</div>

{% schema %}
{
  "name": "面包屑导航",
  "tag": "section",
  "class": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "上级页面"
    },
    {
      "type": "text",
      "id": "parent_label",
      "label": "上级页面名称",
      "info": "留空时不显示上级页面"
    },
    {
      "type": "url",
      "id": "parent_link",
      "label": "上级页面链接"
    },
    {
      "type": "header",
      "content": "桌面端边距"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 12
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 12
    },
    {
      "type": "range",
      "id": "padding_left",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_left",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_right",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_right",
      "default": 0
    },
    {
      "type": "header",
      "content": "手机端边距"
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 12
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 12
    },
    {
      "type": "range",
      "id": "padding_left_mobile",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_left",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_right_mobile",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_right",
      "default": 0
    },
    {
      "type": "header",
      "content": "字体大小"
    },
    {
      "type": "range",
      "id": "desktop_font_size",
      "min": 12,
      "max": 48,
      "step": 2,
      "unit": "px",
      "label": "桌面端字体大小",
      "default": 28
    },
    {
      "type": "range",
      "id": "mobile_font_size",
      "min": 12,
      "max": 40,
      "step": 2,
      "unit": "px",
      "label": "手机端字体大小",
      "default": 28
    }
  ],
  "presets": [
    {
      "name": "面包屑导航"
    }
  ]
}
{% endschema %}
