            },
            {
              "value": "f-28",
              "label": "大小28"
            },
            {
              "value": "f-36",
              "label": "大小36"
            }
          ],
          "default": "h1",
          "label": "t:sections.all.heading_size.label"
        },
        {
          "type": "number",
          "id": "heading_width",
          "label": "标题宽度",
          "default": 600
        },
      ]
    },
