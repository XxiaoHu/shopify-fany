{{ 'herhub-special-backgroup.css' | asset_url | stylesheet_tag }}
{% liquid
  assign image-radio = 1
%}

{%- style -%}
  {% if section.settings.back_image != blank %}
    {% liquid assign image-radio = section.settings.back_image.aspect_ratio %}
    .herhub-page-width{
      --back-radio: {{image-radio}};
    }
    .herhub-{{ section.id }}-back-image-left{
      bottom: 0;
      left: 0;
      background-image: url("{{section.settings.back_image | image_url: width: section.settings.back_image.width}}");
      width: {{section.settings.back_image.width}}px;
    }
    .herhub-{{ section.id }}-back-image-right{
        bottom: 0;
        right: 0;
        background-image: url("{{section.settings.back_image | image_url: width: section.settings.back_image.width}}");
        width: {{section.settings.back_image.width}}px;
      }
  {% endif %}
  .herhub-{{ section.id }}-special-box{
    --box-padding: 120px;
    --herhub-special-backgroup-column-gap: 100px;
    display: flex;
    flex-wrap: wrap;
    column-gap: var(--herhub-special-backgroup-column-gap);
  }
  @media screen and (max-width: 1500px){
    .herhub-{{ section.id }}-special-box{
    --herhub-special-backgroup-column-gap: 0px;
  }
  }
  .herhub-{{ section.id }}-special-box .herhub-special-back-item:nth-child(1){
    width: calc({{section.settings.left-radio}}% - var(--herhub-special-backgroup-column-gap) * {{section.settings.left-radio}} /100);
    max-width: calc({{section.settings.left-radio}}% - var(--herhub-special-backgroup-column-gap) * {{section.settings.left-radio}} /100);
  }

  .herhub-{{ section.id }}-special-box .herhub-special-back-item:nth-child(2){
    width: calc({{ 100 | minus: section.settings.left-radio }}% - var(--herhub-special-backgroup-column-gap) * {{ 100 | minus: section.settings.left-radio }} /100);
    max-width: calc({{ 100 | minus: section.settings.left-radio }}% - var(--herhub-special-backgroup-column-gap) * {{ 100 | minus: section.settings.left-radio }} /100);
  }

  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.6 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.6 | round: 0 }}px;
  }

  @media screen and (min-width: 769px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

<div class="section-{{ section.id }}-padding color-{{ section.settings.section_color_scheme }}">
  <div class="herhub-page-width page-width-{{ section.settings.back_image_from }}">
    <div
      class="herhub-image-back {% if section.settings.back_image != blank %} herhub-{{ section.id }}-back-image-{{ section.settings.back_image_from }} {% endif %}"
    ></div>
    <div class="herhub-special-backgroup-box herhub-{{ section.id }}-special-box">
      {% for block in section.blocks %}
        {% case block.type %}
          {%- when 'text' -%}
            <div class="herhub-special-back-item m-text-back-box">
              <div class="text-box" style="max-width: {{ block.settings.text_width }}px;">
                <div class="f-24">{{ block.settings.heading }}</div>
                {% if block.settings.text != blank %}
                  <div class="f-24">{{ block.settings.text }}</div>
                {% endif %}
              </div>
            </div>
          {%- when 'image' -%}
            <div class="herhub-special-back-item m-herhub-special-image-box">
              <div
                class="m-herhub-image-back  {% if section.settings.back_image != blank %} herhub-{{ section.id }}-back-image-{{ section.settings.back_image_from }} {% endif %}"
              ></div>
              <div class="herhub-special-image-box" style="align-content: {{ block.settings.image_position }};">
                {{ block.settings.image | image_url: width: block.settings.image.width | image_tag }}
              </div>
            </div>
        {% endcase %}
      {% endfor %}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "herhub特殊背景",
  "class": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 36
    },
    {
      "type": "range",
      "id": "left-radio",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "%",
      "label": "左侧模块占比",
      "default": 40
    },
    {
      "type": "image_picker",
      "id": "back_image",
      "label": "背景图"
    },
    {
      "type": "select",
      "id": "back_image_from",
      "label": "背景图位置",
      "options": [
        {
          "value": "left",
          "label": "优先"
        },
        {
          "value": "right",
          "label": "置后"
        }
      ],
      "default": "left"
    }
  ],
  "blocks": [
    {
      "type": "text",
      "name": "文字模块",
      "limit": 1,
      "settings": [
        {
          "type": "richtext",
          "id": "heading",
          "default": "t:sections.image-with-text.blocks.heading.settings.heading.default",
          "label": "t:sections.image-with-text.blocks.heading.settings.heading.label"
        },
        {
          "type": "number",
          "id": "heading_width",
          "label": "标题宽度",
          "default": 600
        },
        {
          "type": "number",
          "id": "text_width",
          "label": "文本宽度",
          "default": 700
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "文本"
        }
      ]
    },
    {
      "type": "image",
      "name": "图片",
      "limit": 1,
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "图片"
        },
        {
          "type": "select",
          "id": "image_position",
          "label": "图片竖向位置",
          "options": [
            {
              "value": "center",
              "label": "居中"
            },
            {
              "value": "flex-end",
              "label": "底部"
            }
          ],
          "default": "center"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "herhub特殊背景"
    }
  ]
}
{% endschema %}
