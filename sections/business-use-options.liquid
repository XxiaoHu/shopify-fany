{{ 'business-use-options.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign cta_link = section.settings.cta_link | default: '#business-inquiry'
-%}

<section
  id="BusinessUseOptions-{{ section.id }}"
  class="business-use-options"
  style="
    --buo-background: {{ section.settings.background }};
    --buo-eyebrow-color: {{ section.settings.eyebrow_color }};
    --buo-heading-color: {{ section.settings.heading_color }};
    --buo-intro-color: {{ section.settings.intro_color }};
    --buo-card-border-color: {{ section.settings.card_border_color }};
    --buo-card-label-color: {{ section.settings.card_label_color }};
    --buo-card-heading-color: {{ section.settings.card_heading_color }};
    --buo-card-text-color: {{ section.settings.card_text_color }};
    --buo-feature-color: {{ section.settings.feature_color }};
    --buo-feature-line-color: {{ section.settings.feature_line_color }};
    --buo-cta-background: {{ section.settings.cta_background }};
    --buo-cta-heading-color: {{ section.settings.cta_heading_color }};
    --buo-cta-text-color: {{ section.settings.cta_text_color }};
    --buo-cta-link-color: {{ section.settings.cta_link_color }};
    --buo-desktop-horizontal-padding: {{ section.settings.desktop_horizontal_padding }}px;
    --buo-desktop-heading-width: {{ section.settings.desktop_heading_width }}px;
    --buo-desktop-intro-width: {{ section.settings.desktop_intro_width }}px;
    --buo-desktop-cards-top-spacing: {{ section.settings.desktop_cards_top_spacing }}px;
    --buo-mobile-cards-top-spacing: {{ section.settings.mobile_cards_top_spacing }}px;
    --buo-desktop-eyebrow-size: {{ section.settings.desktop_eyebrow_size }}px;
    --buo-desktop-heading-size: {{ section.settings.desktop_heading_size }}px;
    --buo-desktop-intro-size: {{ section.settings.desktop_intro_size }}px;
    --buo-desktop-card-heading-size: {{ section.settings.desktop_card_heading_size }}px;
    --buo-desktop-card-text-size: {{ section.settings.desktop_card_text_size }}px;
    --buo-desktop-feature-size: {{ section.settings.desktop_feature_size }}px;
    --buo-desktop-cta-heading-size: {{ section.settings.desktop_cta_heading_size }}px;
    --buo-desktop-cta-text-size: {{ section.settings.desktop_cta_text_size }}px;
    --buo-desktop-cta-link-size: {{ section.settings.desktop_cta_link_size }}px;
    --buo-mobile-eyebrow-size: {{ section.settings.mobile_eyebrow_size }}px;
    --buo-mobile-heading-size: {{ section.settings.mobile_heading_size }}px;
    --buo-mobile-intro-size: {{ section.settings.mobile_intro_size }}px;
    --buo-mobile-card-heading-size: {{ section.settings.mobile_card_heading_size }}px;
    --buo-mobile-card-text-size: {{ section.settings.mobile_card_text_size }}px;
    --buo-mobile-feature-size: {{ section.settings.mobile_feature_size }}px;
    --buo-mobile-cta-heading-size: {{ section.settings.mobile_cta_heading_size }}px;
    --buo-mobile-cta-text-size: {{ section.settings.mobile_cta_text_size }}px;
    --buo-mobile-cta-link-size: {{ section.settings.mobile_cta_link_size }}px;
    --buo-desktop-padding-top: {{ section.settings.desktop_padding_top }}px;
    --buo-desktop-padding-bottom: {{ section.settings.desktop_padding_bottom }}px;
    --buo-mobile-padding-top: {{ section.settings.mobile_padding_top }}px;
    --buo-mobile-padding-bottom: {{ section.settings.mobile_padding_bottom }}px;
  "
>
  <div class="business-use-options__inner">
    {%- if section.settings.eyebrow != blank -%}
      <p class="business-use-options__eyebrow">{{ section.settings.eyebrow | escape }}</p>
    {%- endif -%}

    {%- if section.settings.heading != blank or section.settings.intro != blank -%}
      <div class="business-use-options__header">
        {%- if section.settings.heading != blank -%}
          <h2 class="business-use-options__heading">{{ section.settings.heading }}</h2>
        {%- endif -%}

        {%- if section.settings.intro != blank -%}
          <div class="business-use-options__intro rte">{{ section.settings.intro }}</div>
        {%- endif -%}
      </div>
    {%- endif -%}

    {%- if section.blocks.size > 0 -%}
      <div class="business-use-options__cards-wrap">
        <div class="business-use-options__cards">
          {%- for block in section.blocks -%}
            {%- if block.settings.link != blank -%}
              <a
                class="business-use-options__card"
                href="{{ block.settings.link | escape }}"
                style="--buo-card-background: {{ block.settings.background }};"
                {{ block.shopify_attributes }}
              >
            {%- else -%}
              <article
                class="business-use-options__card"
                style="--buo-card-background: {{ block.settings.background }};"
                {{ block.shopify_attributes }}
              >
            {%- endif -%}

              {%- if block.settings.label != blank -%}
                <p class="business-use-options__card-label">{{ block.settings.label | escape }}</p>
              {%- endif -%}

              {%- if block.settings.heading != blank -%}
                <h3 class="business-use-options__card-heading">{{ block.settings.heading }}</h3>
              {%- endif -%}

              {%- if block.settings.description != blank -%}
                <div class="business-use-options__card-description rte">{{ block.settings.description }}</div>
              {%- endif -%}

              {%- if block.settings.features != blank -%}
                <div class="business-use-options__features rte">{{ block.settings.features }}</div>
              {%- endif -%}

            {%- if block.settings.link != blank -%}
              </a>
            {%- else -%}
              </article>
            {%- endif -%}
          {%- endfor -%}
        </div>
      </div>
    {%- endif -%}

    {%- if section.settings.cta_heading != blank
      or section.settings.cta_text != blank
      or section.settings.cta_link_label != blank
    -%}
      <div class="business-use-options__cta">
        {%- if section.settings.cta_heading != blank -%}
          <div class="business-use-options__cta-heading">{{ section.settings.cta_heading }}</div>
        {%- endif -%}

        {%- if section.settings.cta_text != blank -%}
          <div class="business-use-options__cta-text rte">{{ section.settings.cta_text }}</div>
        {%- endif -%}

        {%- if section.settings.cta_link_label != blank -%}
          <a
            class="business-use-options__cta-link"
            href="{{ cta_link | escape }}"
          >
            {{ section.settings.cta_link_label | escape }}
          </a>
        {%- endif -%}
      </div>
    {%- endif -%}
  </div>
</section>

