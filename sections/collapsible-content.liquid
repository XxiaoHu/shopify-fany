{{ 'component-accordion.css' | asset_url | stylesheet_tag }}
{{ 'collapsible-content.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .section-{{ section.id }}-spacing {
    margin-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    margin-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-spacing {
      margin-top: {{ section.settings.padding_top }}px;
      margin-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

  {%- if section.settings.heading_position == 'outside' -%}
    .section-{{ section.id }}-header-padding {
      padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    }

    .section-{{ section.id }}-spacing {
      margin-top: 0;
    }

    @media screen and (min-width: 750px) {
      .section-{{ section.id }}-header-padding {
        padding-top: {{ section.settings.padding_top }}px;
      }
    }
  {%- endif -%}

  .section-{{ section.id }}-accordion-typography .accordion__title {
    font-size: {{ section.settings.question_title_font_size }}px;
    font-weight: {{ section.settings.question_title_font_weight }};
  }

  .section-{{ section.id }}-accordion-typography .accordion__content {
    font-size: {{ section.settings.answer_font_size }}px;
    font-weight: {{ section.settings.answer_font_weight }};
  }

  .section-{{ section.id }}-questions-padding {
    padding-top: {{ section.settings.questions_padding_top }}px;
    padding-bottom: {{ section.settings.questions_padding_bottom }}px;
  }

  @media screen and (min-width: 1024px) {
    .section-{{ section.id }}-content-width {
      width: 100%;
      max-width: none;
      box-sizing: border-box;
      padding-right: 200px;
      padding-left: 200px;
    }

    .section-{{ section.id }}-content-card {
      padding: 30px;
      background: #FCFAF9;
      border-radius: 4px;
    }

    .section-{{ section.id }}-content-card.collapsible-content__grid--no-image > .grid__item {
      width: 100%;
      max-width: 100%;
    }
  }

  @media screen and (max-width: 749px) {
    .section-{{ section.id }}-mobile-heading {
      font-size: {{ section.settings.mobile_heading_size }}px;
    }

    .section-{{ section.id }}-accordion-typography .accordion__title {
      font-size: {{ section.settings.mobile_question_title_font_size }}px;
      font-weight: {{ section.settings.mobile_question_title_font_weight }};
    }

    .section-{{ section.id }}-accordion-typography .accordion__content {
      font-size: {{ section.settings.mobile_answer_font_size }}px;
      font-weight: {{ section.settings.mobile_answer_font_weight }};
    }
  }
{%- endstyle -%}

{%- capture collapsible_header -%}
  <div
    class="collapsible-content__header{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}"
    style="text-align: {{ section.settings.heading_alignment }};"
  >
    {%- if section.settings.caption != blank -%}
      <p class="caption-with-letter-spacing">
        {{ section.settings.caption | escape }}
      </p>
    {% endif %}
    {%- if section.settings.heading != blank -%}
      <h2
        class="collapsible-content__heading inline-richtext {{ section.settings.heading_size }} section-{{ section.id }}-mobile-heading"
        style="color: {{ section.settings.heading_color }};"
      >
        {{ section.settings.heading }}
      </h2>
    {%- else -%}
      <h2 class="visually-hidden">{{ 'accessibility.collapsible_content_title' | t }}</h2>
    {% endif %}
  </div>
{%- endcapture -%}

{%- if section.settings.heading_position == 'outside' -%}
  <div class="collapsible-content__header-shell">
    <div class="page-width collapsible-content__header-outside section-{{ section.id }}-header-padding">
      {{ collapsible_header }}
    </div>
  </div>
{%- endif -%}

<div class="section-{{ section.id }}-spacing">
  <div class="collapsible-content collapsible-{{ section.settings.layout }}-layout section-{{ section.id }}-accordion-typography{% if section.settings.heading_position == 'outside' %} collapsible-content--heading-outside{% endif %}{% if section.settings.hide_question_dividers %} collapsible-content--hide-dividers{% endif %} isolate{% if section.settings.layout == 'none' %} content-container content-container--full-width{% endif %}">
    <div class="collapsible-content__wrapper">
      <div class="page-width section-{{ section.id }}-content-width">
        {%- if section.settings.heading_position == 'inside' -%}
          {{ collapsible_header }}
        {%- endif -%}
        <div class="grid grid--1-col grid--2-col-tablet collapsible-content__grid section-{{ section.id }}-content-card{% if section.settings.image == blank %} collapsible-content__grid--no-image{% endif %}{% if section.settings.desktop_layout == 'image_second' %} collapsible-content__grid--reverse{% endif %}{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}">
          {%- if section.settings.image != blank -%}
            <div class="grid__item collapsible-content__grid-item">
              <div
                class="collapsible-content__media collapsible-content__media--{{ section.settings.image_ratio }} media global-media-settings gradient"
                {% if section.settings.image_ratio == 'adapt' %}
                  style="padding-bottom: {{ 1 | divided_by: section.settings.image.aspect_ratio | times: 100 }}%;"
                {% endif %}
              >
                {%- liquid
                  assign padding_multiplier = 1
                  if section.settings.layout == 'section'
                    assign padding_multiplier = 2
                  endif
                  assign desktop_tablet_padding = 100 | times: padding_multiplier | append: 'px'
                  assign mobile_padding = 30 | times: padding_multiplier | append: 'px'
                -%}
                {%- capture sizes -%}
                  (min-width: {{ settings.page_width }}px) calc(({{ settings.page_width }}px - {{ desktop_tablet_padding }}) / 2),
                  (min-width: 750px) calc((100vw - {{ desktop_tablet_padding }}) / 2),
                  calc(100vw - {{ mobile_padding }})
                {%- endcapture -%}
                {{
                  section.settings.image
                  | image_url: width: 3200
                  | image_tag:
                    sizes: sizes,
                    widths: '50, 75, 100, 150, 200, 300, 400, 500, 750, 1000, 1250, 1500, 1750, 2000, 2250, 2500, 2750, 3000, 3200'
                }}
              </div>
            </div>
          {% endif %}
          <div class="grid__item section-{{ section.id }}-questions-padding">
            {%- for block in section.blocks -%}
              <div
                class="accordion{% if section.settings.hide_question_dividers %} accordion--hide-dividers{% endif %}{% if section.settings.layout == 'row' %} content-container color-{{ section.settings.container_color_scheme }} gradient{% endif %}"
                {{ block.shopify_attributes }}
              >
                <details
                  id="Details-{{ block.id }}-{{ section.id }}"
                  {% if section.settings.open_first_collapsible_row and forloop.first %}
                    open
                  {% endif %}
                >
                  <summary id="Summary-{{ block.id }}-{{ section.id }}">
                    {% render 'icon-accordion', icon: block.settings.icon %}
                    <h3 class="accordion__title inline-richtext h6">
                      {{ block.settings.heading | default: block.settings.page.title | escape }}
                    </h3>
                    {{- 'icon-caret.svg' | inline_asset_content -}}
                  </summary>
                  <div
                    class="accordion__content rte"
                    id="CollapsibleAccordion-{{ block.id }}-{{ section.id }}"
                    role="region"
                    aria-labelledby="Summary-{{ block.id }}-{{ section.id }}"
                  >
                    {{ block.settings.row_content }}
                    {{ block.settings.page.content }}
                  </div>
                </details>
              </div>
            {%- endfor -%}
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

