{{ 'black-friday-gift-sets.css' | asset_url | stylesheet_tag }}
{{ 'black-friday-promo-heading.css' | asset_url | stylesheet_tag }}
<script src="{{ 'black-friday-gift-sets.js' | asset_url }}" defer="defer"></script>

<black-friday-gift-sets
  id="BlackFridayGiftSets-{{ section.id }}"
  class="black-friday-gift-sets"
  {% if section.settings.navigation_anchor != blank %}data-navigation-anchor="{{ section.settings.navigation_anchor | handleize | escape }}"{% endif %}
  data-cart-add-url="{{ routes.cart_add_url | escape }}"
  data-cart-url="{{ routes.cart_url | escape }}"
  data-error-message="{{ 'sections.cart.cart_error' | t | escape }}"
  style="
    --bfgs-desktop-card-title-line-height: {{ section.settings.desktop_card_title_line_height | divided_by: 100.0 }};
    --bfgs-desktop-contents-size: {{ section.settings.desktop_contents_size }}px;
    --bfgs-desktop-contents-line-height: {{ section.settings.desktop_contents_line_height | divided_by: 100.0 }};
    --bfgs-mobile-card-title-line-height: {{ section.settings.mobile_card_title_line_height | divided_by: 100.0 }};
    --bfgs-mobile-contents-size: {{ section.settings.mobile_contents_size }}px;
    --bfgs-mobile-contents-line-height: {{ section.settings.mobile_contents_line_height | divided_by: 100.0 }};
    --bfgs-background-color: {{ section.settings.background_color }};
    --bfgs-mobile-background-color: {{ section.settings.mobile_background_color }};
    --bfgs-heading-color: {{ section.settings.heading_color }};
    --bfgs-description-color: {{ section.settings.description_color }};
    --bfgs-highlight-color: {{ section.settings.highlight_color }};
    --bfgs-glow-color: {{ section.settings.glow_color }};
    --bfgs-glow-inner-color: {{ section.settings.glow_inner_color }};
    --bfgs-card-background: {{ section.settings.card_background }};
    --bfgs-card-text-color: {{ section.settings.card_text_color }};
    --bfgs-price-color: {{ section.settings.price_color }};
    --bfgs-buy-background: {{ section.settings.buy_background }};
    --bfgs-buy-text: {{ section.settings.buy_text }};
    --bfgs-description-opacity: {{ section.settings.description_opacity | divided_by: 100.0 }};
    --bfgs-desktop-heading-size: {{ section.settings.desktop_heading_size }}px;
    --bfgs-desktop-heading-width: {{ section.settings.desktop_heading_width }}px;
    --bfgs-desktop-description-size: {{ section.settings.desktop_description_size }}px;
    --bfgs-desktop-description-width: {{ section.settings.desktop_description_width }}px;
    --bfgs-desktop-image-width: {{ section.settings.desktop_image_width }}px;
    --bfgs-desktop-image-height: {{ section.settings.desktop_image_height }}px;
    --bfgs-desktop-card-title-size: {{ section.settings.desktop_card_title_size }}px;
    --bfgs-desktop-price-size: {{ section.settings.desktop_price_size }}px;
    --bfgs-desktop-compare-size: {{ section.settings.desktop_compare_size }}px;
    --bfgs-desktop-heading-line-height: {{ section.settings.desktop_heading_line_height | divided_by: 100.0 }};
    --bfgs-desktop-description-line-height: {{ section.settings.desktop_description_line_height | divided_by: 100.0 }};
    --bfgs-mobile-heading-size: {{ section.settings.mobile_heading_size }}px;
    --bfgs-mobile-heading-width: {{ section.settings.mobile_heading_width }}px;
    --bfgs-mobile-description-size: {{ section.settings.mobile_description_size }}px;
    --bfgs-mobile-description-width: {{ section.settings.mobile_description_width }}px;
    --bfgs-mobile-image-width: {{ section.settings.mobile_image_width }}px;
    --bfgs-mobile-image-height: {{ section.settings.mobile_image_height }}px;
    --bfgs-mobile-card-title-size: {{ section.settings.mobile_card_title_size }}px;
    --bfgs-mobile-price-size: {{ section.settings.mobile_price_size }}px;
    --bfgs-mobile-compare-size: {{ section.settings.mobile_compare_size }}px;
    --bfgs-mobile-heading-line-height: {{ section.settings.mobile_heading_line_height | divided_by: 100.0 }};
    --bfgs-mobile-description-line-height: {{ section.settings.mobile_description_line_height | divided_by: 100.0 }};
    --bfgs-desktop-image-heading-gap: {{ section.settings.desktop_image_heading_gap }}px;
    --bfgs-desktop-heading-description-gap: {{ section.settings.desktop_heading_description_gap }}px;
    --bfgs-desktop-header-cards-gap: {{ section.settings.desktop_header_cards_gap }}px;
    --bfgs-desktop-card-gap: {{ section.settings.desktop_card_gap }}px;
    --bfgs-desktop-copy-gap: {{ section.settings.desktop_copy_gap }}px;
    --bfgs-mobile-image-heading-gap: {{ section.settings.mobile_image_heading_gap }}px;
    --bfgs-mobile-heading-description-gap: {{ section.settings.mobile_heading_description_gap }}px;
    --bfgs-mobile-header-cards-gap: {{ section.settings.mobile_header_cards_gap }}px;
    --bfgs-mobile-card-gap: {{ section.settings.mobile_card_gap }}px;
    --bfgs-mobile-copy-gap: {{ section.settings.mobile_copy_gap }}px;
    --bfgs-desktop-padding-top: {{ section.settings.desktop_padding_top }}px;
    --bfgs-desktop-padding-bottom: {{ section.settings.desktop_padding_bottom }}px;
    --bfgs-mobile-padding-top: {{ section.settings.mobile_padding_top }}px;
    --bfgs-mobile-padding-bottom: {{ section.settings.mobile_padding_bottom }}px;
  "
>
  <div class="black-friday-gift-sets__inner">
    {% render 'black-friday-promo-heading', config: section.settings %}
    <div class="black-friday-gift-sets__cards">
      {%- for block in section.blocks -%}
        {%- if block.settings.product != blank or block.settings.variant_id != blank or request.design_mode -%}
          {% render 'black-friday-gift-sets-card', block: block, section: section %}
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>
</black-friday-gift-sets>

{% schema %}
