        },
        {
          "type": "text",
          "id": "compare_price_text",
          "label": "展示划线价",
          "info": "例如 $289.99，按填写内容直接显示；留空不显示。"
        },
        {
          "type": "richtext",
          "id": "contents",
          "label": "套装内容"
        },
        {
          "type": "image_picker",
          "id": "desktop_image",
          "label": "PC 商品图片",
          "info": "未配置时使用所选商品的默认主图。"
        },
        {
          "type": "image_picker",
