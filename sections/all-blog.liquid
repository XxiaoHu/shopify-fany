{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: 100px;
    padding-bottom: 100px;
  }

  .all-blog-box {
    display: flex;
    flex-direction: column;
    gap: 40px;
    max-width: 1520px;
    width: calc(100% - 40px);
    padding-left: 0;
    padding-right: 0;
  }

  .all-blog-box .blog-articles {
    display: grid;
    grid-template-columns: repeat({{ section.settings.column_num }}, minmax(0, 1fr));
    gap: 40px 13.33px;
    width: 100%;
  }

  .all-blog-box .blog-articles__article.article {
    display: block;
    align-items: stretch;
  }

  .all-blog-box .article-card-wrapper,
  .all-blog-box .article-card {
    width: 100%;
    height: 100%;
  }

  .all-blog-box .article-card {
    overflow: hidden;
    border-radius: 4px;
    background: transparent;
    text-align: left;
  }

  .all-blog-box .card--standard > .card__inner {
    overflow: hidden;
    aspect-ratio: 370 / 410;
    border-radius: 4px 4px 0 0;
    background: #f5f5f5;
  }

  .all-blog-box .card--standard > .card__inner.ratio:before {
    padding-bottom: 110.8108%;
  }

  .all-blog-box .card--standard > .card__inner:after,
  .all-blog-box .card--standard > .card__inner .card__content {
    display: none;
  }

  .all-blog-box .card .card__inner .card__media,
  .all-blog-box .article-card__image-wrapper,
  .all-blog-box .article-card__image {
    overflow: hidden;
    border-radius: 4px 4px 0 0;
    background: #f5f5f5;
  }

  .all-blog-box .article-card__image img {
    object-fit: cover;
  }

  .all-blog-box .card--standard > .card__content {
    padding: 0;
    border-radius: 0 0 4px 4px;
    background: #faf6f6;
  }

  .all-blog-box .card--standard > .card__content .card__information {
    display: flex;
    flex-direction: column;
    gap: 24px;
    padding: 16px 20px;
  }

  .all-blog-box .card__heading {
    min-height: 54px;
    margin: 0;
    overflow: hidden;
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
    color: #1e0e06;
    font-family: Lato, sans-serif;
    font-size: 18px;
    font-weight: 400;
    line-height: 1.5;
    letter-spacing: 0;
  }

  .all-blog-box .article-card__info {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    width: 100%;
    padding-top: 0;
    color: #686766;
    font-family: Lato, sans-serif;
    font-size: 14px;
    font-weight: 400;
    line-height: 1.5;
    letter-spacing: 0;
    text-transform: none;
  }

  .all-blog-box .article-card__reading-time {
    margin-left: auto;
    white-space: nowrap;
  }

  .all-blog-box .circle-divider:after,
  .all-blog-box .article-card__excerpt,
  .all-blog-box .article-card__footer {
    display: none;
  }

  .all-blog-box .underline-links-hover:hover a {
    text-decoration: none;
  }

  .all-blog-box .pagination-container {
    width: 100%;
  }

  .all-blog-box .pagination-wrapper {
    margin-top: 0;
  }

  .all-blog-box .pagination {
    padding: 20px;
  }

  .all-blog-box .pagination__list {
    align-items: center;
    justify-content: center;
    gap: 40px;
  }

  .all-blog-box .pagination__list > li {
    flex: 0 0 auto;
    max-width: none;
    margin-right: 0;
  }

  .all-blog-box .pagination__pages-item {
    overflow: hidden;
    border-radius: 4px;
    background: #f0f0f0;
  }

  .all-blog-box .pagination__pages-group {
    display: flex;
    align-items: center;
    overflow: hidden;
    border-radius: 4px;
  }

  .all-blog-box .pagination__item {
    width: 41px;
    height: 41px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    box-sizing: border-box;
    border-radius: 4px;
    background: #f5f5f5;
    color: #1e0e06;
    font-family: Lato, sans-serif;
    font-size: 14px;
    font-weight: 400;
    line-height: 1;
    letter-spacing: 0;
    text-decoration: none;
  }

  .all-blog-box .pagination__item--current {
    border: 1px solid #9e7163;
    background: #ffffff;
    color: #1e0e06;
  }

  .all-blog-box .pagination__item.link,
  .all-blog-box a.pagination__item {
    text-decoration: none;
  }

  .all-blog-box .pagination__item:hover {
    color: #9e7163;
    text-decoration: none;
  }

  .all-blog-box .pagination__item:hover:after,
  .all-blog-box .pagination__item--current:after {
    display: none;
  }

  .all-blog-box .pagination__item[aria-disabled='true'] {
    color: #b4b1b0;
    pointer-events: none;
  }

  @media screen and (max-width: 768px) {
    .section-{{ section.id }}-padding {
      padding-top: 50px;
      padding-bottom: 50px;
    }

    .all-blog-box {
      width: 100%;
      max-width: none;
      gap: 20px;
      padding-left: 16px;
      padding-right: 16px;
    }

    .all-blog-box .blog-articles {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 20px 11px;
    }

    .all-blog-box .card--standard > .card__inner {
      aspect-ratio: 368 / 412;
      border-radius: 0;
    }

    .all-blog-box .card--standard > .card__inner.ratio:before {
      padding-bottom: 111.9565%;
    }

    .all-blog-box .card .card__inner .card__media,
    .all-blog-box .article-card__image-wrapper,
    .all-blog-box .article-card__image,
    .all-blog-box .article-card,
    .all-blog-box .card--standard > .card__content {
      border-radius: 0;
    }

    .all-blog-box .card--standard > .card__content .card__information {
      gap: 10px;
      padding: 4px 10px;
    }

    .all-blog-box .card__heading {
      min-height: auto;
      display: block;
      white-space: nowrap;
      text-overflow: ellipsis;
      color: #1e0e06;
      font-size: 14px;
      line-height: 1.5;
    }

    .all-blog-box .article-card__info {
      gap: 6px;
      color: #1e0e06;
      font-size: 12px;
      line-height: 1.5;
      white-space: nowrap;
    }

    .all-blog-box .pagination {
      --all-blog-pagination-size: clamp(32px, calc((100vw - 72px) / 7), 40px);
      --all-blog-pagination-arrow-size: clamp(33px, calc((100vw - 65px) / 7), 41px);
      width: 100%;
      padding: 20px 0;
      overflow: visible;
    }

    .all-blog-box .pagination__list {
      display: grid;
      grid-template-columns: var(--all-blog-pagination-arrow-size) minmax(0, max-content) var(--all-blog-pagination-arrow-size);
      align-items: center;
      justify-content: center;
      column-gap: 20px;
      width: 100%;
    }

    .all-blog-box .pagination__arrow-item--prev {
      grid-column: 1;
      width: var(--all-blog-pagination-arrow-size);
    }

    .all-blog-box .pagination__pages-item {
      grid-column: 2;
      min-width: 0;
      max-width: calc(100vw - 154px);
      overflow: hidden;
      border-radius: 4px;
      background: #f0f0f0;
    }

    .all-blog-box .pagination__arrow-item--next {
      grid-column: 3;
      width: var(--all-blog-pagination-arrow-size);
    }

    .all-blog-box .pagination__pages-group {
      flex-wrap: nowrap;
    }

    .all-blog-box .pagination__item {
      width: var(--all-blog-pagination-size);
      min-width: var(--all-blog-pagination-size);
      height: var(--all-blog-pagination-size);
      font-size: 16px;
    }

    .all-blog-box .pagination__item-arrow {
      width: var(--all-blog-pagination-arrow-size);
      min-width: var(--all-blog-pagination-arrow-size);
      height: var(--all-blog-pagination-arrow-size);
      font-size: 14px;
    }

  }

  @media screen and (min-width: 769px) and (max-width: 1199px) {
    .all-blog-box .blog-articles {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
{%- endstyle -%}

{%- liquid
  assign blogs_handles = section.settings.blogsHandles | split: ','
  assign article_data = ''
  assign ratio = nil
  for blog_handle in blogs_handles
    assign blog_handle = blog_handle | strip
    assign blog = blogs[blog_handle]
    for article in blog.articles
      if article.metafields.custom.article_push_index.value == true
        if ratio == blank
          assign ratio = article.image.aspect_ratio
        endif
        assign excerpt = article.excerpt | strip_html | truncatewords: 30
        assign date_time = article.published_at | date: '%Y-%m-%d' | escape
        assign show_time = article.published_at | date: '%m/%d/%Y' | escape
        assign article_word_count = article.content | strip_html | split: ' ' | size
        assign reading_minutes = article_word_count | divided_by: 200 | ceil
        if reading_minutes < 1
          assign reading_minutes = 1
        endif
      
        assign article_data = article | json | remove_last: '}' | append: ',date_time: "' | append: date_time | append: '"' | append: ',show_time: "' | append: show_time | append: '"' | append: ',reading_minutes:' | append: reading_minutes | append: ',excerpt:"' | append: excerpt | append: '"' | append: ',image_height:' | append: article.image.height | append: ',url:"' | append: article.url | append: '"'  | append: ',category_handle: "' | append: handle | append: '"' | append: ',category: "' | append: blog.title | append: '"' | append: '}' | append: ',' | append: article_data
      endif
    endfor
  endfor
-%}


<div class="main-blog page-width section-{{ section.id }}-padding all-blog-box">
  <div class="blog-articles">
    
  </div>
  <div class="pagination-container"></div>
</div>
<script>
  document.addEventListener('DOMContentLoaded', function() {
    const root = document.querySelector('.section-{{ section.id }}-padding.all-blog-box');
    if (!root) return;

    const articlesData = [{{article_data | remove_last: ',' }}];
    const desktopPageSize = 8;
    const mobilePageSize = 4;
    const mediaQuery = window.matchMedia('(max-width: 768px)');
    const totalCount = articlesData.length;
    let currentPage = 1;
    let currentStartIndex = 0;

    articlesData.sort((a,b) => new Date(a.published_at).getTime() - new Date(b.published_at).getTime());
    articlesData.reverse();

    const getPageSize = () => mediaQuery.matches ? mobilePageSize : desktopPageSize;

    const getTotalPages = () => Math.max(1, Math.ceil(totalCount / getPageSize()));

    const getPaginationParts = (page, totalPages) => {
      if (totalPages <= 5) {
        return Array.from({ length: totalPages }, (_, index) => index + 1);
      }

      if (page <= 3) {
        return [1, 2, 3, 'ellipsis-end', totalPages];
      }

      if (page >= totalPages - 2) {
        return [1, 'ellipsis-start', totalPages - 2, totalPages - 1, totalPages];
      }

      return [1, 'ellipsis-start', page, 'ellipsis-end', totalPages];
    };

    const arrowSvg = (isNext) => `
      <span class="svg-wrapper">
        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" aria-hidden="true" focusable="false"${isNext ? ' style="transform: rotate(180deg);"' : ''}>
          <path d="M15 6L9 12L15 18" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </span>
    `;

    const renderPagination = (page) => {
      const paginationWrapper = root.querySelector('.pagination-container');
      if (!paginationWrapper) return;

      const totalPages = getTotalPages();
      if (totalPages <= 1) {
        paginationWrapper.innerHTML = '';
        return;
      }

      const previous = page > 1
        ? `<li class="pagination__arrow-item pagination__arrow-item--prev"><a href="javascript:void(0)" class="pagination__item pagination__item--next pagination__item-arrow link motion-reduce" aria-label="Previous" data-page="${page - 1}">${arrowSvg(false)}</a></li>`
        : `<li class="pagination__arrow-item pagination__arrow-item--prev"><span class="pagination__item pagination__item--next pagination__item-arrow link motion-reduce" aria-disabled="true" aria-label="Previous">${arrowSvg(false)}</span></li>`;
      const next = page < totalPages
        ? `<li class="pagination__arrow-item pagination__arrow-item--next"><a href="javascript:void(0)" class="pagination__item pagination__item--prev pagination__item-arrow link motion-reduce" aria-label="Next" data-page="${page + 1}">${arrowSvg(true)}</a></li>`
        : `<li class="pagination__arrow-item pagination__arrow-item--next"><span class="pagination__item pagination__item--prev pagination__item-arrow link motion-reduce" aria-disabled="true" aria-label="Next">${arrowSvg(true)}</span></li>`;
      const pages = getPaginationParts(page, totalPages).map((part) => {
        if (typeof part !== 'number') {
          return '<span class="pagination__item">...</span>';
        }

        if (part === page) {
          return `<a role="link" aria-disabled="true" class="pagination__item pagination__item--current light" aria-current="page" aria-label="Page ${part}">${part}</a>`;
        }

        return `<a href="javascript:void(0)" class="pagination__item link" aria-label="Page ${part}" data-page="${part}">${part}</a>`;
      }).join('');
      const pageItems = `<li class="pagination__pages-item"><div class="pagination__pages-group">${pages}</div></li>`;

      paginationWrapper.innerHTML = `
        <div class="pagination-wrapper" data-page="${page}">
          <nav class="pagination" role="navigation" aria-label="Pagination">
            <ul class="pagination__list list-unstyled" role="list">${previous}${pageItems}${next}</ul>
          </nav>
        </div>
      `;
    };

    const pageChangeHandler = function(page) {
      const pageSize = getPageSize();
      const totalPages = getTotalPages();
      currentPage = Math.min(Math.max(Number(page) || 1, 1), totalPages);

      const articleWrapper = root.querySelector('.blog-articles');
      const startIndex = pageSize * (currentPage - 1);
      const endIndex = Math.min(pageSize * currentPage, totalCount);
      const showData = articlesData.slice(startIndex, endIndex);
      currentStartIndex = startIndex;

      let articleHTML = '';
      let i = 1;
      showData.forEach((article) => {
        articleHTML += articleTemplate(article, i);
        i++;
      });

      articleWrapper.innerHTML = articleHTML;
      renderPagination(currentPage);
    };
    
    const articleTemplate = (article, i) => {
      const image = article.image || {};
      const imageSrc = image.src || '';
      const imageAlt = image.alt || article.title || '';
      const title = article.title || '';
      const readingMinutes = article.reading_minutes || 1;
      const metaHtml = `
        <div class="article-card__info caption-with-letter-spacing">
          <span class="circle-divider"><time datetime="${ article.date_time }">${ article.show_time }</time></span>
          <span class="article-card__reading-time">${ readingMinutes } min read</span>
        </div>
      `;

      return `<div
        class="blog-articles__article article{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}"
        {% if settings.animations_reveal_on_scroll %}
          data-cascade
          style="--animation-order: ${i};"
        {% endif %}
      >
        <div class="article-card-wrapper card-wrapper underline-links-hover">
          <div class="card article-card card--standard card--media" style="--ratio-percent: {{ 1 | divided_by: ratio | times: 100 }}%;">
            <div class="card__inner {% if settings.blog_card_style == 'standard' %} color-{{ settings.blog_card_color_scheme }} gradient{% endif %} ratio" style="--ratio-percent: {{ 1 | divided_by: ratio | times: 100 }}%;">
              <div class="article-card__image-wrapper card__media">
                <div class="article-card__image media media--hover-effect">
                  <img
                    srcset="
                      ${ image.width >= 165 ? imageSrc + '&width=165 165w,' : ''}
                      ${ image.width >= 360 ? imageSrc + '&width=360 360w,' : ''}
                      ${ image.width >= 533 ? imageSrc + '&width=533 533w,' : ''}
                      ${ image.width >= 720 ? imageSrc + '&width=720 720w,' : ''}
                      ${ imageSrc } ${ image.width }w
                    "
                    src="${ imageSrc }&width=533"
                    sizes="(min-width: {{ settings.page_width }}px) {{ settings.page_width | divided_by: 4 }}px, (min-width: 769px) calc((100vw - 80px) / 4), calc((100vw - 43px) / 2)"
                    alt="${ imageAlt }"
                    class="motion-reduce"
                    loading="lazy"
                    width="${ image.width || 533 }"
                    height="${ article.image_height || image.height || 590 }">
                </div>
              </div>
              <div class="card__content">
                <div class="card__information">
                  <h4 class="card__heading"><a href="${ article.url }" class="full-unstyled-link">${ title }</a></h4>
                  ${ metaHtml }
                </div>
              </div>
            </div>
            <div class="card__content">
              <div class="card__information">
                <h4 class="card__heading"><a href="${ article.url }" class="full-unstyled-link">${ title }</a></h4>
                ${ metaHtml }
              </div>
            </div>
          </div>
        </div>
      </div>`;
    };

    root.addEventListener('click', function(e) {
      const target = e.target.closest('.pagination__item[data-page]');
      if (!target) return;

      e.preventDefault();
      pageChangeHandler(target.dataset.page);
      root.scrollIntoView({ behavior: 'smooth', block: 'start' });
    });

    mediaQuery.addEventListener('change', function() {
      pageChangeHandler(Math.floor(currentStartIndex / getPageSize()) + 1);
    });

    pageChangeHandler(1);
  });
  
</script>

{% schema %}
{
  "name": "t:sections.all-blog.name",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "blogsHandles",
      "label": "t:sections.featured-blog-2.settings.text.label",
      "info": "t:sections.featured-blog-2.settings.text.info"
    },
    {
      "type": "checkbox",
      "id": "show_image",
      "default": true,
      "label": "t:sections.main-blog.settings.show_image.label"
    },
    {
      "type": "checkbox",
      "id": "show_date",
      "default": true,
      "label": "t:sections.main-blog.settings.show_date.label"
    },
    {
      "type": "checkbox",
      "id": "show_author",
      "default": false,
      "label": "t:sections.main-blog.settings.show_author.label"
    },
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 150,
      "step": 2,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 150,
      "step": 2,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 36
    },
    {
      "type": "range",
      "id": "column_num",
      "min": 1,
      "max": 10,
      "step": 1,
      "label": "PC端每行展示数量",
      "default": 4
    }
  ],
  "presets": [
    {
      "name": "t:sections.all-blog.presets.name"
    }
  ]
}
{% endschema %}
