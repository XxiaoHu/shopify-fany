{{ 'awards-scroll.css' | asset_url | stylesheet_tag }}
{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }

  @media screen and (max-width: 768px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.mobile_padding_top }}px;
      padding-bottom: {{ section.settings.mobile_padding_bottom }}px;
    }
  }
{%- endstyle -%}

<awards-scroll class="section-{{ section.id }}-padding" style="--item-count: {{ section.blocks.size }}">
  <div class="awards-scroll-container">
    <div class="awards-scroll-wrapper">
      <!-- 奖项内容 -->
      {%- for block in section.blocks -%}
        {% style %}
          #Slide-{{ section.id }}-{{ forloop.index }} {
          font-size: {{ block.settings.heading_font_size }}px !important;
          }

          {% if block.settings.heading_width != blank and block.settings.heading_width > 0 %}
          #Slide-{{ section.id }}-{{ forloop.index }} .award-text {
          width: {{ block.settings.heading_width }}px;
          max-width: 100%;
          }
          {% endif %}

          @media screen and (max-width: 768px) {
          #Slide-{{ section.id }}-{{ forloop.index }} {
              font-size: {{ block.settings.mobile_heading_font_size }}px !important;
          }

          {% if block.settings.mobile_heading_width != blank and block.settings.mobile_heading_width > 0 %}
          #Slide-{{ section.id }}-{{ forloop.index }} .award-text {
              width: {{ block.settings.mobile_heading_width }}px;
              max-width: 100%;
          }
          {% endif %}
          }
        {% endstyle %}
        <div id="Slide-{{ section.id }}-{{ forloop.index }}" class="award-item" {%- if block.settings.image -%}style="--award-aspect_ratio: {{ block.settings.image.aspect_ratio }}"{% endif %}>
          {%- if block.settings.image -%}
            {{ block.settings.image | image_url: width: block.settings.image.width | image_tag: loading: 'lazy' }}
          {% endif %}
          <div class="award-text">{{ block.settings.heading }}</div>
        </div>
      {% endfor %}
    </div>
  </div>
</awards-scroll>

<script src="{{ 'awards-scroll.js' | asset_url }}" defer="defer"></script>

{% schema %}
{
  "name": "获奖栏目",
  "tag": "section",
  "class": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "header",
      "content": "布局"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 0
    },
    {
      "type": "header",
      "content": "移动设备布局"
    },
    {
      "type": "range",
      "id": "mobile_padding_top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 0
    },
    {
      "type": "range",
      "id": "mobile_padding_bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 0
    }
  ],
  "blocks": [
    {
      "type": "slide",
      "name": "奖项",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "图片"
        },
        {
          "type": "richtext",
          "id": "heading",
          "label": "文本"
        },
        {
          "type": "header",
          "content": "布局"
        },
        {
          "type": "number",
          "id": "heading_width",
          "label": "文本宽度"
        },
        {
          "type": "range",
          "id": "heading_font_size",
          "min": 10,
          "max": 56,
          "step": 1,
          "unit": "px",
          "label": "字体大小",
          "default": 20
        },
        {
          "type": "header",
          "content": "移动设备布局"
        },
        {
          "type": "number",
          "id": "mobile_heading_width",
          "label": "文本宽度"
        },
        {
          "type": "range",
          "id": "mobile_heading_font_size",
          "min": 10,
          "max": 56,
          "step": 1,
          "unit": "px",
          "label": "字体大小",
          "default": 14
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "获奖栏目",
      "blocks": [
        {
          "type": "slide"
        },
        {
          "type": "slide"
        }
      ]
    }
  ]
}
{% endschema %}
