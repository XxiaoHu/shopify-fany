{{ 'gift-product-showcase.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign desktop_heading = section.settings.desktop_heading | default: section.settings.mobile_heading
  assign mobile_heading = section.settings.mobile_heading | default: desktop_heading
  assign desktop_description = section.settings.desktop_description | default: section.settings.mobile_description
  assign mobile_description = section.settings.mobile_description | default: desktop_description
-%}

<section
  id="GiftProductShowcase-{{ section.id }}"
  class="gift-product-showcase"
  style="
    --gps-background: {{ section.settings.background_color }};
    --gps-heading-color: {{ section.settings.heading_color }};
    --gps-description-color: {{ section.settings.description_color }};
    --gps-card-title-color: {{ section.settings.card_title_color }};
    --gps-price-color: {{ section.settings.price_color }};
    --gps-cta-color: {{ section.settings.cta_color }};
    --gps-cta-hover-color: {{ section.settings.cta_hover_color }};
    --gps-desktop-padding-top: {{ section.settings.desktop_padding_top }}px;
    --gps-desktop-padding-bottom: {{ section.settings.desktop_padding_bottom }}px;
    --gps-mobile-padding-top: {{ section.settings.mobile_padding_top }}px;
    --gps-mobile-padding-bottom: {{ section.settings.mobile_padding_bottom }}px;
    --gps-desktop-heading-size: {{ section.settings.desktop_heading_size }}px;
    --gps-mobile-heading-size: {{ section.settings.mobile_heading_size }}px;
    --gps-desktop-heading-width: {{ section.settings.desktop_heading_width }}px;
    --gps-mobile-heading-width: {{ section.settings.mobile_heading_width }}px;
    --gps-desktop-heading-line-height: {{ section.settings.desktop_heading_line_height }};
    --gps-mobile-heading-line-height: {{ section.settings.mobile_heading_line_height }};
    --gps-desktop-description-size: {{ section.settings.desktop_description_size }}px;
    --gps-mobile-description-size: {{ section.settings.mobile_description_size }}px;
    --gps-desktop-description-width: {{ section.settings.desktop_description_width }}px;
    --gps-mobile-description-width: {{ section.settings.mobile_description_width }}px;
    --gps-desktop-description-line-height: {{ section.settings.desktop_description_line_height }};
    --gps-mobile-description-line-height: {{ section.settings.mobile_description_line_height }};
    --gps-desktop-card-title-size: {{ section.settings.desktop_card_title_size }}px;
    --gps-mobile-card-title-size: {{ section.settings.mobile_card_title_size }}px;
    --gps-desktop-card-title-line-height: {{ section.settings.desktop_card_title_line_height }};
    --gps-mobile-card-title-line-height: {{ section.settings.mobile_card_title_line_height }};
    --gps-desktop-cta-size: {{ section.settings.desktop_cta_size }}px;
    --gps-mobile-cta-size: {{ section.settings.mobile_cta_size }}px;
    --gps-desktop-price-size: {{ section.settings.desktop_price_size }}px;
    --gps-mobile-price-size: {{ section.settings.mobile_price_size }}px;
    --gps-desktop-content-gap: {{ section.settings.desktop_content_gap }}px;
    --gps-mobile-content-gap: {{ section.settings.mobile_content_gap }}px;
    --gps-desktop-card-gap: {{ section.settings.desktop_card_gap }}px;
    --gps-mobile-card-gap: {{ section.settings.mobile_card_gap }}px;
    --gps-desktop-image-text-gap: {{ section.settings.desktop_image_text_gap }}px;
    --gps-mobile-image-text-gap: {{ section.settings.mobile_image_text_gap }}px;
    --gps-card-copy-gap: {{ section.settings.card_copy_gap }}px;
    --gps-image-radius: {{ section.settings.image_radius }}px;
  "
>
  {%- if desktop_heading != blank
    or mobile_heading != blank
    or desktop_description != blank
    or mobile_description != blank
  -%}
    <header class="gift-product-showcase__header">
      {%- if desktop_heading != blank or mobile_heading != blank -%}
        <h2 class="gift-product-showcase__heading">
          {%- if desktop_heading != blank -%}
            <span class="gift-product-showcase__desktop-copy">{{ desktop_heading | escape | newline_to_br }}</span>
          {%- endif -%}
          {%- if mobile_heading != blank -%}
            <span class="gift-product-showcase__mobile-copy">{{ mobile_heading | escape | newline_to_br }}</span>
          {%- endif -%}
        </h2>
      {%- endif -%}

      {%- if desktop_description != blank or mobile_description != blank -%}
        <div class="gift-product-showcase__description">
          {%- if desktop_description != blank -%}
            <span class="gift-product-showcase__desktop-copy">{{ desktop_description | escape | newline_to_br }}</span>
          {%- endif -%}
          {%- if mobile_description != blank -%}
            <span class="gift-product-showcase__mobile-copy">{{ mobile_description | escape | newline_to_br }}</span>
          {%- endif -%}
        </div>
      {%- endif -%}
    </header>
  {%- endif -%}

  <div class="gift-product-showcase__grid">
    {%- for block in section.blocks -%}
      {%- liquid
        assign card_product = block.settings.product
        assign desktop_image = block.settings.desktop_image | default: block.settings.mobile_image | default: card_product.featured_image
        assign mobile_image = block.settings.mobile_image | default: desktop_image
        assign card_title = block.settings.title | default: card_product.title
        assign card_link = card_product.url
        assign image_alt = block.settings.image_alt | default: desktop_image.alt | default: card_title
      -%}
      <div
        class="gift-product-showcase__card"
        {{ block.shopify_attributes }}
      >
        {%- if card_link != blank -%}
          <a class="gift-product-showcase__card-link" href="{{ card_link }}">
            <span class="visually-hidden">{{ card_title | default: image_alt | escape }}</span>
          </a>
        {%- endif -%}
        <div class="gift-product-showcase__media">
          {%- if desktop_image != blank -%}
            <picture>
              {%- if mobile_image != blank -%}
                <source
                  media="(max-width: 749px)"
                  srcset="
                    {{ mobile_image | image_url: width: 361 }} 361w,
                    {{ mobile_image | image_url: width: 550 }} 550w,
                    {{ mobile_image | image_url: width: 750 }} 750w
                  "
                  sizes="calc(100vw - 32px)"
                >
              {%- endif -%}
              {{
                desktop_image
                | image_url: width: 1200
                | image_tag:
                  class: 'gift-product-showcase__image',
                  loading: 'lazy',
                  sizes: '(max-width: 749px) calc(100vw - 32px), calc((100vw - 432px) / 3)',
                  widths: '361, 496, 550, 750, 992, 1200',
                  alt: image_alt
              }}
            </picture>
          {%- elsif request.design_mode -%}
            {{ 'product-1' | placeholder_svg_tag: 'gift-product-showcase__placeholder' }}
          {%- endif -%}
        </div>

        {%- if card_title != blank or card_product != blank or block.settings.cta_text != blank -%}
          <div class="gift-product-showcase__card-copy">
            {%- if card_title != blank -%}
              <h3 class="gift-product-showcase__card-title">{{ card_title | escape }}</h3>
            {%- endif -%}
            <span class="gift-product-showcase__action">
              {%- if card_product != blank -%}
                <span class="gift-product-showcase__price">{{ card_product.price | money }}</span>
              {%- elsif request.design_mode -%}
                <span class="gift-product-showcase__price gift-product-showcase__price--empty">请先选择商品</span>
              {%- endif -%}
              {%- if block.settings.cta_text != blank -%}
                <span class="gift-product-showcase__cta">{{ block.settings.cta_text | escape }}</span>
              {%- endif -%}
            </span>
          </div>
        {%- endif -%}
      </div>
    {%- else -%}
      {%- if request.design_mode -%}
        {%- for index in (1..3) -%}
          <div class="gift-product-showcase__card">
            <div class="gift-product-showcase__media">
              {{ 'product-' | append: index | placeholder_svg_tag: 'gift-product-showcase__placeholder' }}
            </div>
          </div>
        {%- endfor -%}
      {%- endif -%}
    {%- endfor -%}
  </div>
</section>

{% schema %}
