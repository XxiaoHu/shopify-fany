{{ 'scene-image-showcase.css' | asset_url | stylesheet_tag }}
<section id="SceneImageShowcase-{{ section.id }}" class="scene-image-showcase{% unless section.settings.show_mobile_header %} scene-image-showcase--hide-mobile-header{% endunless %}" style="
    --sis-background: {{ section.settings.background }};
    --sis-desktop-heading-size: {{ section.settings.desktop_heading_size }}px;
    --sis-desktop-heading-width: {{ section.settings.desktop_heading_width }}px;
    --sis-desktop-heading-line-height: {{ section.settings.desktop_heading_line_height | divided_by: 100.0 }};
    --sis-desktop-heading-color: {{ section.settings.desktop_heading_color }};
    --sis-desktop-description-size: {{ section.settings.desktop_description_size }}px;
    --sis-desktop-description-width: {{ section.settings.desktop_description_width }}px;
    --sis-desktop-description-line-height: {{ section.settings.desktop_description_line_height | divided_by: 100.0 }};
    --sis-desktop-description-color: {{ section.settings.desktop_description_color }};
    --sis-desktop-row-gap: {{ section.settings.desktop_row_gap }}px;
    --sis-mobile-heading-size: {{ section.settings.mobile_heading_size }}px;
    --sis-mobile-heading-width: {{ section.settings.mobile_heading_width }}px;
    --sis-mobile-heading-line-height: {{ section.settings.mobile_heading_line_height | divided_by: 100.0 }};
    --sis-mobile-heading-color: {{ section.settings.mobile_heading_color }};
    --sis-mobile-description-size: {{ section.settings.mobile_description_size }}px;
    --sis-mobile-description-width: {{ section.settings.mobile_description_width }}px;
    --sis-mobile-description-line-height: {{ section.settings.mobile_description_line_height | divided_by: 100.0 }};
    --sis-mobile-description-color: {{ section.settings.mobile_description_color }};
    --sis-mobile-row-gap: {{ section.settings.mobile_row_gap }}px;
    --sis-desktop-padding-top: {{ section.settings.desktop_padding_top }}px;
    --sis-desktop-padding-bottom: {{ section.settings.desktop_padding_bottom }}px;
    --sis-mobile-padding-top: {{ section.settings.mobile_padding_top }}px;
    --sis-mobile-padding-bottom: {{ section.settings.mobile_padding_bottom }}px;
">
  {% if section.settings.heading != blank or section.settings.description != blank %}
    <div class="scene-image-showcase__header">
      {% if section.settings.heading != blank %}<h2 class="scene-image-showcase__heading">{{ section.settings.heading }}</h2>{% endif %}
      {% if section.settings.description != blank %}<div class="scene-image-showcase__description rte">{{ section.settings.description }}</div>{% endif %}
    </div>
  {% endif %}
  <div class="scene-image-showcase__rows">
    {% for block in section.blocks %}
      {% liquid
        assign desktop_image = block.settings.desktop_image | default: block.settings.mobile_image
        assign mobile_image = block.settings.mobile_image | default: desktop_image
        assign image_alt = block.settings.image_alt | default: desktop_image.alt
      %}
      {% if desktop_image != blank or block.settings.heading != blank or block.settings.description != blank or request.design_mode %}
        <article id="SceneImageShowcase-{{ section.id }}-{{ block.id }}" class="scene-image-showcase__row scene-image-showcase__row--{{ block.settings.desktop_side }}" style="
    --sis-desktop-heading-size: {{ block.settings.desktop_heading_size }}px;
    --sis-desktop-heading-width: {{ block.settings.desktop_heading_width }}px;
    --sis-desktop-heading-line-height: {{ block.settings.desktop_heading_line_height | divided_by: 100.0 }};
    --sis-desktop-heading-color: {{ block.settings.desktop_heading_color }};
    --sis-desktop-description-size: {{ block.settings.desktop_description_size }}px;
    --sis-desktop-description-width: {{ block.settings.desktop_description_width }}px;
    --sis-desktop-description-line-height: {{ block.settings.desktop_description_line_height | divided_by: 100.0 }};
    --sis-desktop-description-color: {{ block.settings.desktop_description_color }};
    --sis-desktop-copy-gap: {{ block.settings.desktop_copy_gap }}px;
    --sis-desktop-copy-top: {{ block.settings.desktop_copy_top }}px;
    --sis-desktop-copy-bottom: {{ block.settings.desktop_copy_bottom }}px;
    --sis-desktop-copy-background: {{ block.settings.desktop_copy_background }};
    --sis-mobile-heading-size: {{ block.settings.mobile_heading_size }}px;
    --sis-mobile-heading-width: {{ block.settings.mobile_heading_width }}px;
    --sis-mobile-heading-line-height: {{ block.settings.mobile_heading_line_height | divided_by: 100.0 }};
    --sis-mobile-heading-color: {{ block.settings.mobile_heading_color }};
    --sis-mobile-description-size: {{ block.settings.mobile_description_size }}px;
    --sis-mobile-description-width: {{ block.settings.mobile_description_width }}px;
    --sis-mobile-description-line-height: {{ block.settings.mobile_description_line_height | divided_by: 100.0 }};
    --sis-mobile-description-color: {{ block.settings.mobile_description_color }};
    --sis-mobile-copy-gap: {{ block.settings.mobile_copy_gap }}px;
    --sis-mobile-copy-top: {{ block.settings.mobile_copy_top }}px;
    --sis-mobile-copy-bottom: {{ block.settings.mobile_copy_bottom }}px;
    --sis-mobile-copy-background: {{ block.settings.mobile_copy_background }};
        " {{ block.shopify_attributes }}>
          {% if desktop_image != blank %}
            <picture class="scene-image-showcase__media">
              <source media="(max-width: 749px)" srcset="{{ mobile_image | image_url: width: 393 }} 393w, {{ mobile_image | image_url: width: 786 }} 786w, {{ mobile_image | image_url: width: 1200 }} 1200w" sizes="100vw" width="{{ mobile_image.width }}" height="{{ mobile_image.height }}">
              {{ desktop_image | image_url: width: 3840 | image_tag: class: 'scene-image-showcase__image', widths: '750, 1200, 1600, 1920, 2560, 3840', sizes: '100vw', loading: 'lazy', alt: image_alt }}
            </picture>
          {% elsif request.design_mode %}
            <div class="scene-image-showcase__media">{{ 'lifestyle-1' | placeholder_svg_tag: 'scene-image-showcase__placeholder' }}</div>
          {% endif %}
          {% if block.settings.heading != blank or block.settings.description != blank %}
            <div class="scene-image-showcase__copy">
              {% if block.settings.heading != blank %}<h3 class="scene-image-showcase__title">{{ block.settings.heading }}</h3>{% endif %}
              {% if block.settings.description != blank %}<div class="scene-image-showcase__body rte">{{ block.settings.description }}</div>{% endif %}
            </div>
          {% endif %}
        </article>
      {% endif %}
    {% endfor %}
  </div>
</section>
