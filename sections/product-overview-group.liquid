{%- style -%}
  .overviewDiv {
    padding-top: {{ section.settings.overview_padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.overview_padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (max-width: 768px) {
    .overviewDiv {
      padding-top: {{ section.settings.overview_padding_top }}px;
      padding-bottom: {{ section.settings.overview_padding_bottom }}px;
    }
  }

  .reelUp_cards_carousel {
    max-width: var(--page-width);
    margin: 0 auto;
    padding: 0 1.5rem;
  }
  
  @media screen and (min-width: 750px) {
    .reelUp_cards_carousel {
      padding: 0 5rem;
    }
  }

  #shopify-section-template--19618181185690__faq {
    display: none;
  }
{%- endstyle -%}
<script src="{{ 'product-overview-group.js' | asset_url }}" defer="defer"></script>
{%- assign product_form_id = 'product-form-' | append: section.id -%}
{%- assign parent_template_id = section.id | split: '__' | first -%}
{%- assign faq_form_id = 'shopify-section-' | append: parent_template_id | append: '__faq' -%}
<div class="mainBox">
  <div class="tabContainer">
    <div class="pc-box">
      <div class="product-title">
        <h2 class="h5">
          {% if product.selected_or_first_available_variant.metafields.custom.title != blank %}
            {{ product.selected_or_first_available_variant.metafields.custom.title | escape }}
          {% else %}
            {{ product.title | escape }}
          {% endif %}
        </h2>
      </div>
      <ul class="tabList pc-tabList clearfix">
        <li class="active">OVERVIEW</li>
        <li class="review">REVIEW</li>
        <li>SPECS</li>
        <li data-id="{{ faq_form_id }}">FAQ</li>
      </ul>
      <div class="buy-button-div">
        {%- render 'product-buy-buttons', product: product, product_form_id: product_form_id, section_id: section.id -%}
      </div>
    </div>
  </div>
  <div class="contentList">
    <div class="overviewDiv active">
      {% content_for 'blocks' %}
    </div>
    <div></div>
    <div class="specsDiv">
      {% if section.settings.specs_mobile_img != blank %}
        <img
          src="{{ section.settings.specs_mobile_img | image_url: width: section.settings.specs_mobile_img.width }}"
          class="mobile_img"
          loading="lazy"
          width="{{ section.settings.specs_mobile_img.width }}"
          height="{{ section.settings.specs_mobile_img.height }}"
        >
      {% endif %}
      <div class="overview-page-width">
        {% if section.settings.specs_pc_img != blank %}
          <img
            src="{{ section.settings.specs_pc_img | image_url: width: section.settings.specs_pc_img.width }}"
            class="{% if section.settings.specs_mobile_img != blank %}pc_img{% endif %}"
            loading="lazy"
            width="{{ section.settings.specs_pc_img.width }}"
            height="{{ section.settings.specs_pc_img.height }}"
          >
        {% endif %}
        <div class="specs-list-div">
          <script type="application/json" data-meta-object>
            {{ product.metafields.custom.specs_2 }}
          </script>
        </div>
      </div>
    </div>
    <div></div>
  </div>
</div>

{% schema %}
{
  "name": "product overview group",
  "class": "product-overview-group-section",
  "enabled_on": {
    "templates": ["product"]
  },
  "settings": [
    {
      "type": "header",
      "content": "OVERVIEW"
    },
    {
      "type": "range",
      "id": "overview_padding_top",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 66
    },
    {
      "type": "range",
      "id": "overview_padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 40
    },
    
    {
      "type": "header",
      "content": "SPECS"
    },
    {
      "type": "image_picker",
      "id": "specs_pc_img",
      "label": "Specs_PC端图片"
    },
    {
      "type": "image_picker",
      "id": "specs_mobile_img",
      "label": "Specs_手机端图片"
    },
    {
      "type": "header",
      "content": "IN_THE_BOX"
    },
    {
      "type": "image_picker",
      "id": "box_pc_img",
      "label": "box_PC端图片"
    },
    {
      "type": "image_picker",
      "id": "box_mobile_img",
      "label": "box_手机端图片"
    },
    {
      "type": "metaobject",
      "id": "box_text_group",
      "label": "box文字组",
      "metaobject_type": "text_group"
    }
  ],
  "blocks": [{ "type": "@theme" },{"type": "@app"}],
  "presets": [
    {
      "name": "product overview group"
    }
  ]
}
{% endschema %}